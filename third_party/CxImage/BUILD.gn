config("cximage_public") {
  include_dirs += [
    "//third_party/cximage_pub",
    "$_cx_src/CxImage",
  ]
}

# CxImage 7.0.2 ships a pre-C++11 stdint.h on its include path.
# Under C++23, MSVC <string_view> needs PTRDIFF_MAX, which that
# header only defines when __STDC_LIMIT_MACROS is set. Isolate
# this target only; do not roll the repo back to C++17.
config("cximage_cc20") {
  cflags_cc = [ "/std:c++20" ]
}

shared_library("CxImage") {
  configs -= [ "//build/config:cc_std" ]
  configs += [ ":cximage_cc20" ]
  public_configs = [ ":cximage_public" ]
  defines = [
    "WIN32",
    "NOMINMAX",
    "JAS_WIN_MSVC_BUILD",
