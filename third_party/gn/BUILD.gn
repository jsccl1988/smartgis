# Prebuilt prefix (default //third_party/.install): headers + libs for GN
# consumers. Public labels stay //third_party:<name> via the top-level
# forwarder. Install is tools/batch.py, not cmake() from ninja.

import("//build/smartgis.gni")
import("//third_party/gn/tp.gni")

_tp = third_party_install_prefix
_d = ""
_proj_d = ""
if (is_debug) {
  _d = "d"
  _proj_d = "_d"
}

config("tp_common") {
  include_dirs += [ "$_tp/include" ]
  lib_dirs = [ "$_tp/lib" ]
}

config("glog_cfg") {
  libs += [ "$_tp/lib/glog$_d.lib" ]
}

config("gtest_cfg") {
  libs += [
    "$_tp/lib/gtest$_d.lib",
    "$_tp/lib/gtest_main$_d.lib",
    "$_tp/lib/gmock$_d.lib",
    "$_tp/lib/gmock_main$_d.lib",
  ]
}

# Mirror gtest: Debug installs benchmarkd.lib / benchmark_maind.lib (MDd);
# Release installs benchmark.lib / benchmark_main.lib (MD).
config("benchmark_cfg") {
  libs += [ "$_tp/lib/benchmark$_d.lib" ]
}

config("benchmark_main_cfg") {
  libs += [ "$_tp/lib/benchmark_main$_d.lib" ]
}

config("sqlite3_cfg") {
  libs += [ "$_tp/lib/sqlite3.lib" ]
}

config("sqlitecpp_cfg") {
  libs += [ "$_tp/lib/SQLiteCpp.lib" ]
}

config("geos_cfg") {
  defines = []
  defines += [ "USE_UNSTABLE_GEOS_CPP_API" ]
  libs += [
    "$_tp/lib/geos$_d.lib",
    "$_tp/lib/geos_c$_d.lib",
  ]
}

config("proj_cfg") {
  libs += [ "$_tp/lib/proj$_proj_d.lib" ]
}

config("gdal_cfg") {
  libs += [
    "$_tp/lib/gdal$_d.lib",
    "$_tp/lib/geos_c$_d.lib",
    "$_tp/lib/proj$_proj_d.lib",
  ]
  defines = []
  defines += [ "SUPPRESS_DEPRECATION_WARNINGS" ]
}

config("pdal_cfg") {
  if (is_debug) {
    libs += [ "$_tp/lib/pdalcppd.lib" ]
  } else {
    libs += [ "$_tp/lib/pdalcpp.lib" ]
  }
  # PDAL endian helpers pull Winsock htonl/htons/ntohl/ntohs.
  libs += [ "ws2_32.lib" ]
  defines += [ "has_PDAL=1" ]
}

config("spatialindex_cfg") {
  libs += [ "$_tp/lib/spatialindex-64.lib" ]
}

config("spatialite_cfg") {
  libs += [ "$_tp/lib/spatialite.lib" ]
}

config("spatialitecpp_cfg") {
  libs += [ "$_tp/lib/SpatiaLiteCpp.lib" ]
}

# Header-only; install_skip. Do not rely on the merged prefix.
config("asio_cfg") {
  include_dirs += [ "//third_party/.src/asio/asio/include" ]
  defines = []
  defines += [
    "ASIO_STANDALONE",
    "ASIO_NO_DEPRECATED",
  ]
}

config("cpp_httplib_cfg") {
  include_dirs += [ "//third_party/.src/cpp-httplib" ]
}

# OpenSSL 3+ from third_party/.install (Windows: sync Shining Light Dev via
# third_party/tools/sync_openssl_win.ps1 after winget install).
# Official/synced Windows builds are /MD only. Linking libssl-4-x64.dll into a
# /MDd net_d.dll loads VCRUNTIME140 beside VCRUNTIME140D and has caused
# STATUS_HEAP_CORRUPTION (0xC0000374) on ordinary SmartGisViews launch.
# libssld.lib in .install is a release import-lib rename, not a /MDd build â€?# keep OpenSSL for Release only until a real debug CRT OpenSSL is pinned.
config("openssl_cfg") {
  include_dirs += [ "$_tp/include" ]
  lib_dirs = [ "$_tp/lib" ]
  libs += [
    "$_tp/lib/libssl.lib",
    "$_tp/lib/libcrypto.lib",
    "crypt32.lib",
    "advapi32.lib",
    "user32.lib",
    "bcrypt.lib",
  ]
}

if (!is_debug) {
  copy("openssl_runtime_dlls") {
    sources = [
      "$_tp/bin/libssl-4-x64.dll",
      "$_tp/bin/libcrypto-4-x64.dll",
    ]
    outputs = [ "$root_out_dir/{{source_file_part}}" ]
  }

  group("openssl") {
    public_deps = [ ":openssl_runtime_dlls" ]
    public_configs = [
      ":tp_common",
      ":openssl_cfg",
    ]
  }
} else {
  group("openssl") {
  }
}

config("eigen_cfg") {
  include_dirs += [ "//third_party/.src/eigen" ]
  defines = []
  defines += [ "EIGEN_MPL2_ONLY" ]
}

config("chromium_cfg") {
  include_dirs += [ "//third_party/.src/chromium" ]
}

config("python_cfg") {
  include_dirs += [ "//third_party/python/include" ]
  lib_dirs = [ "//third_party/python/libs" ]
  libs += [ "python312.lib" ]
}

config("wtl_cfg") {
  include_dirs += [ "//third_party/.src/wtl8.0" ]
}

group("glog") {
  public_configs = [
    ":tp_common",
    ":glog_cfg",
  ]
}

group("gtest") {
  public_configs = [
    ":tp_common",
    ":gtest_cfg",
  ]
}

group("googletest") {
  public_deps = [ ":gtest" ]
}

group("gbenchmark") {
  public_configs = [
    ":tp_common",
    ":benchmark_cfg",
  ]
}

# Provides ::main via benchmark_main.lib. Prefer //testing/benchmark.gni.
group("gbenchmark_main") {
  public_deps = [ ":gbenchmark" ]
  public_configs = [ ":benchmark_main_cfg" ]
}

group("benchmark") {
  public_deps = [
    ":gbenchmark",
    ":gbenchmark_main",
  ]
}

group("sqlite3") {
  public_configs = [
    ":tp_common",
    ":sqlite3_cfg",
  ]
}

group("SQLiteCpp") {
  public_deps = [ ":sqlite3" ]
  public_configs = [
    ":tp_common",
    ":sqlitecpp_cfg",
  ]
}

group("geos") {
  public_configs = [
    ":tp_common",
    ":geos_cfg",
  ]
}

copy("proj_runtime_data") {
  sources = [
    "$_tp/share/proj/proj.db",
    "$_tp/share/proj/proj.ini",
  ]
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

group("PROJ") {
  public_deps = [
    ":sqlite3",
    ":proj_runtime_data",
  ]
  public_configs = [
    ":tp_common",
    ":proj_cfg",
  ]
}

copy("gdal_runtime_dlls") {
  if (is_debug) {
    sources = [
      "$_tp/bin/gdald.dll",
      "$_tp/bin/geos$_d.dll",
      "$_tp/bin/geos_c$_d.dll",
      "$_tp/bin/proj_9_4_d.dll",
    ]
  } else {
    sources = [
      "$_tp/bin/gdal.dll",
      "$_tp/bin/geos$_d.dll",
      "$_tp/bin/geos_c$_d.dll",
      "$_tp/bin/proj_9_4.dll",
    ]
  }
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

group("gdal") {
  public_deps = [
    ":PROJ",
    ":gdal_runtime_dlls",
  ]
  public_configs = [
    ":tp_common",
    ":gdal_cfg",
  ]
}

if (has_pdal) {
  copy("pdal_runtime_dlls") {
    if (is_debug) {
      sources = [ "$_tp/bin/pdalcppd.dll" ]
    } else {
      sources = [ "$_tp/bin/pdalcpp.dll" ]
    }
    outputs = [ "$root_out_dir/{{source_file_part}}" ]
  }

  group("pdal") {
    public_deps = [
      ":gdal",
      ":pdal_runtime_dlls",
    ]
    public_configs = [
      ":tp_common",
      ":pdal_cfg",
    ]
  }
} else {
  group("pdal") {
  }
}

group("libspatialindex") {
  public_configs = [
    ":tp_common",
    ":spatialindex_cfg",
  ]
}

group("libspatialite") {
  public_deps = [
    ":geos",
    ":PROJ",
