# ANTLR 4.13.2 C++ runtime (BSD-3). Sources come from
# third_party/.src/antlr4 via manifest pin (build.bat t antlr4).

config("antlr4_headers") {
  include_dirs += [ "//third_party/.src/antlr4/runtime/src" ]
  defines = [
    "ANTLR4CPP_STATIC",
    "NOMINMAX",
  ]
  # win_macros sets _HAS_STD_BYTE=0; MSVC <chrono> then drops
  # high_resolution_clock used by ProfilingATNSimulator.
  cflags = [ "/U_HAS_STD_BYTE" ]
}

