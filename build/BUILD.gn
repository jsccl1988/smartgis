import("//build/smartgis.gni")

# MBCS + forced compat for leftover product sources.
# Product headers use #include "layer/module/file.h" via //src
# (see docs/build/abi-rename-map.md). BUILDCONFIG already puts //src before
# // so #include "base/..." → src/base/. Keep "//src" here; do not add
# per-module include_dirs.
config("legacy") {
  defines = [
    "BUILD_AS_DLL",
    "_MBCS",
    "WIN32",
    "_WINDOWS",
    "_HAS_STD_BYTE=0",
    # CxImage's stdint.h is on this include path and shadows MSVC's.
    # It only emits UINT*_MAX / PTRDIFF_MAX when these C99 macros are
    # set. C++23 <charconv> / <format> need them.
    "__STDC_LIMIT_MACROS",
    "__STDC_CONSTANT_MACROS",
    "EIGEN_MPL2_ONLY",
  ]
  cflags = [
    "/UUNICODE",
    "/U_UNICODE",
    "/FIsmt_compat.h",
    # Override default execution-charset:utf-8. Leftover MFC is MBCS and
    # talks ANSI (CP936 on zh-CN); emit narrow literals accordingly.
    "/execution-charset:.936",
  ]
  include_dirs = []
  include_dirs += [
    smt_vs,  # //build — forced include smt_compat.h
    "//src",
    "//",
    "//third_party/.src/eigen",
  ]
}

# Shared MFC (MBCS). Headers/libs come from vcvars once the VS MFC
# component is installed. WIN32_LEAN_AND_MEAN is incompatible with afx.h.
# atls.lib supplies ATL::_AtlBaseModule (VS 18 ships no atlsd.lib).
# Do not add mfcs here: extension DLLs already provide DllMain.
config("mfc") {
  cflags = [ "/UWIN32_LEAN_AND_MEAN" ]
  defines = [
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
  ]
  libs = [ "atls.lib" ]
  if (is_debug) {
    libs += [
      "mfc140d.lib",
      "comsuppd.lib",
    ]
  } else {
    libs += [
      "mfc140.lib",
      "comsupp.lib",
    ]
  }
}

# CRT/MFC startup (WinMain / regular-DLL DllMain). Not for _AFXEXT modules.
# With /NODEFAULTLIB both mfcs* and msvcrt* are explicit; each provides a
# DllMain (mfcs real, CRT stub). Allow the MFC definition to win.
config("mfc_startup") {
  libs = []
  ldflags = [ "/FORCE:MULTIPLE" ]
  if (is_debug) {
    libs += [ "mfcs140d.lib" ]
  } else {
    libs += [ "mfcs140.lib" ]
  }
}