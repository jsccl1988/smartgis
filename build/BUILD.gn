import("//build/smartgis.gni")

# MBCS + legacy include tree for 2010-2013 sources.
config("legacy") {
  defines = [
    "BUILD_AS_DLL",
    "_MBCS",
    "WIN32",
    "_WINDOWS",
    "_HAS_STD_BYTE=0",
    # CxImage's stdint.h is on this include path and shadows MSVC's.
    # It only emits UINT*_MAX / PTRDIFF_MAX when these C99 macros are
    # set. C++23 <charconv> / <format> need them.
    "__STDC_LIMIT_MACROS",
    "__STDC_CONSTANT_MACROS",
  ]
  cflags = [
    "/UUNICODE",
    "/U_UNICODE",
    "/FIsmt_compat.h",
  ]
  include_dirs = []
  include_dirs += [
    smt_vs,  # //build — forced include smt_compat.h

    # foundation
    "$smt_src/base",
    "$smt_src/sys",
    "$smt_src/net",
    # geo / gis (quoted #include "geometry.h" / "mathlib_3d.h" / "3dgeometry.h")
    "$smt_src/algorithm/geo",
    "$smt_src/sdb/feature",
    "$smt_src/sdb/layer",
    "$smt_src/sdb/map",
    "$smt_src/sdb/crs",
    "//src",
    "$smt_src/algorithm/proj",
    # render
    "$smt_src/render",
    "$smt_src/render/render3d",
    "$smt_src/render/gl",
    # sde
    "$smt_src/sdb/datasource/gdal",
    "$smt_src/sdb/datasource/mgr",
    "$smt_src/sdb/datasource/mem",
    "$smt_src/sdb/datasource/smf",
    "$smt_src/sdb/datasource/ws",
    # map
    "$smt_src/web/client",
    "$smt_src/web/server",
    "$smt_src/web/server_dev",
    "$smt_src/web/server_mgr",
    "$smt_src/web/service",
    # plugin host / app / tool / stat
    "$smt_src/plugin",
    "$smt_src/app/app_core",
    "$smt_src/tool",
    "$smt_src/tool/group",
    "$smt_src/algorithm/stat",
    "$smt_src/ui/chart",
    # ui (not in src_all)
    "$smt_src/ui/gui",
    "$smt_src/ui/mfc_ex",
    "$smt_src/ui/mfc_ex/gridctrl",
    "$smt_src/ui/xambox",
    "$smt_src/ui/xcatalog",
    "$smt_src/ui/xview",
    # domain leaves
    "$smt_src/plugin/dem",
    "$smt_src/algorithm/baogrid",
    "$smt_src/algorithm/tin",
    "$smt_src/render/scene3d",
    "$smt_src/render/model3d",
    "$smt_src/render/terrain",
    "$smt_src/render/pointcloud",
    "//third_party/cximage_pub",
    "//third_party/CxImage/CxImage",
  ]
}

# Shared MFC (MBCS). Headers/libs come from vcvars once the VS MFC
# component is installed. WIN32_LEAN_AND_MEAN is incompatible with afx.h.
# atls.lib supplies ATL::_AtlBaseModule (VS 18 ships no atlsd.lib).
# Do not add mfcs here: extension DLLs already provide DllMain.
config("mfc") {
  cflags = [ "/UWIN32_LEAN_AND_MEAN" ]
  defines = [
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
  ]
  libs = [ "atls.lib" ]
  if (is_debug) {
    libs += [
      "mfc140d.lib",
      "comsuppd.lib",
    ]
  } else {
    libs += [
      "mfc140.lib",
      "comsupp.lib",
    ]
  }
}

# CRT/MFC startup (WinMain / regular-DLL DllMain). Not for _AFXEXT modules.
config("mfc_startup") {
  libs = []
  if (is_debug) {
    libs += [ "mfcs140d.lib" ]
  } else {
    libs += [ "mfcs140.lib" ]
  }
}