# smartgis: Google-style formatting, column width 80, indent size 2
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.{c,h,cc,cpp,hpp,cxx,hxx}]
indent_size = 2
max_line_length = 80

[*.{py}]
indent_size = 2
max_line_length = 80

[*.{js,ts,jsx,tsx,json,css,html,md}]
indent_size = 2
max_line_length = 80

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
