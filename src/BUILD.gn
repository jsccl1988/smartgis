# Platform DLL merge in progress (see docs/superpowers/plans/2026-09-14-dll-reorganization.md).
# base / algorithm / gis = one DLL each. Do not add MFC/D3D/exe here.
# Exe is //src/legacy/app:app via root //:smartgis / build.bat legacy_app.
# WinUI / Views hosts live under src/app/ and are not in src_all.
#
# SP5 shell compile gate: default product library graph must not pull leftover
# engines / MFC chrome. Opt-in: //:legacy_all, build.bat legacy_app|ui_legacy,
# ninja legacy_render|legacy_tool. See docs/build/src-layout.md § Shell compile gate.

group("src_all") {
  # Forbid leftover DLL aggregators and MFC chrome in the default library graph.
  # //src/legacy/xml is absorbed into platform.dll and is intentionally allowed.
  assert_no_deps = [
    "//src/legacy/app:*",
    "//src/legacy/render:legacy_render",
    "//src/legacy/render:legacy_render_all",
    "//src/legacy/tool:*",
    "//src/legacy/ui:ui",
    "//src/legacy/ui:ui_legacy",
    "//src/legacy/ui:legacy_ui_all",
    "//src/ui:ui_legacy",
  ]
  deps = [
    # hosted map ABI (mgis content::MapView role; source_set, not a DLL)
    "//src/content:content",
    # foundation DLL (labels below all forward to //src/base:base)
    "//src/base:core",
    "//src/sys:sys",
    "//src/base:base",
    "//src/net:net",
    # algorithm DLL (geo / proj / tin / stat source_sets)
    "//src/algorithm:algorithm",
    # gis DLL (map/feature / sde_* / tile / assets / world / edit / style)
    "//src/gis:gis",
    # render DLL (endgame rhi/scene/skia/math; not legacy_render)
    "//src/render:render_all",
    "//src/plugin:plugin",
    "//src/tool:dispatch",
  ]
}
