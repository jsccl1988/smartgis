# 27 DLLs (math/math3d/geo3d folded into SmtGeoCore; SmtDemCore removed).
# Do not add MFC/D3D/exe targets here (ui, web, plugin children, app, d3d).
# Exe is //src/app:app via root //:smartgis / build.bat app.
# WebView2 / WinUI / Views hosts live under src/app/ and are not in src_all.
import("//src/app/webview2/webview2.gni")

group("src_all") {
  deps = [
    # hosted map ABI (mgis content::MapView role; source_set, not a DLL)
    "//src/content:content",
    # foundation
    "//src/base:core",
    "//src/sys:sys",
    "//src/base:base",
    "//src/net:net",
    # algorithm packages (math / geo / proj / tin / baogrid / stat)
    "//src/algorithm:algorithm",
    # core data model (SmtGisCore)
    "//src/sdb/map:gis",
    "//src/sdb/model:model",
    "//src/sdb/scene:scene",
    "//src/sdb/edit:edit",
    # render engines + SDE devices
    "//src/render:render_all",
    "//src/sdb:datasource",
    "//src/plugin:plugin",
    "//src/tool:tool",
    "//src/tool:dispatch",
  ]
}