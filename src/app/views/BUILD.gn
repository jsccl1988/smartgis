      "//src/plugin/runtime/python:python3_dll",
    ]
  }
  libs = [
    "comctl32.lib",
    "shell32.lib",
  ]
}

group("SmartGisViews") {
  # GN alias; PE name is SmartGIS.exe (`output_name` on :views).
  deps = [ ":views" ]
}

