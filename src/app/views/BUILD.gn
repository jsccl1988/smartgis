# SP5: product shell must not link leftover DLLs / MFC shell.
win32_app("views") {
  output_name = "SmartGIS"
  # Browser / BrowserSession / Scene3dPresenter construction needs >1 MiB stack;
  # default reserve lets member ctors smash ViewsLaunchOptions (startup AV).
  ldflags = [ "/STACK:16777216" ]
  assert_no_deps = []
  sources = [
    "main.cc",
    "shell/app/browser_main.cc",
    "shell/app/browser_main.h",
    "shell/app/views_content_host.h",
    "shell/app/cmdline/views_launch_options.cc",
    "shell/app/cmdline/views_launch_options.h",
    "shell/harness/common/capture/bmp.cc",
    "shell/harness/common/capture/bmp.h",
    "shell/harness/common/capture/scene3d_capture.cc",
    "shell/harness/common/capture/scene3d_capture.h",
    "shell/harness/common/io/maps.cc",
    "shell/harness/common/io/maps.h",
    "shell/harness/common/io/paths.cc",
    "shell/harness/common/io/paths.h",
    "shell/harness/common/io/sample.cc",
    "shell/harness/common/io/sample.h",
    "shell/harness/common/mark/mark.cc",
    "shell/harness/common/mark/mark.h",
    "shell/harness/common/present/linger_policy.cc",
    "shell/harness/common/present/linger_policy.h",
    "shell/harness/common/present/present_gpu_warmup.cc",
    "shell/harness/common/present/present_gpu_warmup.h",
    "shell/harness/common/present/present_hwnd.cc",
    "shell/harness/common/present/present_hwnd.h",
    "shell/harness/common/present/rhi_present_session.cc",
    "shell/harness/common/present/rhi_present_session.h",
    "shell/harness/common/pump/pump.cc",
    "shell/harness/common/pump/pump.h",
    "shell/harness/scenario_builtins.cc",
    "shell/harness/scenario_registry.cc",
    "shell/harness/scenario_registry.h",
    "shell/runtime/capability/fill_host.cc",
    "shell/runtime/capability/fill_host.h",
    "shell/runtime/capability/run_script.cc",
    "shell/runtime/capability/run_script.h",
    "shell/harness/self_test/shell_ready.cc",
    "shell/harness/self_test/console_self_test.cc",
    "shell/harness/self_test/edit_m0.cc",
    "shell/harness/self_test/layers_m1.cc",
    "shell/harness/self_test/layout_bounds.cc",
    "shell/harness/self_test/milestones.cc",
    "shell/harness/self_test/navigate.cc",
