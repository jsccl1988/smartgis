# Product host for Views + Skia. Loaded when smt_build_views=true.
# Output: out/SmartGisViews.exe. Leftover MFC sources stay in src/app/.

import("//build/config/win/application.gni")
import("//testing/test.gni")

# Shared in-process map document (OGR + layers). Used by Views, WinUI, CEF.
source_set("map_scene") {
  sources = [
    "document/map_scene.cc",
    "document/map_scene.h",
  ]
  deps = [
    "//src/content:content",
    "//src/gis:gis",
    "//src/gis/datasource/ogr:ogr_text_encoding",
    "//src/gis/vista/world:land_mask",
    "//src/tool:dispatch",
    "//third_party:gdal",
  ]
  include_dirs += [ "//src" ]
}

# 2D pan/scale and 3D orbit. ViewFrame::fit_extent reads MapScene.
source_set("map_camera") {
  sources = [
    "camera/map_host_extent.h",
    "camera/orbit_frame.cc",
    "camera/orbit_frame.h",
    "camera/view_frame.cc",
    "camera/view_frame.h",
    "camera/view_navigation.cc",
    "camera/view_navigation.h",
  ]
  deps = [
    ":map_scene",
    "//src/content:content",
    "//src/gis:gis",
    "//src/render:rhi",
    "//src/tool:dispatch",
  ]
  include_dirs += [ "//src" ]
}

