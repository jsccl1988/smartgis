group("SmartGisViews") {
  deps = [ ":views" ]
}

test("view_commands_test") {
  output_name = "view_commands_test"
  sources = [
    "shell/browser/commands/view_commands.cc",
    "shell/browser/commands/view_commands_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/ui/views:views" ]
}

test("views_launch_options_test") {
  output_name = "views_launch_options_test"
  sources = [
    "shell/app/cmdline/views_launch_options.cc",
    "shell/app/cmdline/views_launch_options_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/content:content",
    "//third_party:CLI11",
  ]
}

test("analysis_playback_test") {
  output_name = "analysis_playback_test"
  sources = [
    "shell/runtime/analysis/flood_store.cc",
    "shell/runtime/analysis/orthogrid_store.cc",
    "shell/runtime/analysis/traffic_store.cc",
    "shell/runtime/analysis/playback.cc",
    "shell/runtime/analysis/playback_test.cc",
  ]
  include_dirs += [ "//src" ]
}
