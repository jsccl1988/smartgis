# Product host for Views + Skia. Loaded when smt_build_views=true.
# Output: out/SmartGisViews.exe. Capability dirs live under //src/content
# (document/camera/present/input) and //src/render:present_paint Ã¢ÂÂ see
# docs/superpowers/specs/2026-09-27-views-desktop-shell-design.md ÃÂ§Content sink.

import("//build/config/win/application.gni")
import("//build/python.gni")
import("//testing/test.gni")

# Chromium-style controller: session + commands/nav. No concrete BrowserView.
source_set("shell_browser") {
  sources = [
    "shell/browser/browser.cc",
    "shell/browser/browser.h",
    "shell/browser/browser_ui_delegate.h",
    "shell/browser/commands/app_commands.cc",
    "shell/browser/commands/app_commands.h",
    "shell/browser/commands/catalog_commands.cc",
    "shell/browser/commands/document_commands.cc",
    "shell/browser/commands/session_commands.cc",
    "shell/browser/commands/view_commands.cc",
    "shell/browser/commands/view_commands.h",
    "shell/browser/nav/draft_nav.cc",
    "shell/browser/plugin/plugin_shell.cc",
    "shell/browser/plugin/plugin_shell.h",
  ]
  deps = [
    "//src/content:map_session",
    "//src/content:content",
    "//src/content:view_host",
    "//src/gis/model/edit:edit",
    "//src/gis/present/tile:tile",
    "//src/plugin:host",
    "//src/plugin/product/dem:dem_views",
    "//src/plugin/product/orthogrid:orthogrid_views",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/runtime/python:python",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "comctl32.lib",
    "user32.lib",
  ]
}

# Chromium-style chrome: BrowserView Widget tree. Depends on shell_browser only.
source_set("shell_ui") {
  sources = [
    "shell/ui/browser_view.cc",
    "shell/ui/browser_view.h",
    "shell/ui/pages/map_pages.cc",
    "shell/ui/panels/inspector_sync.cc",
    "shell/ui/panels/shell_panels.cc",
  ]
  deps = [
    ":shell_browser",
    "//src/content:debug_agent",
    "//src/content:map_session",
    "//src/content:content",
    "//src/content:view_host",
    "//src/gis/model/edit:edit",
    "//src/gis/present/tile:tile",
    "//src/plugin:host",
    "//src/plugin/product/dem:dem_views",
    "//src/plugin/product/orthogrid:orthogrid_views",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/runtime/python:python",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "comctl32.lib",
    "user32.lib",
  ]
}

# SP5: product shell must not link leftover DLLs / MFC shell.
win32_app("views") {
  output_name = "SmartGisViews"
  assert_no_deps = [
    "//src/legacy/app:*",
    "//src/legacy/render:legacy_render",
    "//src/legacy/render:legacy_render_all",
    "//src/legacy/render:scene3d",
    "//src/legacy/render/scene3d:dem_height_field_static",
    "//src/legacy/tool:*",
    "//src/legacy/ui:*",
    "//src/ui:ui_legacy",
  ]
  sources = [
    "main.cc",
    "shell/app/browser_main.cc",
    "shell/app/browser_main.h",
    "shell/app/views_content_host.h",
    "shell/app/cmdline/views_launch_options.cc",
    "shell/app/cmdline/views_launch_options.h",
    "shell/self_test/console_self_test.cc",
    "shell/self_test/self_test.cc",
    "shell/self_test/self_test.h",
    "shell/showcase/atmosphere_showcase.cc",
    "shell/showcase/atmosphere_showcase.h",
  ]
  deps = [
    ":shell_browser",
    ":shell_ui",
    "//src/base:base",
    "//src/base:foundation",
    "//src/content:content",
    "//src/content:debug_agent",
    "//src/content:embed_sample",
    "//src/content:map_session",
    "//src/content:view_host",
    "//src/gis:gis",
    "//src/gis/model/edit:edit",
    "//src/gis/present/tile:tile",
    "//src/gis/vista/world:land_mask",
    "//src/gpu:gpu_lib",
    "//src/net:net",
    "//src/plugin:host",
    "//src/plugin/product/dem:dem_views",
    "//src/plugin/product/model3d:model3d_views",
    "//src/plugin/product/orthogrid:orthogrid_views",
    "//src/plugin/product/print:print_views",
    "//src/plugin/runtime/processing:processing_views",
    "//src/render:rhi",
    "//src/tool:tool",
    "//src/ui/gis:ui_gis",
    "//src/ui/views:ui_views",
    "//src/ui/views:markup_resources",
    "//third_party:CLI11",
    "//third_party:gdal",
  ]
  data_deps = [
    "//testing/data:china_map_samples",
    "//third_party:gdal_runtime_dlls",
    "//src/ui/views:markup_resources",
  ]
  if (smt_python_enabled && smt_python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/python:python312_dll",
      "//src/plugin/runtime/python:python3_dll",
    ]
  }
  libs = [
    "comctl32.lib",
    "shell32.lib",
  ]
}

group("SmartGisViews") {
  deps = [ ":views" ]
}

test("view_commands_test") {
  output_name = "view_commands_test"
  sources = [
    "shell/browser/commands/view_commands.cc",
    "shell/browser/commands/view_commands_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/ui/views:views" ]
}

test("views_launch_options_test") {
  output_name = "views_launch_options_test"
  sources = [
    "shell/app/cmdline/views_launch_options.cc",
    "shell/app/cmdline/views_launch_options_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/content:content",
    "//third_party:CLI11",
  ]
}
