# SP5: product shell must not link leftover DLLs / MFC shell.
win32_app("views") {
  output_name = "SmartGIS"
  # Browser / BrowserSession / Scene3dPresenter construction needs >1 MiB stack;
  # default reserve lets member ctors smash ViewsLaunchOptions (startup AV).
  ldflags = [ "/STACK:16777216" ]
  assert_no_deps = []
  sources = [
    "app/main.cc",
    "app/host/content_host.h",
    "app/process/browser_main.cc",
    "app/process/browser_main.h",
    "app/cmdline/views_launch_options.cc",
    "app/cmdline/views_launch_options.h",
    "app/startup/policy.cc",
    "app/startup/policy.h",
    "app/startup/scenario.cc",
    "app/startup/scenario.h",
    "app/startup/scenario_builtins.cc",
    "app/startup/shell_runtime.cc",
    "app/startup/shell_runtime.h",
    "browser/plugin/harness/report_suite.cc",
    "browser/plugin/harness/report_suite.h",
  ]
  deps = [
    ":shell_browser",
    ":shell_ui",
    "//src/content/browser/glang.runtime:session",
    "//src/app/views/util:util",
    "//src/base:base",
    "//src/base:foundation",
    "//src/content:content",
    "//src/content:content_main",
    "//src/content:capability",
    "//src/content:debug_agent",
    "//src/content:browser_session",
    "//src/content:tool_session",
    "//src/gis:gis",
    "//src/gis/edit:edit",
    "//src/gis/tile:tile",
    "//src/vista:vista",
    "//src/gpu:gpu_lib",
    "//src/net:net",
    "//src/plugin:host",
    ":plugin_builtins",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/product:product_views",
    "//src/plugin/product/map2d:map2d_views",
    "//src/plugin/product/world3d:world3d_views",
    "//src/render:rhi",
    "//src/tool:tool",
    "//src/ui/gis:ui_gis",
    "//src/ui/views:ui_views",
    "//src/ui/views:markup_resources",
    "//third_party:CLI11",
    "//third_party:gdal",
    "//third_party:rapidjson",
    # wWinMain calls prepare_dll_search_path() (SDK third_party/bin).
    "//third_party/gn:dll_search",
  ]
  data_deps = [
    "//testing/data:china_map_samples",
    "//testing/data:plugin_product_samples",
    "//testing/data:plugin_geochem_samples",
    "//third_party/maplibre:maplibre_example_assets",
    "//third_party:gdal_runtime_dlls",
    "//src/ui/views:markup_resources",
    "//src/vista/component/map:carto_style_resources",
    "//src/plugin/product:product_native",
  ]
  if (python_enabled && python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/extension:python312_dll",
      "//src/plugin/runtime/extension:python3_dll",
    ]
  }
  libs = [
    "comctl32.lib",
    "shell32.lib",
  ]
  include_dirs += [ "//src" ]
}

group("SmartGisViews") {
  # GN alias; PE name is SmartGIS.exe (`output_name` on :views).
  deps = [ ":views" ]
}

