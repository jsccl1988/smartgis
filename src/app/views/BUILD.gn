# Product host for Views + Skia. Loaded when build_views=true.
# Output: out/SmartGIS.exe. Capability dirs live under //src/content
# (document/camera/present/input). See
# docs/superpowers/specs/2026-09-27-views-desktop-shell-design.md §Content sink.

import("//build/config/win/application.gni")
import("//build/python.gni")
import("//testing/test.gni")

# In-process append list for runtime processing only. Product packs are
# native DLLs under $root_out_dir/plugins/<package>/ (see //src/plugin/product:product_native).
source_set("plugin_builtins") {
  sources = [
    "browser/plugin/builtins.cc",
    "browser/plugin/builtins.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
  ]
}

# Chromium-style controller: session + commands/nav. No concrete BrowserView.
source_set("shell_browser") {
  sources = [
    "browser/browser.cc",
    "browser/browser.h",
    "browser/ui_delegate.h",
    "browser/china_product_defaults.cc",
    "browser/china_product_defaults.h",
    "browser/commands/app_commands.cc",
    "browser/commands/app_commands.h",
    "browser/commands/catalog_commands.cc",
    "browser/commands/document_commands.cc",
    "browser/commands/session_commands.cc",
    "browser/commands/view_commands.cc",
    "browser/commands/view_commands.h",
    "browser/nav/draft_nav.cc",
    "browser/nav/deferred_china_seed.cc",
    "browser/plugin/plugin_host_wiring.cc",
    "browser/plugin/plugin_shell.cc",
    "browser/plugin/plugin_shell.h",
    "browser/plugin/playback.cc",
    "browser/plugin/playback.h",
    "browser/plugin/present.cc",
    "browser/plugin/present.h",
    "browser/plugin/preview_host.cc",
    "browser/plugin/preview_host.h",
  ]
  deps = [
    "//src/content:browser_session",
    "//src/content:content",
    "//src/content:map_scene",
    "//src/content:view_host",
    "//src/gis:gis",
    "//src/gis/edit:edit",
    "//src/gis/tile:tile",
    "//src/plugin:host",
    ":plugin_builtins",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/runtime/python:python",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "comctl32.lib",
    "user32.lib",
  ]
}

# Chromium-style horizon: BrowserView Widget tree. Depends on shell_browser only.
source_set("shell_ui") {
  sources = [
    "ui/browser_view.cc",
    "ui/browser_view.h",
    "ui/pages/map_pages_composer.cc",
    "ui/pages/map_pages_composer.h",
    "ui/panels/debug_console_composer.cc",
    "ui/panels/debug_console_composer.h",
    "ui/panels/inspect_composer.cc",
    "ui/panels/inspect_composer.h",
    "ui/panels/inspector_sync_composer.cc",
    "ui/panels/inspector_sync_composer.h",
    "ui/panels/plugin_catalog_view.cc",
    "ui/panels/plugin_catalog_view.h",
    "ui/panels/processing_composer.cc",
    "ui/panels/processing_composer.h",
    "ui/panels/report_panel.cc",
    "ui/panels/report_panel.h",
    "ui/shell_layout_composer.cc",
    "ui/shell_layout_composer.h",
  ]
  deps = [
    ":shell_browser",
    "//src/app/views/util:util",
    "//src/content:debug_agent",
    "//src/content:browser_session",
    "//src/content:content",
    "//src/content:view_host",
    "//src/gis/edit:edit",
    "//src/gis/tile:tile",
    "//src/plugin:host",
    "//src/plugin/runtime/python:python",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "comctl32.lib",
    "user32.lib",
  ]
}

# SP5: product shell must not link leftover DLLs / MFC shell.
win32_app("views") {
  output_name = "SmartGIS"
  # Browser / BrowserSession / Scene3dPresenter construction needs >1 MiB stack;
  # default reserve lets member ctors smash ViewsLaunchOptions (startup AV).
  ldflags = [ "/STACK:16777216" ]
  assert_no_deps = []
  sources = [
    "app/main.cc",
    "app/host/content_host.h",
    "app/process/browser_main.cc",
    "app/process/browser_main.h",
    "app/cmdline/views_launch_options.cc",
    "app/cmdline/views_launch_options.h",
    "app/startup/policy.cc",
    "app/startup/policy.h",
    "app/startup/scenario.cc",
    "app/startup/scenario.h",
    "app/startup/scenario_builtins.cc",
    "browser/plugin/report_suite.cc",
    "browser/plugin/report_suite.h",
  ]
  deps = [
    ":shell_browser",
    ":shell_ui",
    "//src/app/views/il.runtime:il.runtime",
    "//src/app/views/util:util",
    "//src/base:base",
    "//src/base:foundation",
    "//src/content:content",
    "//src/content:capability",
    "//src/content:debug_agent",
    "//src/content:embed_sample",
    "//src/content:browser_session",
    "//src/content:view_host",
    "//src/gis:gis",
    "//src/gis/edit:edit",
    "//src/gis/tile:tile",
    "//src/vista:vista",
    "//src/gpu:gpu_lib",
    "//src/net:net",
    "//src/plugin:host",
    ":plugin_builtins",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/product:product_views",
    "//src/plugin/product/map2d:map2d_views",
    "//src/plugin/product/map2d:map2d_harness",
    "//src/plugin/product/mine:mine_harness",
    "//src/plugin/product/stormsurge:stormsurge_harness",
    "//src/plugin/product/traffic:traffic_harness",
    "//src/plugin/product/world3d:world3d_harness",
    "//src/render:rhi",
    "//src/tool:tool",
    "//src/ui/gis:ui_gis",
    "//src/ui/views:ui_views",
    "//src/ui/views:markup_resources",
    "//third_party:CLI11",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [
    "//testing/data:china_map_samples",
    "//testing/data:plugin_product_samples",
    "//testing/data:plugin_geochem_samples",
    "//third_party/maplibre:maplibre_example_assets",
    "//third_party:gdal_runtime_dlls",
    "//src/ui/views:markup_resources",
    "//src/plugin/product:product_native",
  ]
  if (python_enabled && python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/python:python312_dll",
      "//src/plugin/runtime/python:python3_dll",
    ]
  }
  libs = [
    "comctl32.lib",
    "shell32.lib",
  ]
  include_dirs += [ "//src" ]
}

group("SmartGisViews") {
  # GN alias; PE name is SmartGIS.exe (`output_name` on :views).
  deps = [ ":views" ]
}

test("view_commands_test") {
  output_name = "view_commands_test"
  sources = [
    "browser/commands/view_commands.cc",
    "browser/commands/view_commands_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/ui/views:views" ]
}

test("views_launch_options_test") {
  output_name = "views_launch_options_test"
  sources = [
    "app/cmdline/views_launch_options.cc",
    "app/cmdline/views_launch_options_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/content:content",
    "//third_party:CLI11",
  ]
}

test("plugin_playback_test") {
  output_name = "plugin_playback_test"
  sources = [
    "browser/plugin/playback.cc",
    "browser/plugin/playback_test.cc",
  ]
  include_dirs += [ "//src" ]
}

test("plugin_builtins_test") {
  output_name = "plugin_builtins_test"
  sources = [ "browser/plugin/builtins_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":plugin_builtins",
    "//src/content:content",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/runtime/host:host",
    "//src/tool:dispatch",
  ]
}
