    "shell/runtime/analysis/traffic_store.cc",
    "shell/runtime/analysis/traffic_store.h",
    "shell/runtime/analysis/playback.cc",
    "shell/runtime/analysis/playback.h",
  ]
  deps = [
    "//src/content:map_session",
    "//src/content:content",
    "//src/content:view_host",
    "//src/gis:gis",
    "//src/gis/model/edit:edit",
    "//src/gis/present/tile:tile",
    "//src/plugin:host",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/product/traffic:traffic_views",
    "//src/plugin/product/flood:flood_views",
    "//src/plugin/product/stormsurge:stormsurge_views",
    "//src/plugin/product/mine:mine_views",
    "//src/plugin/product/geochem:geochem_views",
    "//src/plugin/product/orthogrid:orthogrid_views",
    "//src/plugin/product/orthogrid3d:orthogrid3d_views",
    "//src/plugin/product/print:print_views",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/runtime/python:python",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
    "//third_party:eigen",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  # analysis_writer_orthogrid.cc pulls orthogrid orthogonality → Eigen; keep the
  # include on this target even when group public_configs fail to forward.
  include_dirs += [
    "//src",
    "//third_party/.src/eigen",
  ]
  libs = [
    "comctl32.lib",
    "user32.lib",
  ]
}

