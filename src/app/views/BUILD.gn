# Product host for Views + Skia. Loaded when smt_build_views=true.
# Output: out/SmartGisViews.exe. Capability dirs live under //src/content
# (document/camera/present/input) and //src/render:present_paint Ã¢ÂÂ see
# docs/superpowers/specs/2026-09-27-views-desktop-shell-design.md ÃÂ§Content sink.

import("//build/config/win/application.gni")
import("//build/python.gni")
import("//testing/test.gni")

# Chromium-style controller: session + commands/nav. No concrete BrowserView.
source_set("shell_browser") {
  sources = [
    "shell/browser/browser.cc",
    "shell/browser/browser.h",
    "shell/browser/browser_ui_delegate.h",
    "shell/browser/china_product_defaults.cc",
