    "shell/harness/self_test/run_self_test.cc",
    "shell/harness/self_test/self_test.h",
    "shell/harness/showcase/browse/browse_showcase.cc",
    "shell/harness/showcase/browse/browse_showcase.h",
    "shell/harness/showcase/input/input_showcase.cc",
    "shell/harness/showcase/input/input_showcase.h",
    "shell/harness/showcase/ui/capture/shell_capture.cc",
    "shell/harness/showcase/ui/capture/shell_capture.h",
    "shell/harness/showcase/ui/interact/interact_json.cc",
