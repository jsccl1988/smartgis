    "shell/browser/plugin/analysis_writer_stormsurge.cc",
    "shell/browser/plugin/analysis_writer_stormsurge.h",
    "shell/browser/plugin/analysis_writer_traffic.cc",
    "shell/browser/plugin/analysis_writer_traffic.h",
    "shell/browser/plugin/analysis_writer_world3d.cc",
    "shell/browser/plugin/analysis_writer_world3d.h",
    "shell/browser/plugin/analysis_writers.cc",
    "shell/browser/plugin/analysis_writers.h",
