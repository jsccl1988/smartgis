# Product host for Views + Skia. Loaded when build_views=true.
# Output: out/SmartGIS.exe. Capability dirs live under //src/content
# (document/camera/present/input) and //src/render:present_paint 脙垄脗蝙脗蝰 see
# docs/superpowers/specs/2026-09-27-views-desktop-shell-design.md 脙蝜脗杂Content sink.

import("//build/config/win/application.gni")
import("//build/python.gni")
import("//testing/test.gni")

# Chromium-style controller: session + commands/nav. No concrete BrowserView.
