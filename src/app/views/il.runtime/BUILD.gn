# Interact Language runtime:
#   frontend/   — Interact.g4 + AST + parse (GN frontend:frontend)
#   backend/         — flat: lower/eval (GN backend:compile) and Host packs (:capability)
#   language/   — source manager (load) · driver (backend.h) · session (run_script)
#   :ir         — language-neutral instructions (header-only over CapabilityHost)
#   :capability — runtime + linker: bind_host fills Host; packs never parse
#   :il.runtime — session: load → link → driver apply
# language/load must not include backend packs. Packs must not include language/.

import("//testing/test.gni")

# Language-neutral instructions. Frontends lower into these calls.
# Header-only; does not link the runtime.
source_set("ir") {
  sources = [
    "ir/api.h",
    "ir/document.h",
    "ir/expect.h",
    "ir/gesture.h",
    "ir/horizon.h",
    "ir/plugin.h",
  ]
  deps = [ "//src/content:capability" ]
  include_dirs += [ "//src" ]
}

source_set("clock") {
  sources = [
    "backend/pump.cc",
    "backend/pump.h",
  ]
  include_dirs += [ "//src" ]
  libs = [ "user32.lib" ]
}

