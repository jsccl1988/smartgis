# Interact Language runtime:
#   frontend/  — Interact.g4 + AST + parse (GN frontend:frontend)
#   ir/        — four objects over CapabilityHost (header-only)
#   codegen/   — AST → Code. :lower does not depend on :backend
#   backend/   — document / view / plugin / horizon (atom, sema, bind) + link
#   :driver    — session: link once, then apply
#   :il.runtime — alias of :driver
# frontend/load must not include backend headers.

import("//testing/test.gni")

# Language-neutral instructions. Frontends lower into these calls.
# Header-only; does not link the runtime.
source_set("ir") {
  sources = [
    "ir/api.h",
    "ir/document.h",
    "ir/fail.h",
    "ir/horizon.h",
    "ir/plugin.h",
    "ir/view.h",
  ]
  deps = [ "//src/content:capability" ]
  include_dirs += [ "//src" ]
}

# Codegen: lower + eval. No Host implementation.
source_set("lower") {
  sources = [
    "bind/reflect.h",
    "codegen/eval/eval_host.cc",
    "codegen/eval/eval_host.h",
    "codegen/eval/exec.cc",
    "codegen/eval/exec.h",
    "codegen/io.cc",
    "codegen/io.h",
    "codegen/lower/act.h",
    "codegen/lower/args.cc",
    "codegen/lower/args.h",
    "codegen/lower/code.h",
    "codegen/lower/document.cc",
    "codegen/lower/document.h",
    "codegen/lower/gesture.h",
    "codegen/lower/horizon.cc",
    "codegen/lower/horizon.h",
    "codegen/lower/input.cc",
    "codegen/lower/input.h",
    "codegen/lower/lower.cc",
    "codegen/lower/lower.h",
    "codegen/lower/lower_bind.h",
    "codegen/lower/ops.h",
    "codegen/lower/plugin.cc",
    "codegen/lower/plugin.h",
    "codegen/lower/view.cc",
    "codegen/lower/view.h",
  ]
  deps = [
    ":ir",
    "frontend:frontend",
    "//src/app/views/util:util",
    "//src/base:base",
    "//src/base:foundation",
    "//src/content:capability",
    "//src/plugin:host",
  ]
  include_dirs += [ "//src" ]
}

