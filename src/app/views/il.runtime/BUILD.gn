# Session driver. The only target that depends on both lower and backend.
source_set("driver") {
  sources = [
    "codegen/apply.cc",
    "codegen/apply.h",
    "codegen/driver.cc",
    "codegen/driver.h",
    "codegen/session/interact_script.cc",
    "codegen/session/interact_script.h",
    "codegen/session/run_script.cc",
    "codegen/session/run_script.h",
  ]
  public_deps = [
    ":lower",
    ":backend",
  ]
  deps = [
    "frontend:frontend",
    "//src/app/views:shell_browser",
    "//src/app/views/util:util",
    "//src/base:base",
    "//src/content:capability",
  ]
  include_dirs += [ "//src" ]
}

group("il.runtime") {
  public_deps = [ ":driver" ]
}

test("capture_present_test") {
