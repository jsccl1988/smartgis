  include_dirs += [ "//src" ]
  deps = [ "//src/base:base" ]
}

test("execution_bind_test") {
  output_name = "execution_bind_test"
  sources = [
    "codegen/lower/args.cc",
    "codegen/lower/bind_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:foundation" ]
}
