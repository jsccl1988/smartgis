# Flat directory. This target lowers a parsed script to Code and runs it.
# lower_* binds arguments. exec runs Code. eval_host is the mark/pump adapter.
# Public façade is apply.*. Host packs stay on :capability.

import("//testing/test.gni")

source_set("compile") {
  sources = [
    "apply.cc",
    "apply.h",
    "exec.cc",
    "exec.h",
    "eval_host.cc",
    "eval_host.h",
    "io.cc",
    "io.h",
    "act.h",
    "args.cc",
    "args.h",
    "lower_bind.h",
    "code.h",
    "lower_document.cc",
    "lower_document.h",
    "lower_expect.cc",
    "lower_expect.h",
    "horizon.cc",
    "horizon.h",
    "input.cc",
    "input.h",
    "lower.cc",
    "lower.h",
    "plugin.cc",
    "plugin.h",
    "ops.h",
  ]
  deps = [
    "//src/app/views/il.runtime/frontend:frontend",
    "//src/app/views/il.runtime:ir",
    "//src/app/views/util:util",
    "//src/base:foundation",
    "//src/content:capability",
    "//src/plugin:host",
  ]
  include_dirs += [ "//src" ]
}

test("execution_bind_test") {
  output_name = "execution_bind_test"
  sources = [
    "args.cc",
    "bind_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:foundation" ]
}
