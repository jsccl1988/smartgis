# Interact.g4 → out/{Debug|Release}/gen (ANTLR 4.13.2). Not checked in.
# frontend/ is the IL syntax: grammar + AST + parse. Sema and the runtime
# live in backend/.

_frontend_cpp_gen = "$root_gen_dir/app/views/il.runtime/frontend/gen"
_interact_py_gen = "$root_gen_dir/testing/tools/loop/interact/interact_gen"

action("interact_antlr_gen") {
  script = "//testing/tools/harness/_shared/scripts/gen/gen_interact_gn.py"
  inputs = [
    "Interact.g4",
    "//third_party/.tools/antlr-4.13.2-complete.jar",
    "//testing/tools/harness/_shared/scripts/gen/gen_interact_gn.py",
  ]
  outputs = [
    "$_frontend_cpp_gen/InteractLexer.cpp",
    "$_frontend_cpp_gen/InteractLexer.h",
    "$_frontend_cpp_gen/InteractParser.cpp",
    "$_frontend_cpp_gen/InteractParser.h",
    "$_frontend_cpp_gen/InteractVisitor.cpp",
    "$_frontend_cpp_gen/InteractVisitor.h",
    "$_frontend_cpp_gen/InteractBaseVisitor.cpp",
    "$_frontend_cpp_gen/InteractBaseVisitor.h",
    "$_frontend_cpp_gen/.stamp",
    "$_interact_py_gen/InteractLexer.py",
    "$_interact_py_gen/InteractParser.py",
    "$_interact_py_gen/InteractVisitor.py",
    "$_interact_py_gen/.stamp",
  ]
  args = [
    "--g4",
    rebase_path("Interact.g4", root_build_dir),
    "--jar",
    rebase_path("//third_party/.tools/antlr-4.13.2-complete.jar",
                root_build_dir),
    "--out-cpp",
    rebase_path(_frontend_cpp_gen, root_build_dir),
    "--out-py",
    rebase_path(_interact_py_gen, root_build_dir),
  ]
}

config("interact_antlr_config") {
  include_dirs += [
    _frontend_cpp_gen,
    "//src",
  ]
  defines = [
    "ANTLR4CPP_STATIC",
    "NOMINMAX",
    "_CRT_DECLARE_NONSTDC_NAMES=0",
  ]
  # Match //third_party/antlr4: win_macros sets _HAS_STD_BYTE=0.
  cflags = [ "/U_HAS_STD_BYTE" ]
}

source_set("interact_antlr") {
  sources = [
    "$_frontend_cpp_gen/InteractLexer.cpp",
    "$_frontend_cpp_gen/InteractParser.cpp",
  ]
  deps = [ ":interact_antlr_gen" ]
  public_deps = [ "//third_party:antlr4" ]
  public_configs = [ ":interact_antlr_config" ]
}

# AST + parse. Callers in backend/ include these headers; they do not
# parse Interact.g4 themselves.
source_set("frontend") {
  sources = [
    "ast.h",
    "parse.cc",
    "parse.h",
  ]
  deps = [ ":interact_antlr" ]
  public_configs = [ ":interact_antlr_config" ]
  include_dirs += [ "//src" ]
}
