# Interact.g4 → out/{Debug|Release}/gen (ANTLR 4.13.2). Not checked in.

import("//testing/test.gni")

_interact_cpp_gen = "$root_gen_dir/app/views/runtime/interact/gen"
_interact_py_gen = "$root_gen_dir/testing/tools/loop/interact/interact_gen"

action("interact_antlr_gen") {
  script = "//testing/tools/harness/_shared/scripts/gen/gen_interact_gn.py"
  inputs = [
    "//testing/tools/harness/_shared/scripts/grammar/Interact.g4",
    "//third_party/.tools/antlr-4.13.2-complete.jar",
    "//testing/tools/harness/_shared/scripts/gen/gen_interact_gn.py",
  ]
  outputs = [
    "$_interact_cpp_gen/InteractLexer.cpp",
    "$_interact_cpp_gen/InteractLexer.h",
    "$_interact_cpp_gen/InteractParser.cpp",
    "$_interact_cpp_gen/InteractParser.h",
    "$_interact_cpp_gen/InteractVisitor.cpp",
    "$_interact_cpp_gen/InteractVisitor.h",
    "$_interact_cpp_gen/InteractBaseVisitor.cpp",
    "$_interact_cpp_gen/InteractBaseVisitor.h",
    "$_interact_cpp_gen/.stamp",
    "$_interact_py_gen/InteractLexer.py",
    "$_interact_py_gen/InteractParser.py",
    "$_interact_py_gen/InteractVisitor.py",
    "$_interact_py_gen/.stamp",
  ]
  args = [
    "--g4",
    rebase_path("//testing/tools/harness/_shared/scripts/grammar/Interact.g4",
                root_build_dir),
    "--jar",
    rebase_path("//third_party/.tools/antlr-4.13.2-complete.jar",
                root_build_dir),
    "--out-cpp",
    rebase_path(_interact_cpp_gen, root_build_dir),
    "--out-py",
    rebase_path(_interact_py_gen, root_build_dir),
  ]
}

config("interact_antlr_config") {
  include_dirs += [
    _interact_cpp_gen,
    "//src",
  ]
  defines = [
    "ANTLR4CPP_STATIC",
    "NOMINMAX",
    "_CRT_DECLARE_NONSTDC_NAMES=0",
  ]
  # Match //third_party/antlr4: win_macros sets _HAS_STD_BYTE=0.
  cflags = [ "/U_HAS_STD_BYTE" ]
}

source_set("interact_antlr") {
  sources = [
    "$_interact_cpp_gen/InteractLexer.cpp",
    "$_interact_cpp_gen/InteractParser.cpp",
  ]
  deps = [ ":interact_antlr_gen" ]
  public_deps = [ "//third_party:antlr4" ]
  public_configs = [ ":interact_antlr_config" ]
}

# Hand-written AST walk + CapabilityHost exec (no //build:legacy).
# Concerns: wire/ (AST+parse) · policy/ (args) · io/ (files+HWND inject) ·
# host/ (CapabilityHost adapters) · exec/ (UI verbs). Public façade is apply.*.
source_set("interact") {
  sources = [
    "apply.cc",
    "apply.h",
    "exec/document.cc",
    "exec/document.h",
    "exec/exec.cc",
    "exec/exec.h",
    "exec/horizon.cc",
    "exec/horizon.h",
    "exec/input.cc",
    "exec/input.h",
    "exec/plugin.cc",
    "exec/plugin.h",
    "exec/showcase.cc",
    "exec/showcase.h",
    "host/host.cc",
    "host/host.h",
    "io/io.cc",
    "io/io.h",
    "io/os_inject.cc",
    "io/os_inject.h",
    "policy/args.cc",
    "policy/args.h",
    "policy/bind.h",
    "policy/verbs.h",
    "wire/ast.h",
    "wire/parse.cc",
    "wire/parse.h",
  ]
  deps = [
    ":interact_antlr",
    "//src/base:foundation",
    "//src/content:capability",
  ]
  public_configs = [ ":interact_antlr_config" ]
  include_dirs += [ "//src" ]
}

test("interact_bind_test") {
  output_name = "interact_bind_test"
  sources = [
    "policy/args.cc",
    "policy/bind_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:foundation" ]
}
