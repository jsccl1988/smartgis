import("//build/config/win/application.gni")

# Layout (directory partitions; namespace stays app):
#   app/       — process bootstrap (Widget + FrameView)
#   shell/     — editor chrome (palette/canvas/props/tree)
#   canvas/    — markup preview host + hit overlay
#   document/  — XML DOM helpers + markup edit/reorder
#   io/        — UTF-8 path file helpers
#   llm/       — Cursor Agent LlmBackend for Text2UI

win32_app("ui_designer") {
  output_name = "UiDesigner"
  sources = [
    "main.cc",
    "app/app.cc",
    "app/app.h",
    "canvas/canvas.cc",
    "canvas/canvas.h",
    "document/dom.cc",
    "document/dom.h",
    "document/edit.cc",
    "document/edit.h",
    "io/file_io.cc",
    "io/file_io.h",
    "llm/cursor_agent.cc",
    "llm/cursor_agent.h",
    "shell/shell.cc",
    "shell/shell.h",
  ]
  deps = [
    "//src/base:base",
    "//src/ui/views:markup_resources",
    "//src/ui/views:views",
    "//third_party:pugixml",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "comctl32.lib",
    "comdlg32.lib",
    "shell32.lib",
    "user32.lib",
  ]
}

group("UiDesigner") {
  deps = [ ":ui_designer" ]
}
