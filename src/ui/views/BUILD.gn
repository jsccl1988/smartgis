    "dialogs/gis/create_map_dialog.h",
    "dialogs/shell/dialog.cc",
    "dialogs/shell/dialog.h",
    "dialogs/shell/file_picker.cc",
    "dialogs/shell/file_picker.h",
    "dialogs/shell/input_text_dialog.cc",
    "dialogs/shell/input_text_dialog.h",
    "dialogs/shell/message_box.cc",
    "dialogs/shell/message_box.h",
    "dialogs/shell/select_one_dialog.cc",
    "dialogs/shell/select_one_dialog.h",

    # GIS panels
    "gis/shell/ambox_view.cc",
    "gis/shell/ambox_view.h",
    "gis/panel/atmosphere_panel.cc",
    "gis/panel/atmosphere_panel.h",
    "gis/inspect/attribute_table.cc",
    "gis/inspect/attribute_table.h",
    "gis/catalog/catalog_view.cc",
    "gis/catalog/catalog_view.h",
    "gis/panel/chart_view.cc",
    "gis/panel/chart_view.h",
    "gis/inspect/feature_info.cc",
    "gis/inspect/feature_info.h",
    "gis/catalog/layer_tree.cc",
    "gis/catalog/layer_tree.h",
    "gis/panel/processing_panel.cc",
    "gis/panel/processing_panel.h",
    "gis/shell/status_bar.cc",
    "gis/shell/status_bar.h",

    # Map viewport hang
    "map/map_viewport.cc",
    "map/map_viewport.h",
    "map/touch_multitouch.cc",
    "map/touch_multitouch.h",

    # Umbrella
    "views.cc",
    "views.h",
  ]
  defines = [ "UI_VIEWS_EXPORTS" ]
  # gfx_sources objects compile into ui_views.dll (same PE).
  # content / tool / render are shared_library edges (import-link).
  public_deps = [
    "//src/content:content",
    "//src/content:view_host",
    "//src/render:rhi",
    "//src/tool:tool",
    "//src/ui/gfx:gfx_sources",
  ]
  public_configs = [ ":views_config" ]
  libs = [
    "comdlg32.lib",
    "dwrite.lib",
    "gdi32.lib",
    "user32.lib",
  ]
}

smt_shared_library("ui_views") {
  dll_stem = "ui_views"
  defines = [ "UI_VIEWS_EXPORTS" ]
  deps = [ ":views_sources" ]
  # Re-export sibling DLL edges so consumers of :views / :gfx import-link
  # content.dll + tool.dll + render.dll (not static source_sets).
  public_deps = [
    "//src/content:content",
    "//src/content:view_host",
    "//src/render:rhi",
    "//src/tool:tool",
  ]
  # source_set public_configs do not flow through the DLL to consumers.
  public_configs = [
    ":views_config",
    "//src/ui/gfx:skia_config",
  ]
  if (smt_has_skia) {
    public_configs += [ "//src/ui/gfx:skia_real_config" ]
  }
  libs = [
    "comdlg32.lib",
    "dwrite.lib",
    "gdi32.lib",
    "user32.lib",
  ]
}

# Stable label; same DLL as :ui_views.
group("views") {
  public_deps = [ ":ui_views" ]
}

# Console self-test for primitive / kernel behavior (no MFC).
test("views_unittests") {
  output_name = "views_unittests"
  sources = [ "testing/unit/views_unittests.cc" ]
  deps = [ ":views" ]
}

# L2 shell pixel regression (offscreen GDI + PNG goldens under testing/testdata/).
test("views_pixel_tests") {
  output_name = "views_pixel_tests"
  sources = [
    "testing/pixel/pixel_harness.cc",
    "testing/pixel/pixel_harness.h",
    "testing/pixel/pixel_png_wic.cc",
    "testing/pixel/views_pixel_tests.cc",
  ]
  deps = [ ":views" ]
  libs = [
    "gdi32.lib",
    "ole32.lib",
    "windowscodecs.lib",
  ]
}
