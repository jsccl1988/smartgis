product_shared_library("ui_views") {
  dll_stem = "ui_views"
  defines = [ "UI_EXPORTS" ]
  deps = [
    ":views_sources",
    "//src/ui/gis:gis_sources",
  ]
  # Re-export sibling DLL edges so consumers of :views / :gfx / :gis import-link
  # content.dll + tool.dll + render.dll (not static source_sets).
  public_deps = [
    "//src/content:content",
    "//src/content:view_host",
    "//src/render:rhi",
    "//src/tool:tool",
  ]
  # source_set public_configs do not flow through the DLL to consumers.
  public_configs = [
    ":views_config",
    "//src/ui/gfx:skia_config",
  ]
  if (has_skia) {
    public_configs += [ "//src/ui/gfx:skia_real_config" ]
  }
  libs = [
    "comdlg32.lib",
    "dwrite.lib",
    "gdi32.lib",
    "imm32.lib",
    "user32.lib",
  ]
}

# Stable label; same DLL as :ui_views.
group("views") {
  public_deps = [ ":ui_views" ]
}

