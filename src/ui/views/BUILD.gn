    "kernel/compositor/shell_compositor.cc",
    "kernel/compositor/shell_compositor.h",
    "kernel/layout/layout.cc",
    "kernel/layout/layout.h",
    "kernel/layout/layout_check.cc",
    "kernel/layout/layout_check.h",
    "kernel/layout/splitter.cc",
    "kernel/layout/splitter.h",
    "kernel/layout/view_traits.h",
    "kernel/paint/paint_commit.cc",
    "kernel/paint/paint_commit.h",
    "kernel/shell/dialog_host.cc",
    "kernel/shell/dialog_host.h",
    "kernel/shell/dpi.cc",
    "kernel/shell/dpi.h",
    "kernel/shell/event.h",
    "kernel/shell/theme.cc",
    "kernel/shell/theme.h",
    "kernel/view/view.cc",
    "kernel/view/view.h",
    "kernel/widget/widget.cc",
    "kernel/widget/widget.h",

    # Primitives
    "primitives/button/button.cc",
    "primitives/button/button.h",
    "primitives/button/checkbox.cc",
    "primitives/button/checkbox.h",
    "primitives/input/combobox.cc",
    "primitives/input/combobox.h",
    "primitives/menu/context_menu.cc",
    "primitives/menu/context_menu.h",
    "primitives/text/label.cc",
    "primitives/text/label.h",
    "primitives/menu/menu_bar.cc",
    "primitives/menu/menu_bar.h",
    "primitives/button/radio_button.cc",
    "primitives/button/radio_button.h",
    "primitives/collection/scroll_view.cc",
    "primitives/collection/scroll_view.h",
    "primitives/input/slider.cc",
    "primitives/input/slider.h",
    "primitives/collection/tab_strip.cc",
    "primitives/collection/tab_strip.h",
    "primitives/collection/table_view.cc",
    "primitives/collection/table_view.h",
    "primitives/text/textfield.cc",
    "primitives/text/textfield.h",
    "primitives/collection/tree_view.cc",
    "primitives/collection/tree_view.h",

    # Dialogs
    "dialogs/gis/add_basemap_dialog.cc",
    "dialogs/gis/add_basemap_dialog.h",
    "dialogs/gis/att_struct_dialog.cc",
    "dialogs/gis/att_struct_dialog.h",
    "dialogs/gis/create_datasource_dialog.cc",
    "dialogs/gis/create_datasource_dialog.h",
    "dialogs/gis/create_layer_dialog.cc",
    "dialogs/gis/create_layer_dialog.h",
