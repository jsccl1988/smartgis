# Views toolkit + shell gfx → one DLL (dll_stem = ui_views).
# Product exe is //src/app/views (import/link, not LoadLibrary).
# Not in //src:src_all or //src/ui:ui (MFC).
#
# Sibling DLLs (import-link only — never absorb their TUs into this PE):
#   //src/content:content  (dll_stem=content; :view_host group → :content)
#   //src/tool:tool        (dll_stem=tool; content already public_deps :tool)
#   //src/render:rhi       (group → render.dll)
#
# Public includes are responsibility-partitioned:
#   "ui/views/<area>/<group>/foo.h"
# map/ stays flat (viewport + touch). testing/ is test-only
# (not linked into :ui_views): testing/unit and testing/pixel.
# Goldens stay at testing/testdata/.
# Stable labels :views and //src/ui/gfx:gfx forward to :ui_views.
# //src/ui/gfx:gfx_headers is include-only (gpu / present; no this DLL).

import("//build/smartgis.gni")
import("//src/ui/gfx/skia.gni")
import("//testing/test.gni")

config("views_config") {
  include_dirs += [ "//src" ]
  defines += [ "NOMINMAX" ]
}

source_set("views_sources") {
  sources = [
