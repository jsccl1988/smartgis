# Chromium-style Views toolkit. Product exe is //src/app/views.
# Not in //src:src_all or //src/ui:ui (MFC).
#
# Public includes are responsibility-partitioned:
#   "ui/views/{kernel,primitives,dialogs,gis,map}/foo.h"
# Single source_set; testing/ is test-only (not linked into :views).

import("//testing/test.gni")

config("views_config") {
  include_dirs += [ "//src" ]
  defines += [ "NOMINMAX" ]
}

source_set("views") {
  sources = [
    # Kernel
    "kernel/dialog_host.cc",
    "kernel/dialog_host.h",
    "kernel/dpi.cc",
    "kernel/dpi.h",
    "kernel/event.h",
    "kernel/layout.cc",
    "kernel/layout.h",
    "kernel/layout_check.cc",
    "kernel/layout_check.h",
    "kernel/splitter.cc",
    "kernel/splitter.h",
    "kernel/theme.cc",
    "kernel/theme.h",
    "kernel/view.cc",
    "kernel/view.h",
    "kernel/widget.cc",
    "kernel/widget.h",

    # Primitives
    "primitives/button.cc",
    "primitives/button.h",
    "primitives/checkbox.cc",
    "primitives/checkbox.h",
    "primitives/combobox.cc",
    "primitives/combobox.h",
    "primitives/context_menu.cc",
    "primitives/context_menu.h",
    "primitives/label.cc",
    "primitives/label.h",
    "primitives/menu_bar.cc",
    "primitives/menu_bar.h",
    "primitives/radio_button.cc",
    "primitives/radio_button.h",
    "primitives/scroll_view.cc",
    "primitives/scroll_view.h",
    "primitives/tab_strip.cc",
    "primitives/tab_strip.h",
    "primitives/table_view.cc",
    "primitives/table_view.h",
    "primitives/textfield.cc",
    "primitives/textfield.h",
    "primitives/tree_view.cc",
    "primitives/tree_view.h",

    # Dialogs
    "dialogs/add_basemap_dialog.cc",
    "dialogs/add_basemap_dialog.h",
    "dialogs/att_struct_dialog.cc",
    "dialogs/att_struct_dialog.h",
    "dialogs/create_datasource_dialog.cc",
    "dialogs/create_datasource_dialog.h",
    "dialogs/create_layer_dialog.cc",
    "dialogs/create_layer_dialog.h",
    "dialogs/create_map_dialog.cc",
    "dialogs/create_map_dialog.h",
    "dialogs/dialog.cc",
    "dialogs/dialog.h",
    "dialogs/file_picker.cc",
    "dialogs/file_picker.h",
    "dialogs/input_text_dialog.cc",
    "dialogs/input_text_dialog.h",
    "dialogs/message_box.cc",
    "dialogs/message_box.h",
    "dialogs/select_one_dialog.cc",
    "dialogs/select_one_dialog.h",

    # GIS panels
    "gis/ambox_view.cc",
    "gis/ambox_view.h",
    "gis/attribute_table.cc",
    "gis/attribute_table.h",
    "gis/catalog_view.cc",
    "gis/catalog_view.h",
    "gis/chart_view.cc",
    "gis/chart_view.h",
    "gis/feature_info.cc",
    "gis/feature_info.h",
    "gis/layer_tree.cc",
    "gis/layer_tree.h",
    "gis/status_bar.cc",
    "gis/status_bar.h",

    # Map viewport hang
    "map/map_viewport.cc",
    "map/map_viewport.h",
    "map/touch_multitouch.cc",
    "map/touch_multitouch.h",

    # Umbrella
    "views.cc",
    "views.h",
  ]
  public_deps = [
    "//src/content:content",
    "//src/content:view_host",
    "//src/render:rhi",
    "//src/render/skia:skia",
    "//src/tool:dispatch",
  ]
  public_configs = [ ":views_config" ]
  libs = [
    "comdlg32.lib",
    "gdi32.lib",
    "user32.lib",
  ]
}

# Console self-test for primitive / kernel behavior (no MFC).
test("views_unittests") {
  output_name = "views_unittests"
  sources = [ "testing/views_unittests.cc" ]
  deps = [ ":views" ]
}

# L2 shell pixel regression (offscreen GDI + PNG goldens under testing/testdata/).
test("views_pixel_tests") {
  output_name = "views_pixel_tests"
  sources = [
    "testing/pixel_harness.cc",
    "testing/pixel_harness.h",
    "testing/pixel_png_wic.cc",
    "testing/views_pixel_tests.cc",
  ]
  deps = [ ":views" ]
  libs = [
    "gdi32.lib",
    "ole32.lib",
    "windowscodecs.lib",
  ]
}
