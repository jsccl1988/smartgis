# Chromium-style Views toolkit. Product exe is //src/app/views.
# Not in //src:src_all or //src/ui:ui (MFC).
#
# Public headers live at this directory root (`#include "ui/views/foo.h"`).
# .cc files are grouped under kernel/ | primitives/ | gis/ (physical only;
# not a public nest).

import("//testing/test.gni")

config("views_config") {
  include_dirs += [ "//src" ]
  defines += [ "NOMINMAX" ]
}

source_set("views") {
  sources = [
    # Public headers (stable include path).
    "add_basemap_dialog.h",
    "ambox_view.h",
    "att_struct_dialog.h",
    "attribute_table.h",
    "button.h",
    "catalog_view.h",
    "chart_view.h",
    "checkbox.h",
    "combobox.h",
    "context_menu.h",
    "create_datasource_dialog.h",
    "create_layer_dialog.h",
    "create_map_dialog.h",
    "dialog.h",
    "dialog_host.h",
    "dpi.h",
    "event.h",
    "feature_info.h",
    "file_picker.h",
    "input_text_dialog.h",
    "label.h",
    "layer_tree.h",
    "layout.h",
    "layout_check.h",
    "map_viewport.h",
    "menu_bar.h",
    "message_box.h",
    "radio_button.h",
    "scroll_view.h",
    "select_one_dialog.h",
    "splitter.h",
    "status_bar.h",
    "tab_strip.h",
    "table_view.h",
    "textfield.h",
    "theme.h",
    "tree_view.h",
    "view.h",
    "widget.h",

    # Kernel
    "kernel/dialog_host.cc",
    "kernel/dpi.cc",
    "kernel/layout.cc",
    "kernel/layout_check.cc",
    "kernel/splitter.cc",
    "kernel/theme.cc",
    "kernel/view.cc",
    "kernel/widget.cc",

    # Primitives
    "primitives/button.cc",
    "primitives/checkbox.cc",
    "primitives/combobox.cc",
    "primitives/context_menu.cc",
    "primitives/dialog.cc",
    "primitives/file_picker.cc",
    "primitives/input_text_dialog.cc",
    "primitives/label.cc",
    "primitives/menu_bar.cc",
    "primitives/message_box.cc",
    "primitives/radio_button.cc",
    "primitives/scroll_view.cc",
    "primitives/select_one_dialog.cc",
    "primitives/tab_strip.cc",
    "primitives/table_view.cc",
    "primitives/textfield.cc",
    "primitives/tree_view.cc",

    # GIS widgets
    "gis/add_basemap_dialog.cc",
    "gis/ambox_view.cc",
    "gis/att_struct_dialog.cc",
    "gis/attribute_table.cc",
    "gis/catalog_view.cc",
    "gis/chart_view.cc",
    "gis/create_datasource_dialog.cc",
    "gis/create_layer_dialog.cc",
    "gis/create_map_dialog.cc",
    "gis/feature_info.cc",
    "gis/layer_tree.cc",
    "gis/map_viewport.cc",
    "gis/status_bar.cc",

    # Umbrella
    "views.cc",
    "views.h",
  ]
  public_deps = [
    "//src/content:content",
    "//src/content:view_host",
    "//src/render:rhi",
    "//src/render/skia:skia",
    "//src/tool:dispatch",
  ]
  public_configs = [ ":views_config" ]
  libs = [
    "comdlg32.lib",
    "gdi32.lib",
    "user32.lib",
  ]
}

# Console self-test for primitive / kernel behavior (no MFC).
test("views_unittests") {
  output_name = "views_unittests"
  sources = [ "views_unittests.cc" ]
  deps = [ ":views" ]
}

# L2 shell pixel regression (offscreen GDI + PNG goldens under testdata/).
test("views_pixel_tests") {
  output_name = "views_pixel_tests"
  sources = [
    "pixel_harness.cc",
    "pixel_png_wic.cc",
    "views_pixel_tests.cc",
  ]
  deps = [ ":views" ]
  libs = [
    "gdi32.lib",
    "ole32.lib",
    "windowscodecs.lib",
  ]
}
