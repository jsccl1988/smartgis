import("//build/smartgis.gni")

smt_mfc_shared_library("xview") {
  dll_stem = "xview"
  mfc_extension = true
  defines = [
    "XVIEW_EXPORTS",
    "_AFXEXT",
  ]
  sources = [
    "view_core.cpp",
    "xview_core.rc",
    "stdafx.cpp",
    "view_2d_edit.cpp",
    "view_2d.cpp",
    "view_3d.cpp",
    "view_chrome.cc",
    "view_chrome.h",
    "xview.cpp",
  ]
  include_dirs += [
    ".",
