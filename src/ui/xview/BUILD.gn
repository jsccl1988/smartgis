    "//src/sdb/edit:map_edit",
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/render:render",
    "//src/render/render3d:render3d",
    "//src/render/scene3d:scene3d",
    "//src/sys:sys",
    "//src/render/model3d:model3d",
    "//src/plugin:plugin",
    "//src/plugin:legacy_cmd",
    "//src/tool:tool",
    "//src/tool/group:tool_group",
    "//src/ui/xcatalog:xcatalog",
    "//src/sdb/datasource/mgr:sde_mgr",
  ]
}
