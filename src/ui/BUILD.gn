# Compatibility aliases: MFC shell DLL lives in //src/legacy/ui:ui_legacy.
# Endgame toolkit: //src/ui/views + product GIS chrome //src/ui/gis.
# App-gated via //:smartgis (smt_build_app). Not in //src:src_all.

group("ui_legacy") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

# Opt-in aggregator for MFC UI (build.bat app / //:smartgis).
group("ui") {
  public_deps = [ ":ui_legacy" ]
}

# Product GIS panels + dialogs (same ui_views.dll / UI_EXPORT).
group("gis") {
  public_deps = [ "//src/ui/gis:gis" ]
}
