  dll_stem = "mfc_ex"
  mfc_extension = true
  defines = [
    "MFC_EX_EXPORTS",
    "_AFXEXT",
  ]
  include_dirs += [
    ".",
    "gridctrl",
  ]
  sources = [
    "container.cpp",
    "mfc_ex_core.cpp",
    "mfc_ex_core.rc",
    "stacked_wnd_dock_bar.cpp",
    "tabbed_wnd_dock_bar.cpp",
    "gridctrl/btn_data_base.cpp",
    "gridctrl/grid_btn_cell.cpp",
    "gridctrl/grid_btn_cell_base.cpp",
    "gridctrl/grid_btn_cell_combo.cpp",
    "gridctrl/grid_cell.cpp",
    "gridctrl/grid_cell_base.cpp",
    "gridctrl/grid_cell_check.cpp",
    "gridctrl/grid_cell_combo.cpp",
    "gridctrl/grid_cell_date_time.cpp",
    "gridctrl/grid_cell_numeric.cpp",
    "gridctrl/grid_ctrl.cpp",
    "gridctrl/grid_drop_target.cpp",
    "gridctrl/grid_url_cell.cpp",
    "gridctrl/in_place_edit.cpp",
    "gridctrl/in_place_list.cpp",
    "gridctrl/title_tip.cpp",
    "stdafx.cpp",
  ]
  deps = [ "//src/base:core" ]
}
