<?xml version="1.0" encoding="UTF-8"?>
<ui name="create_layer">
  <style src="create_layer.ui.css"/>
  <vbox id="root" class="form">
    <label id="name_label" text="Layer name"/>
    <textfield id="name"/>
    <label id="type_label" text="Geometry type"/>
    <combobox id="type">
      <item text="Point"/>
      <item text="Line"/>
      <item text="Polygon"/>
    </combobox>
  </vbox>
</ui>
