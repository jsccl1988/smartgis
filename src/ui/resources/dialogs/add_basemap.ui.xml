<?xml version="1.0"?>
<ui name="add_basemap">
  <style src="add_basemap.ui.css" />
  <vbox id="root" class="form">
    <label id="name_label" text="Layer name" />
    <textfield id="name" text="Basemap" />
    <label id="kind_label" text="Kind" />
    <combobox id="kind">
      <item text="xyz" />
      <item text="wmts" />
    </combobox>
    <label id="url_label" text="URL template ({z}/{x}/{y} or WMTS)" />
    <textfield id="url" />
  </vbox>
</ui>
