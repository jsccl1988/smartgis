<!-- SmartGisViews main chrome (mirrors BrowserView via ShellLayoutChrome).
     Product mounts real Catalog / Map / Ambox / inspector / Status into *host
     panels; UiDesigner preview shows the region skeleton. -->
<ui name="main_app">
  <style src="main_app.ui.css"/>
  <vbox id="root" class="shell">
    <menubar id="menu_bar" class="menu"/>
    <splitter id="main_split" orientation="vertical" class="main_split">
      <splitter id="work" orientation="horizontal" class="work">
        <vbox id="map_column" class="map_column">
          <panel id="tool_bar_host" class="tool_bar">
            <label id="tool_bar_label" text="Tools"/>
          </panel>
          <splitter id="catalog_map" orientation="horizontal" class="catalog_map">
            <panel id="catalog_host" class="catalog">
              <label id="catalog_label" text="Catalog"/>
            </panel>
            <panel id="map_tabs_host" class="map_tabs">
              <label id="map_tabs_label" text="Map | Data | 3D"/>
            </panel>
          </splitter>
        </vbox>
        <panel id="inspector_host" class="inspector">
          <label id="inspector_label" text="Inspector"/>
        </panel>
      </splitter>
      <panel id="diagnostic_host" class="diagnostics">
        <label id="diagnostic_label" text="Console"/>
      </panel>
    </splitter>
    <panel id="status_host" class="status">
      <label id="status_label" text="Status"/>
    </panel>
  </vbox>
</ui>
