import("//build/smartgis.gni")

smt_mfc_shared_library("xcatalog") {
  dll_stem = "xcatalog"
  mfc_extension = true
  defines = [
    "XCATALOG_EXPORTS",
    "_AFXEXT",
  ]
  include_dirs += [ "." ]
  sources = [
    "dlg_create_ds.cpp",
    "dlg_create_layer.cpp",
    "dlg_create_map.cpp",
    "dlg_sel_fcls.cpp",
    "dlg_sel_ds.cpp",
    "dlg_sel_layer.cpp",
    "xcatalog_core.cpp",
    "xcatalog_core.rc",
    "3dobjxcatalog.cpp",
    "catalog_api.cpp",
    "dsxcatalog.cpp",
    "mapdocxcatalog.cpp",
    "mapmgr.cpp",
    "scenemgr.cpp",
    "xcatalog.cpp",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/render/model3d:model3d",
    "//src/plugin:plugin",
    "//src/render/render3d:render3d",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//third_party:gdal",
    "//src/render/scene3d:scene3d",
    "//src/sys:sys",
    "//src/render/terrain:terrain",
    "//src/tool:tool",
    "//src/tool/group:tool_group",
    "//src/ui/gui:gui",
  ]
}
