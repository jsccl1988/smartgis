import("//build/smartgis.gni")

# Layer / map / scene catalogs. Compiled into //src/ui:ui_legacy.
source_set("xcatalog_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "XCATALOG_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "dlg_create_ds.cpp",
    "dlg_create_layer.cpp",
    "dlg_create_map.cpp",
    "dlg_sel_fcls.cpp",
    "dlg_sel_ds.cpp",
    "dlg_sel_layer.cpp",
    "xcatalog_core.rc",
    "3dobjxcatalog.cpp",
    "catalog_api.cpp",
    "dsxcatalog.cpp",
    "mapdocxcatalog.cpp",
    "mapmgr.cpp",
    "scenemgr.cpp",
    "xcatalog.cpp",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/legacy_render/model3d:model3d",
    "//src/plugin:plugin",
    "//src/legacy_render/render3d:render3d",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//third_party:gdal",
    "//src/legacy_render/scene3d:scene3d",
    "//src/sys:sys",
    "//src/legacy_render/terrain:terrain",
    "//src/legacy_tool:tool",
  ]
}

group("xcatalog") {
  public_deps = [ "//src/ui:ui_legacy" ]
}
