# 2D shell raster for Views. Objects compile into //src/ui/views:ui_views
# (dll_stem = ui_views). GDI always compiled; real Skia also linked when
# has_skia plus a local pin (runtime --shell-canvas / SHELL_CANVAS).
# Final frame compose stays in //src/gpu.
#
# Public responsibility dirs: geometry/ color/ canvas/ display/ display_list/
# raster/ font/. Includes: "ui/gfx/<area>/....". No root shims.
# Stable label :gfx forwards to the ui_views DLL; :gfx_headers is include-only.
# :vblank_wait is a tiny DXGI source_set shared with //src/gpu (no ui_views.dll).

import("//build/smartgis.gni")
import("skia.gni")

config("skia_config") {
  include_dirs += [ "//src" ]
}

# Headers for a local Skia pin. Used only when has_skia is on.
# Prefer third_party/.src/skia → machine checkout (see README.md).
config("skia_real_config") {
  defines = [
    "HAS_SKIA",
    "SK_BUILD_FOR_WIN",
    "NOMINMAX",
    "WIN32_LEAN_AND_MEAN",
    # Repo-wide legacy sets _HAS_STD_BYTE=0; modern Skia headers need std::byte.
    "_HAS_STD_BYTE=1",
  ]
  include_dirs += [ "//third_party/.src/skia" ]
  # Pin lib is typically is_official_build (no SK_DEBUG). Do not force SK_DEBUG
  # here — it would mismatch a Release skia.lib ABI/inlines.
}

# Matching Windows static lib from this pin's GN out (see README.md).
# Minimal CPU build embeds codec stubs in skia.lib; link skcms + Win system libs.
# Do not mix unrelated prebuilts from other trees.
config("skia_real_libs") {
  lib_dirs = [
    "//third_party/.src/skia_out/skia",
    "//third_party/.src/skia_out",
  ]
  libs = [
    "skia.lib",
    "skcms.lib",
    "usp10.lib",
    "fontsub.lib",
    "gdi32.lib",
    "user32.lib",
    "ole32.lib",
    "oleaut32.lib",
    "dwrite.lib",
    "windowscodecs.lib",
  ]
}

# DXGI WaitForVBlank helper. Linked into ui_views (via gfx_sources) and
# gpu_backend — keep free of UI_EXPORTS / Views types.
source_set("vblank_wait") {
  sources = [
    "display/vblank_wait.cc",
    "display/vblank_wait.h",
  ]
  public_configs = [ ":skia_config" ]
  libs = [
    "dxgi.lib",
    "user32.lib",
  ]
}

source_set("gfx_sources") {
  sources = [
    "canvas/canvas.cc",
    "canvas/canvas.h",
    "canvas/canvas_backend.h",
    "canvas/canvas_gdi.cc",
    "canvas/shell_canvas_backend.cc",
    "canvas/shell_canvas_backend.h",
    "color/color.h",
    "display_list/display_list.cc",
    "display_list/display_list.h",
    "font/font.cc",
    "font/font.h",
    "geometry/insets.h",
    "geometry/point.h",
    "geometry/rect.h",
    "geometry/size.h",
    "raster/paint_stats.cc",
    "raster/paint_stats.h",
    "raster/shell_raster.h",
  ]
  defines = [ "UI_EXPORTS" ]
  public_configs = [ ":skia_config" ]
  public_deps = [ ":vblank_wait" ]
  # GDI path always links gdi32; real Skia also BitBlts via gdi32.
  # font.cc uses CreateFontW / GetTextExtentPoint32W.
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]

  if (has_skia) {
    # Pin / optional prebuilt (under third_party/.src/, gitignored).
    # Only evaluated when the flag is on so default gen stays clean.
    _skia_hdr = exec_script("//build/file_exists.py",
                            [ "third_party/.src/skia/include/core/SkCanvas.h" ],
                            "trim string")
    _skia_lib = exec_script("//build/file_exists.py",
                            [ "third_party/.src/skia_out/skia/skia.lib" ],
                            "trim string")
    assert(
        _skia_hdr == "1",
        "has_skia=true but third_party/.src/skia pin is missing. " +
            "On Windows, UNC junctions fail — use an elevated directory " +
            "symlink, e.g. " +
            "mklink /D third_party\\.src\\skia " +
            "\\\\wsl\$\\Ubuntu-24.04\\home\\ccl\\dev\\src\\open\\topic\\graphic-engine\\skia " +
            "(see src/ui/gfx/README.md). Do not vendor Skia into git.")
    # Dual-backend: GDI always present; Skia linked for runtime --shell-canvas.
    sources += [ "canvas/canvas_skia.cc" ]
    public_configs += [ ":skia_real_config" ]
    if (_skia_lib == "1") {
      configs += [ ":skia_real_libs" ]
    } else {
      # Headers-only pin: TU still compiles; link will fail until a matching
      # Windows skia.lib is junctioned at third_party/.src/skia_out.
      # Do not silently link an ABI-mismatched prebuilt from another tree.
      print(
          "WARNING: has_skia=true but no matching skia.lib at " +
              "third_party/.src/skia_out/skia/skia.lib — link will fail " +
              "until a Windows build of this pin is provided. " +
              "Default has_skia=false (GDI) remains the supported path.")
    }
  } else {
    sources += [ "canvas/canvas_skia_stub.cc" ]
  }
}

# Include path for gfx headers (ShellRaster POD, geometry, …). Does not
# link ui_views.dll — use this from gpu / present code that only needs types.
group("gfx_headers") {
  public_configs = [ ":skia_config" ]
}

# Same PE as //src/ui/views:ui_views (gfx objects compile into that DLL).
# Import-links ui_views.dll (+ its public_deps content / tool / render).
# Prefer :gfx_headers when the consumer must not pull the Views PE.
group("gfx") {
  public_deps = [ "//src/ui/views:ui_views" ]
}
