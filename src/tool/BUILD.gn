import("//build/smartgis.gni")
import("//testing/test.gni")

# Session-scoped Command / Input / Workspace. Not the leftover IATool DLL.
# Leftover SmtIATool lives at //src/legacy_tool:tool.
source_set("dispatch") {
  sources = [
    "command.cc",
    "command.h",
    "gestures.cc",
    "gestures.h",
    "interaction.cc",
    "interaction.h",
    "legacy_msg.cc",
    "legacy_msg.h",
    "workspace.cc",
    "workspace.h",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/sdb/edit:edit" ]
}

test("tool_dispatch_test") {
  output_name = "tool_dispatch_test"
  sources = [ "dispatch_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":dispatch",
    "//src/plugin:legacy_cmd",
  ]
}
