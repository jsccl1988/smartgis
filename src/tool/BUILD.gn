import("//build/smartgis.gni")
import("//testing/test.gni")

# Session-scoped Command / Input / Workspace → one DLL (dll_stem = tool).
# Not leftover IATool (//src/legacy/tool:legacy_tool, LEGACY_TOOL_EXPORTS).
# GT_MSG adapter: //src/legacy/tool/adapter:adapter (not part of :tool).
# Layout: src/tool/{command,interaction,draft,nav,workspace}/
#
# In-DLL source_sets use TOOL_EXPORTS (legacy uses LEGACY_TOOL_EXPORTS).
# Stable groups (:dispatch, :command, …) forward to :tool for existing deps.
# content/public/map_types.h and event_bus.h are header-only ABI; this DLL
# does not link //src/content (avoids a content↔tool DLL cycle).

config("tool_config") {
  include_dirs += [ "//src" ]
}

source_set("command_sources") {
  sources = [
    "command/command.cc",
    "command/command.h",
    "tool_export.h",
  ]
  public_configs = [ ":tool_config" ]
  defines = [ "TOOL_EXPORTS" ]
}

source_set("interaction_sources") {
  sources = [
    "interaction/interaction.cc",
    "interaction/interaction.h",
  ]
  public_configs = [ ":tool_config" ]
  defines = [ "TOOL_EXPORTS" ]
}

source_set("nav_sources") {
  sources = [
    "nav/camera_nav.cc",
    "nav/camera_nav.h",
  ]
  public_configs = [ ":tool_config" ]
  defines = [ "TOOL_EXPORTS" ]
}

source_set("draft_sources") {
  sources = [
    "draft/draft.cc",
    "draft/draft.h",
  ]
  public_configs = [ ":tool_config" ]
  defines = [ "TOOL_EXPORTS" ]
  deps = [ ":interaction_sources" ]
}

source_set("workspace_sources") {
  sources = [
    "workspace/draft_pipeline.cc",
    "workspace/draft_pipeline.h",
    "workspace/nav_bridge.cc",
    "workspace/nav_bridge.h",
    "workspace/workspace.cc",
    "workspace/workspace.h",
  ]
  public_configs = [ ":tool_config" ]
  defines = [ "TOOL_EXPORTS" ]
  deps = [
    ":command_sources",
    ":draft_sources",
    ":interaction_sources",
    ":nav_sources",
  ]
  # EditSession lives in gis.dll; import-link via the shared library edge.
  public_deps = [ "//src/gis/model/edit:edit" ]
}

# Product tool DLL. Disk stem: tool.dll / tool_d.dll.
smt_shared_library("tool") {
  dll_stem = "tool"
  defines = [ "TOOL_EXPORTS" ]
  deps = [
    ":command_sources",
    ":draft_sources",
    ":interaction_sources",
    ":nav_sources",
    ":workspace_sources",
  ]
  public_deps = [ "//src/gis/model/edit:edit" ]
  public_configs = [ ":tool_config" ]
}

# Stable labels — same DLL as :tool.
group("command") {
  public_deps = [ ":tool" ]
}

group("interaction") {
  public_deps = [ ":tool" ]
}

group("nav") {
  public_deps = [ ":tool" ]
}

group("draft") {
  public_deps = [ ":tool" ]
}

group("workspace") {
  public_deps = [ ":tool" ]
}

group("dispatch") {
  public_deps = [ ":tool" ]
}

test("tool_dispatch_test") {
  output_name = "tool_dispatch_test"
  sources = [ "workspace/dispatch_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":dispatch",
    "//src/legacy/tool/adapter:adapter",
    "//src/plugin:cmd",
  ]
}

test("camera_nav_test") {
  output_name = "camera_nav_test"
  sources = [ "nav/camera_nav_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":nav" ]
}

test("draft_test") {
  output_name = "draft_test"
  sources = [ "draft/draft_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":dispatch" ]
}
