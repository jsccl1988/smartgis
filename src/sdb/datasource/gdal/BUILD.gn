import("//build/smartgis.gni")
import("//testing/test.gni")

source_set("ogr_codec") {
  sources = [
    "ogr_connect.cc",
    "ogr_connect.h",
    "ogr_feature_codec.cc",
    "ogr_feature_codec.h",
    "ogr_feature_kind.h",
  ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/map:gis",
    "//third_party:gdal",
  ]
}

smt_shared_library("sde_gdal") {
  dll_stem = "SmtSDEGdalDevice"
  defines = [ "Export_SmtSDEGdalDevice" ]
  sources = [
    "gdal_driver.cc",
    "gdal_driver.h",
    "ogr_dataset.cc",
    "ogr_dataset.h",
    "ogr_export.h",
    "ogr_raster_layer.cc",
    "ogr_raster_layer.h",
    "ogr_vec_layer.cc",
    "ogr_vec_layer.h",
    "sdbd_gdal_driver.cc",
    "sdbd_gdal_driver.h",
    "sdbd_handler.cc",
    "sdbd_handler.h",
    "sdbd_json.cc",
    "sdbd_json.h",
    "sdbd_types.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":ogr_codec",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/map:gis",
    "//third_party:gdal",
  ]
}

test("sde_gdal_test") {
  output_name = "sde_gdal_test"
  sources = [ "sde_gdal_test.cc" ]
  include_dirs += [
    "//src",
    "//src/sdb/datasource/mgr",
  ]
  deps = [
    ":ogr_codec",
    ":sde_gdal",
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/sdb/map:gis",
    "//third_party:gdal",
  ]
  data_deps = [
    ":sde_gdal",
    "//third_party:gdal_runtime_dlls",
  ]
}
