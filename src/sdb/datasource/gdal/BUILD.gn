import("//build/smartgis.gni")
import("//testing/test.gni")

# Shared OGR codec helpers. May be linked into sdb and into leftover render DLLs
# (each target gets its own copy; symbols are not SDE_GDAL_EXPORT).
source_set("ogr_codec") {
  sources = [
    "ogr_connect.cc",
    "ogr_connect.h",
    "ogr_feature_codec.cc",
    "ogr_feature_codec.h",
    "ogr_feature_kind.h",
  ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  include_dirs += [ "//src" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    # Headers only for SmtFeature — do not deps :gis group (same DLL cycle).
  ]
}

# Compiled into //src/sdb:sdb (dll_stem = sdb).
source_set("sde_gdal_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "SDE_GDAL_EXPORTS",
  ]
  sources = [
    "gdal_driver.cc",
    "gdal_driver.h",
    "ogr_export.h",
    "ogr_raster_layer.cc",
    "ogr_raster_layer.h",
    "sdbd_dataset.cc",
    "sdbd_dataset.h",
    "sdbd_gdal_driver.cc",
    "sdbd_gdal_driver.h",
    "sdbd_layer.cc",
    "sdbd_layer.h",
    "sdbd_handler.cc",
    "sdbd_handler.h",
    "sdbd_json.cc",
    "sdbd_json.h",
    "sdbd_types.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":ogr_codec",
    "//src/base:base",
    "//src/base:core",
    "//third_party:gdal",
  ]
}

group("sde_gdal") {
  public_deps = [ "//src/sdb:sdb" ]
}

test("sde_gdal_test") {
  output_name = "sde_gdal_test"
  sources = [ "sde_gdal_test.cc" ]
  include_dirs += [
    "//src",
    "//src/sdb/datasource/mgr",
  ]
  deps = [
    ":ogr_codec",
    ":sde_gdal",
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/sdb/map:gis",
    "//third_party:gdal",
  ]
  data_deps = [
    ":sde_gdal",
    "//third_party:gdal_runtime_dlls",
  ]
}
