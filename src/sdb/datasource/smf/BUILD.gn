import("//build/smartgis.gni")

smt_shared_library("sde_smf") {
  dll_stem = "SmtSDESmfDevice"
  defines = [
    "Export_SmtSDESmfDevice",
    "SUPPRESS_DEPRECATION_WARNINGS",
  ]
  sources = [
    "smf_api.cpp",
    "smf_ogrsupport.cpp",
    "smfdatasource.cpp",
    "smfraslayer.cpp",
    "smfveclayer.cpp",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/sdb/datasource/gdal:ogr_codec",
    "//src/sdb/datasource/mem:sde_mem",
    "//third_party/CxImage:CxImage",
    "//third_party:gdal",
  ]
}
