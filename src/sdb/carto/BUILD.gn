import("//build/smartgis.gni")

# Cartographic pen/brush/Envelope (NOT MapLibre Style JSON — that is //src/sdb/style).
#
# DLL choice: still compiled into the product platform DLL (//src/base:base,
# transitional dll_stem=base). Preferring the sdb DLL would create a link cycle:
# algorithm/geo includes Envelope, while sdb already depends on algorithm.
# Revisit when Envelope is header-only / no longer exported from platform.

source_set("carto_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "STYLE_EXPORTS=1",
  ]
  sources = [
    "style_api.cpp",
    "envelope.cpp",
    "style.cpp",
    "stylemanager.cpp",
    "styletable.cpp",
  ]
}

group("carto") {
  public_deps = [ "//src/base:base" ]
}
