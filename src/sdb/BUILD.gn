# Spatial DB / core GIS model (QGIS qgis_core analogue).
# One DLL (dll_stem = sdb): gis + sde_mgr + sde_gdal + tile/model/scene/edit/style.
# feature ≈ OGRFeature, layer ≈ OGRLayer, map ≈ QgsProject,
# datasource/<driver> ≈ GDAL/OGR / QGIS providers.
# Stable labels //src/sdb/map:gis, :sde_mgr, :sde_gdal → group to :sdb.

import("//build/smartgis.gni")

smt_shared_library("sdb") {
  dll_stem = "sdb"
  defines = [
    "SDB_EXPORTS",
    "GIS_EXPORTS",
    "SDE_MGR_EXPORTS",
    "SDE_GDAL_EXPORTS",
  ]
  deps = [
    "//src/sdb/map:gis_sources",
    "//src/sdb/datasource/gdal:sde_gdal_sources",
    "//src/sdb/datasource/mgr:sde_mgr_sources",
    "//src/sdb/tile:tile_sources",
    "//src/sdb/model:model_sources",
    "//src/sdb/scene:scene_sources",
    "//src/sdb/edit:edit_sources",
    "//src/sdb/edit:map_edit_sources",
    "//src/sdb/style:style_sources",
  ]
  public_deps = [ "//third_party:gdal" ]
}

group("sdb_all") {
  public_deps = [ ":sdb" ]
}

group("datasource") {
  public_deps = [ ":sdb" ]
}
