# Spatial DB / core GIS model (QGIS qgis_core analogue).
# feature ≈ OGRFeature, layer ≈ OGRLayer, map ≈ QgsProject,
# datasource/<driver> ≈ GDAL/OGR / QGIS providers.
group("sdb") {
  deps = [
    ":datasource",
    "//src/sdb/edit:edit",
    "//src/sdb/map:gis",
    "//src/sdb/model:model",
    "//src/sdb/scene:scene",
  ]
}

group("datasource") {
  deps = [
    "//src/sdb/datasource/mem:sde_mem",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/sdb/datasource/smf:sde_smf",
    "//src/sdb/datasource/ws:sde_ws",
    "//src/sdb/datasource/gdal:sde_gdal",
  ]
}
