import("//build/smartgis.gni")

# Map document + feature/layer types. DLL stem stays SmtGisCore.
smt_shared_library("gis") {
  dll_stem = "gis"
  defines = [ "GIS_EXPORTS" ]
  sources = [
    "../feature/attribute.cpp",
    "../feature/feature.cpp",
    "../feature/feature_api.cpp",
    "../feature/field.cpp",
    "map.cpp",
    "map_layer.cpp",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy_render/render3d:render3d",
  ]
}
