import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/sdb:sdb (dll_stem = sdb).
source_set("scene_sources") {
  sources = [
    "scene.cc",
    "scene.h",
    "tessellate.cc",
    "tessellate.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/sdb/model:model_sources",
    "//third_party:gdal",
  ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/datasource/gdal:ogr_codec",
  ]
}

group("scene") {
  public_deps = [ "//src/sdb:sdb" ]
}

test("scene_test") {
  output_name = "scene_test"
  sources = [ "scene_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":scene",
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}
