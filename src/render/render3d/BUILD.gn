import("//build/smartgis.gni")

smt_shared_library("render3d") {
  dll_stem = "render3d"
  defines = [ "RENDER3D_EXPORTS" ]
  sources = [
    "3dmaterial.cpp",
    "3drenderer.cpp",
    "arbvcamera.cpp",
    "camera.cpp",
    "camera_factory.cpp",
    "color.cpp",
    "combinedcamera.cpp",
    "fpscamera.cpp",
    "framebuffer.cpp",
    "light.cpp",
    "orthcamera.cpp",
    "perspcamera.cpp",
    "program.cpp",
    "programmanager.cpp",
    "shader.cpp",
    "shadermanager.cpp",
    "statesmanager.cpp",
    "texture.cpp",
    "texturemanager.cpp",
    "videobuffer.cpp",
  ]
  public_deps = [ "//src/render/math:math" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
  ]
}