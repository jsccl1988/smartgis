import("//build/smartgis.gni")
import("//testing/test.gni")

config("rhi_flycube") {
  defines = [ "SMT_HAS_FLYCUBE" ]
}

source_set("rhi") {
  sources = [
    "rhi/flycube_rhi.cc",
    "rhi/gdi_rhi.cc",
    "rhi/gl_rhi.cc",
    "rhi/null_rhi.cc",
    "rhi/rhi.cc",
    "rhi/rhi.h",
  ]
  include_dirs += [ "//src" ]
  if (smt_has_flycube) {
    public_configs = [ ":rhi_flycube" ]
    deps = [ "//third_party:flycube" ]
  }
}

test("rhi_test") {
  output_name = "rhi_test"
  sources = [ "rhi/rhi_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":rhi" ]
}

# Endgame only. Full SmtRender DLL and leftover engines live under
# //src/legacy_render. Skia stub is //src/render/skia via //:ui_views.
group("render_all") {
  deps = [
    ":rhi",
    "//src/render/math:bounds",
    "//src/render/math:math",
    "//src/render/scene:scene",
  ]
}
