import("//build/smartgis.gni")
import("//testing/test.gni")

# Endgame render layer → one DLL (dll_stem = render):
#   rhi + scene + skia + math/bounds source_sets.
# Does NOT include //src/legacy_render/** (optional leftover DLL).
# math/bounds stay linkable source_sets for algorithm/legacy consumers so they
# do not pull this DLL; they are also chained into :render.

config("rhi_flycube") {
  defines = [ "SMT_HAS_FLYCUBE" ]
}

source_set("rhi_sources") {
  sources = [
    "rhi/flycube_rhi.cc",
    "rhi/gdi_rhi.cc",
    "rhi/gl_rhi.cc",
    "rhi/null_rhi.cc",
    "rhi/rhi.cc",
    "rhi/rhi.h",
  ]
  include_dirs += [ "//src" ]
  defines = [ "RENDER_EXPORTS" ]
  if (smt_has_flycube) {
    public_configs = [ ":rhi_flycube" ]
    deps = [ "//third_party:flycube" ]
  }
}

# Stable label; forwards to the render DLL.
group("rhi") {
  public_deps = [ ":render" ]
}

test("rhi_test") {
  output_name = "rhi_test"
  sources = [ "rhi/rhi_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":rhi" ]
}

smt_shared_library("render") {
  dll_stem = "render"
  defines = [ "RENDER_EXPORTS" ]
  deps = [
    ":rhi_sources",
    "//src/render/math:bounds",
    "//src/render/math:math",
    "//src/render/scene:scene_sources",
    "//src/render/skia:skia_sources",
  ]
  # scene headers expose sdb::scene types; bounds uses base macros.
  public_deps = [
    "//src/base:base",
    "//src/sdb:sdb",
  ]
  # Forward FlyCube presence to consumers (tests / Views) that branch on
  # SMT_HAS_FLYCUBE; source_set public_configs do not flow through the DLL.
  if (smt_has_flycube) {
    public_configs = [ ":rhi_flycube" ]
  }
}

# Endgame aggregator. Skia GDI stub is part of the render DLL (Views consumers
# still use //src/render/skia:skia → :render). Leftover engines stay under
# //src/legacy_render.
group("render_all") {
  public_deps = [ ":render" ]
}
