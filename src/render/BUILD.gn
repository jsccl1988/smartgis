import("//build/smartgis.gni")
import("//testing/test.gni")

# Endgame render layer → one DLL (dll_stem = render):
#   rhi + programs + graph traversal. GPU scene is //src/effect/scene (caller-linked).
# Shell raster lives in //src/ui/gfx, not this DLL.
# Does NOT include //src/legacy/render/** (optional leftover DLL).
# Scene math is //src/base/math:{math,bounds} and is not linked into this DLL.

config("rhi_flycube") {
  defines = [ "SMT_HAS_FLYCUBE" ]
}

source_set("rhi_sources") {
  sources = [
    "rhi/flycube/command/command_list.cc",
    "rhi/flycube/command/command_list.h",
    "rhi/flycube/command/recorder.cc",
    "rhi/flycube/command/recorder.h",
    "rhi/flycube/device.cc",
    "rhi/flycube/device.h",
    "rhi/flycube/execute.cc",
    "rhi/flycube/pipeline/hlsl.cc",
    "rhi/flycube/pipeline/hlsl.h",
    "rhi/flycube/pipeline/program.cc",
    "rhi/flycube/pipeline/program.h",
    "rhi/flycube/resource/gpu.h",
    "rhi/flycube/resource/resources.cc",
    "rhi/flycube/resource/resources.h",
    "rhi/flycube/shared_import.cc",
    "rhi/rhi.cc",
    "rhi/rhi.h",
    "rhi/stub/stub_device.cc",
  ]
  include_dirs += [ "//src" ]
  defines = [ "RENDER_EXPORTS" ]
  if (smt_has_flycube) {
    public_configs = [ ":rhi_flycube" ]
    deps = [ "//third_party:flycube" ]
  }
}

source_set("programs_sources") {
  sources = [
    "programs/programs.h",
    "programs/programs.cc",
  ]
  include_dirs += [ "//src" ]
  defines = [ "RENDER_EXPORTS" ]
  public_deps = [ ":rhi_sources" ]
}

# Stable label; forwards to the render DLL.
group("rhi") {
  public_deps = [ ":render" ]
}

test("rhi_test") {
  output_name = "rhi_test"
  sources = [ "rhi/rhi_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":rhi" ]
}

smt_shared_library("render") {
  dll_stem = "render"
  defines = [ "RENDER_EXPORTS" ]
  deps = [
    ":programs_sources",
    ":rhi_sources",
    "//src/render/graph:graph_sources",
  ]
  # Forward FlyCube presence to consumers (tests / Views) that branch on
  # SMT_HAS_FLYCUBE; source_set public_configs do not flow through the DLL.
  if (smt_has_flycube) {
    public_configs = [ ":rhi_flycube" ]
  }
}

# Endgame aggregator. Leftover engines stay under //src/legacy/render.
# Views shell raster is //src/ui/gfx:gfx (not this DLL).
group("render_all") {
  public_deps = [ ":render" ]
}
