import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/render:render (dll_stem = render).
# Deps rhi_sources (not :rhi group) to avoid a render ↔ scene cycle.
source_set("scene_sources") {
  sources = [
    "frustum_aabb.cc",
    "frustum_aabb.h",
    "scene.cc",
    "scene.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [ "RENDER_EXPORTS" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/render:rhi_sources",
    "//src/gis/world:world",
  ]
}

group("scene") {
  public_deps = [ "//src/render:render" ]
}

test("scene_gpu_test") {
  output_name = "scene_gpu_test"
  sources = [ "scene_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":scene",
    "//third_party:gdal",
  ]
}

test("unified_draw_test") {
  output_name = "unified_draw_test"
  sources = [ "unified_draw_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":scene",
    "//src/algorithm/geo:geo",
    "//src/gis/map:gis",
    "//third_party:gdal",
  ]
  if (smt_has_flycube) {
    defines = [ "SMT_HAS_FLYCUBE" ]
  }
}
