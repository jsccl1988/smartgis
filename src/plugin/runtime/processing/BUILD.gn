import("//build/smartgis.gni")
import("//testing/test.gni")

# Thin plugin:: forwarders to gis::detail (implementation in gis.dll).
source_set("processing_ops") {
  sources = [
    "ops_runner.cc",
    "ops_runner.h",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//src/gis:gis" ]
}

source_set("processing_views") {
  sources = [
    "builtin_ops.cc",
    "builtin_ops.h",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ ":processing_ops" ]
  deps = [
    "//src/app/views:plugin_builtins",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
  ]
}

test("processing_ops_test") {
  output_name = "processing_ops_test"
  sources = [ "builtin_ops_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":processing_ops",
    "//third_party:gdal",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}
