# Plugin host / shared runtime DLL (dll_stem = plugin_host).
# Role subdirs: catalog / native / capability / processing / present / ui /
# tests. Export macro stays at host root. One-file capability facades sit
# beside capability.h (including HarnessShell / scenario / marks). GisDocument
# helpers stay in present/.
# Product *_views stay source_sets (Phase-2 per-stem DLLs later).

import("//build/smartgis.gni")
import("//testing/test.gni")

config("plugin_host_config") {
  include_dirs += [
    "//src",
    "//src/base/core",
  ]
}

source_set("host_sources") {
  sources = [
    "plugin_host_export.h",
    "catalog/contribute_index.cc",
    "catalog/contribute_index.h",
    "catalog/manifest.cc",
    "catalog/manifest.h",
    "catalog/official_key.h",
    "catalog/registry.cc",
    "catalog/registry.h",
    "catalog/resource_roots.cc",
    "catalog/resource_roots.h",
    "catalog/signature.cc",
    "catalog/signature.h",
    "catalog/signature_test_key.h",
    "catalog/store.cc",
    "catalog/store.h",
    "native/exports.h",
    "native/manager.cc",
    "native/manager.h",
    "native/module.cc",
    "native/module.h",
    "native/scan.cc",
    "native/scan.h",
    "capability/capability.h",
    "capability/contribute.h",
    "capability/scenario_command.h",
    "capability/scenario_shell.cc",
    "capability/scenario_shell.h",
    "capability/marks.h",
    "capability/pack_ensure.cc",
    "capability/pack_ensure.h",
    "capability/scenario.cc",
    "capability/scenario.h",
    "capability/shell.h",
    "capability/map2d_sink.cc",
    "capability/map2d_sink.h",
    "capability/report_bridge.cc",
    "capability/report_bridge.h",
    "capability/scene3d_sink.cc",
    "capability/scene3d_sink.h",
    "capability/shell_ui.cc",
    "capability/shell_ui.h",
    "present/gis_present.cc",
    "present/gis_present.h",
    "processing/args_json.cc",
    "processing/args_json.h",
    "processing/operation_result.cc",
    "processing/operation_result.h",
    "processing/processing.cc",
    "processing/processing.h",
    "processing/reexport_file.cc",
    "processing/reexport_file.h",

    "ui/manager_view.cc",
    "ui/manager_view.h",
  ]
  public_configs = [ ":plugin_host_config" ]
  defines = [ "PLUGIN_HOST_EXPORTS" ]
  deps = [
    "//src/base:foundation",
    "//src/base:core",
    "//src/content:content",
    "//src/content:capability",
    "//src/net:net",
    "//src/tool:dispatch",
    "//src/ui/views:views",
    "//third_party:ed25519",
    "//third_party:rapidjson",
  ]
}

# Product host API + shared widgets runtime. Disk: plugin_host.dll / _d.
product_shared_library("host") {
  dll_stem = "plugin_host"
  defines = [ "PLUGIN_HOST_EXPORTS" ]
  deps = [
    ":host_sources",
    "//src/plugin/runtime/web:web_sources",
    "//src/plugin/runtime/widgets:widgets_sources",
  ]
  public_deps = [
    "//src/content:content",
    "//src/tool:dispatch",
    "//src/ui/views:views",
  ]
  public_configs = [ ":plugin_host_config" ]
}

test("plugin_host_test") {
  output_name = "plugin_host_test"
  sources = [ "tests/host_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":host",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/product/map2d:map2d_views",
    "//third_party:cpp_httplib",
  ]
  data_deps = [
    "//third_party:gdal_runtime_dlls",
  ]
  libs += [ "ws2_32.lib" ]
}

test("plugin_manager_test") {
  output_name = "plugin_manager_test"
  sources = [ "tests/manager_test.cc" ]
  include_dirs += [ "//src" ]
  # Same module as scan_plugins_dir (do not import std::vector<DiscoveredPlugin>
  # from plugin_host.dll — debug STL is not a DLL ABI).
  deps = [ ":host_sources" ]
}
