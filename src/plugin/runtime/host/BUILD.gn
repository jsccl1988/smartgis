# Plugin host / shared runtime DLL (dll_stem = plugin_host).
# Role subdirs: registry / manifest / store / signature / processing /
# resources / ui / tests. Export macro stays at host root.
# Product *_views stay source_sets (Phase-2 per-stem DLLs later).

import("//build/smartgis.gni")
import("//testing/test.gni")

config("plugin_host_config") {
  include_dirs += [
    "//src",
    "//src/base/core",
  ]
}

source_set("host_sources") {
  sources = [
    "manifest/manifest.cc",
    "manifest/manifest.h",
    "plugin_host_export.h",
    "processing/operation_result.cc",
    "processing/operation_result.h",
    "processing/processing.cc",
    "processing/processing.h",
    "present/gis_present.cc",
    "present/gis_present.h",
    "registry/registry.cc",
    "registry/registry.h",
    "resources/resource_roots.cc",
    "resources/resource_roots.h",
    "signature/official_key.h",
    "signature/signature.cc",
    "signature/signature.h",
    "signature/signature_test_key.h",
    "store/store.cc",
    "store/store.h",
    "ui/manager_view.cc",
    "ui/manager_view.h",
  ]
  public_configs = [ ":plugin_host_config" ]
  defines = [ "PLUGIN_HOST_EXPORTS" ]
  deps = [
    "//src/base:foundation",
    "//src/base:core",
    "//src/content:content",
    "//src/net:net",
    "//src/tool:dispatch",
    "//src/ui/views:views",
    "//third_party:ed25519",
    "//third_party:rapidjson",
  ]
}

# Product host API + shared widgets runtime. Disk: plugin_host.dll / _d.
product_shared_library("host") {
  dll_stem = "plugin_host"
  defines = [ "PLUGIN_HOST_EXPORTS" ]
  deps = [
    ":host_sources",
    "//src/plugin/runtime/browser:browser_sources",
    "//src/plugin/runtime/widgets:widgets_sources",
  ]
  public_deps = [
    "//src/content:content",
    "//src/tool:dispatch",
    "//src/ui/views:views",
  ]
  public_configs = [ ":plugin_host_config" ]
}

test("plugin_host_test") {
  output_name = "plugin_host_test"
  sources = [ "tests/host_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":host",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/product/print:print_views",
    "//third_party:cpp_httplib",
  ]
  data_deps = [
    "//third_party:gdal_runtime_dlls",
  ]
  libs += [ "ws2_32.lib" ]
}
