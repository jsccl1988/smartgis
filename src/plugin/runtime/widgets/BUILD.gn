# Shared dialog / map + world preview helpers compiled into plugin_host.dll.
# Stable :widgets label forwards to that DLL (import-link consumers).

import("//build/smartgis.gni")

source_set("widgets_sources") {
  sources = [
    "about_dialog.cc",
    "about_dialog.h",
    "map_preview.cc",
    "map_preview.h",
    "owned_dialog.cc",
    "owned_dialog.h",
    "present_surface_picker.cc",
    "present_surface_picker.h",
    "world_preview.cc",
    "world_preview.h",
  ]
  include_dirs += [ "//src" ]
  defines = [ "PLUGIN_HOST_EXPORTS" ]
  public_deps = [
    "//src/ui/gis:gis",
    "//src/ui/views:views",
  ]
}

group("widgets") {
  public_deps = [ "//src/plugin/runtime/host:host" ]
}
