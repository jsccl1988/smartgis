import("//build/smartgis.gni")
import("//testing/test.gni")

# Plugin-private kernel: Eigen SparseLU Laplace / Thompson elliptic.
source_set("orthogrid_kernel") {
  sources = [
    "curve.cpp",
    "detail/laplace_solver.cc",
    "detail/polyline.cpp",
    "grid.cpp",
    "grid_create.cpp",
    "grid_modify.cpp",
    "region.cpp",
  ]
  configs += [ "//build:legacy" ]
  include_dirs += [
    "//src/plugin/orthogrid",
    "//src",
  ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/sdb/map:gis",
    "//third_party:eigen",
  ]
}

source_set("orthogrid_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "detail/laplace_solver.cc",
    "detail/laplace_solver.h",
  ]
  include_dirs += [
    "//src",
    "//src/plugin/orthogrid",
  ]
  deps = [
    "//src/content:content",
    "//src/plugin/host:host",
    "//src/ui/views:views",
    "//third_party:eigen",
  ]
}

test("orthogrid_laplace_test") {
  output_name = "orthogrid_laplace_test"
  sources = [
    "detail/laplace_solver.cc",
    "detail/laplace_solver_test.cc",
  ]
  include_dirs += [
    "//src",
    "//src/plugin/orthogrid/detail",
  ]
  deps = [ "//third_party:eigen" ]
}
