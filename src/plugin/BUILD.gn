# Plugin root: re-export labels used across the tree.
# Runtime (host / processing / widgets / python) under plugin/runtime/.
# Domain Views under plugin/product/. Leftover AuxModule is
# //src/legacy/plugin (re-exported here as :plugin, dll_stem = plugin).
# Host API DLL: //src/plugin/runtime/host:host (dll_stem = plugin_host).
# :cmd forwards to //src/legacy/plugin/runtime:cmd (header-only AM_MSG map).
# *.am scan lives on //src/legacy/plugin/runtime:bridge (plugin_host only).

import("//build/smartgis.gni")

group("plugin") {
  public_deps = [ "//src/legacy/plugin:plugin" ]
}

group("cmd") {
  public_deps = [ "//src/legacy/plugin/runtime:cmd" ]
}

group("host") {
  public_deps = [ "//src/plugin/runtime/host:host" ]
}

group("plugin_host_test") {
  testonly = true
  public_deps = [ "//src/plugin/runtime/host:plugin_host_test" ]
}

group("processing") {
  public_deps = [ "//src/plugin/runtime/processing:processing_views" ]
}
