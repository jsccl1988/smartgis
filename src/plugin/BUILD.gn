# Plugin root: re-export labels used across the tree.
# Physical sources live under host/, legacy/, legacy_*/, dem/, …

import("//build/smartgis.gni")

group("plugin") {
  public_deps = [ "//src/plugin/legacy:plugin" ]
}

group("legacy_cmd") {
  public_deps = [ "//src/plugin/host:legacy_cmd" ]
}

group("host") {
  public_deps = [ "//src/plugin/host:host" ]
}

group("plugin_host_test") {
  testonly = true
  public_deps = [ "//src/plugin/host:plugin_host_test" ]
}
