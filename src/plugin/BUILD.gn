# Plugin root. Runtime (host / web / processing / widgets / python) under
# plugin/runtime/. Domain Views under plugin/product/.
# Host API DLL: //src/plugin/runtime/host:host (dll_stem = plugin_host).

import("//build/smartgis.gni")

group("host") {
  public_deps = [ "//src/plugin/runtime/host:host" ]
}

group("plugin_host_test") {
  testonly = true
  public_deps = [ "//src/plugin/runtime/host:plugin_host_test" ]
}

group("plugin_report_browser_test") {
  testonly = true
  public_deps = [ "//src/plugin/runtime/web:plugin_report_browser_test" ]
}

group("processing") {
  public_deps = [ "//src/plugin/runtime/processing:processing_views" ]
}

group("product_views") {
  public_deps = [ "//src/plugin/product:product_views" ]
}

group("product_native") {
  public_deps = [ "//src/plugin/product:product_native" ]
}
