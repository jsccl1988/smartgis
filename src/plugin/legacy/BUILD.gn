import("//build/smartgis.gni")

# Leftover AuxModule runtime DLL (SmtAuxModule / dll_stem plugin).
smt_shared_library("plugin") {
  dll_stem = "plugin"
  defines = [ "PLUGIN_EXPORTS" ]
  sources = [
    "module.cpp",
    "module_manager.cpp",
    "plugin_msg.cpp",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:core" ]
}
