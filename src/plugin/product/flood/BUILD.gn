import("//build/python.gni")
import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("flood_resources") {
  sources = [
    "manifest/plugin.json",
    "resources/flood.style.json",
    "resources/inundate.ui.css",
    "resources/inundate.ui.xml",
  ]
  outputs = [ "$root_out_dir/plugins/flood/{{source_file_part}}" ]
}

copy("flood_levels_plugin") {
  sources = [
    "script/plugin.json",
    "script/plugin.py",
  ]
  outputs = [ "$root_out_dir/plugins/flood_levels/{{source_file_part}}" ]
}

copy("flood_levels_ext") {
  sources = [ "script/ext/__init__.py" ]
  outputs = [ "$root_out_dir/plugins/flood_levels/ext/__init__.py" ]
}

source_set("flood_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "present/present.cc",
    "present/present.h",
    "views/inundate_dialog.cc",
    "views/inundate_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/base:base",
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:dispatch",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [ ":flood_resources" ]
}

native_plugin("flood_native") {
  package = "flood"
  entry = "dll_entry.cc"
  deps = [ ":flood_views" ]
  data_deps = [
    ":flood_resources",
    ":flood_levels_plugin",
    ":flood_levels_ext",
  ]
}

test("flood_inundate_test") {
  output_name = "flood_inundate_test"
  sources = [
    "gate.cc",
    "gate.h",
    "tests/inundate_test.cc",
    "tests/level_curve_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":flood_views",
    "//src/base:base",
    "//src/content:content",
    "//src/content/browser/glang.runtime:cpython",
    "//src/gis:gis",
    "//src/plugin/runtime/extension:extension",
    "//src/plugin/runtime/host:host",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
    "//third_party/gn:dll_search",
  ]
  defines = [
    "FLOOD_LEVELS_DIR=\"" +
        rebase_path("//src/plugin/product/flood/script") + "\"",
  ]
  data_deps = [
    ":flood_resources",
    ":flood_levels_plugin",
    ":flood_levels_ext",
    "//third_party:gdal_runtime_dlls",
  ]
  if (python_enabled && python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/extension:python312_dll",
      "//src/plugin/runtime/extension:python3_dll",
    ]
  }
  ldflags = [ "/ENTRY:mainCRTStartup", "/INCLUDE:__pfnDliNotifyHook2" ]
}
