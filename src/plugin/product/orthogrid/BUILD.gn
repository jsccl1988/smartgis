import("//build/smartgis.gni")
import("//testing/test.gni")

# Product package: commands.* + manifest/plugin.json + detail/ (Laplace).
# Views registration stays in register_orthogrid; plugin.json is the declared
# contract (PluginShell may load it later). The 2010 Orthogrid class lives in
# //src/legacy/plugin/product/orthogrid:orthogrid_kernel so orthogrid_views does not
# pull the GIS/MFC graph. legacy_orthogrid_kernel only loads that target into
# the GN graph; orthogrid_views does not depend on it.
group("legacy_orthogrid_kernel") {
  deps = [ "//src/legacy/plugin/product/orthogrid:orthogrid_kernel" ]
}

source_set("orthogrid_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "detail/boundary_solve.cc",
    "detail/boundary_solve.h",
    "detail/laplace_solver.cc",
    "detail/laplace_solver.h",
    "detail/orthogonality.cc",
    "detail/orthogonality.h",
  ]
  include_dirs += [
    "//src",
    "//src/plugin/product/orthogrid",
  ]
  deps = [
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
  public_deps = [ "//third_party:eigen" ]
}

test("orthogrid_laplace_test") {
  output_name = "orthogrid_laplace_test"
  sources = [
    "detail/boundary_solve.cc",
    "detail/laplace_solver.cc",
    "detail/orthogonality.cc",
    "tests/laplace_solver_test.cc",
  ]
  include_dirs += [
    "//src",
    "//src/plugin/product/orthogrid",
  ]
  deps = [ "//third_party:eigen" ]
}
