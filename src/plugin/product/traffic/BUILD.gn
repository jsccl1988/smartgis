import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("traffic_resources") {
  sources = [
    "manifest/plugin.json",
    "resources/shortest_path.ui.css",
    "resources/shortest_path.ui.xml",
    "resources/traffic.style.json",
  ]
  outputs = [ "$root_out_dir/plugins/traffic/{{source_file_part}}" ]
}

source_set("traffic_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "present/present.cc",
    "present/present.h",
    "views/shortest_path_dialog.cc",
    "views/shortest_path_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:dispatch",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [ ":traffic_resources" ]
}

native_plugin("traffic_native") {
  package = "traffic"
  entry = "dll_entry.cc"
  deps = [ ":traffic_views" ]
  data_deps = [ ":traffic_resources" ]
}

source_set("traffic_harness") {
  sources = [
    "scenario/register.cc",
    "scenario/register.h",
    "scenario/run.cc",
    "scenario/run.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    ":traffic_views",
    "//src/content:content",
    "//src/plugin/product/world3d:world3d_harness",
    "//src/plugin/runtime/host:host",
  ]
}

test("traffic_path_test") {
  output_name = "traffic_path_test"
  sources = [ "tests/path_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":traffic_views",
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    ":traffic_resources",
    "//third_party:gdal_runtime_dlls",
  ]
}
