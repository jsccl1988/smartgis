import("//build/python.gni")
import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("mine_reserves_plugin") {
  sources = [
    "script/plugin.json",
    "script/plugin.py",
  ]
  outputs = [ "$root_out_dir/plugins/mine_reserves/{{source_file_part}}" ]
}

copy("mine_reserves_ext") {
  sources = [ "script/ext/__init__.py" ]
  outputs = [ "$root_out_dir/plugins/mine_reserves/ext/__init__.py" ]
}

copy("mine_resources") {
  sources = [
    "manifest/plugin.json",
    "resources/interpolate.ui.css",
    "resources/interpolate.ui.xml",
    "resources/mine.style.json",
  ]
  outputs = [ "$root_out_dir/plugins/mine/{{source_file_part}}" ]
}

source_set("mine_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "present/stratum.cc",
    "present/stratum.h",
    "views/interpolate_dialog.cc",
    "views/interpolate_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/content:content",
    "//src/content:scene3d_present",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:tool",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
  data_deps = [ ":mine_resources" ]
}

native_plugin("mine_native") {
  package = "mine"
  entry = "dll_entry.cc"
  deps = [ ":mine_views" ]
  data_deps = [
    ":mine_resources",
    ":mine_reserves_plugin",
    ":mine_reserves_ext",
  ]
}

test("mine_stratum_test") {
  output_name = "mine_stratum_test"
  sources = [
    "gate.cc",
    "gate.h",
    "tests/stratum_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":mine_views",
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
  ]
  data_deps = [ ":mine_resources" ]
  ldflags = [ "/ENTRY:mainCRTStartup" ]
}

test("mine_reserve_test") {
  output_name = "mine_reserve_test"
  sources = [ "tests/reserve_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":mine_views",
    "//src/base:base",
    "//src/content:content",
    "//src/content/browser/glang.runtime:cpython",
    "//src/gis:gis",
    "//src/plugin/runtime/extension:extension",
    "//src/plugin/runtime/host:host",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
  defines = [
    "MINE_RESERVES_DIR=\"" +
        rebase_path("//src/plugin/product/mine/script") + "\"",
  ]
  data_deps = [
    ":mine_resources",
    ":mine_reserves_plugin",
    ":mine_reserves_ext",
  ]
  if (python_enabled && python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/extension:python312_dll",
      "//src/plugin/runtime/extension:python3_dll",
    ]
  }
  ldflags = [ "/ENTRY:mainCRTStartup" ]
}
