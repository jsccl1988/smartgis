native_plugin("world3d_native") {
  package = "world3d"
  entry = "dll_entry.cc"
  deps = [ ":world3d_views" ]
  data_deps = [
    ":world3d_data_stub",
    ":world3d_resources",
  ]
}

test("world3d_loader_test") {
  output_name = "world3d_loader_test"
  sources = [ "scene/dem/tests/loader_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":world3d_dem",
    ":world3d_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    ":world3d_resources",
    "//src/gis/geo:tin",
    "//src/gis/geo:geo",
    "//third_party:gdal_runtime_dlls",
  ]
}

