test("world3d_loader_test") {
  output_name = "world3d_loader_test"
  sources = [ "grid/dem/tests/loader_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":world3d_dem",
    ":world3d_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    ":world3d_resources",
    "//src/gis/geo:tin",
    "//src/gis/geo:geo",
    "//third_party:gdal_runtime_dlls",
  ]
}

test("world3d_scene_writer_test") {
