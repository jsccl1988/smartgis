    "grid/orthogrid/lattice/ortho_lattice.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  public_deps = [ "//third_party:gdal" ]
}

source_set("world3d_orthogrid") {
  sources = [
    "grid/orthogrid/register.cc",
    "grid/orthogrid/register.h",
