import("//build/smartgis.gni")
import("//testing/test.gni")

# Plugin-owned markup/assets → shared out/plugins/world3d (not out/ui).
# Shell points --plugins-dir at out/plugins (default: <exe>/../plugins).
copy("world3d_resources") {
  sources = [
    "grid/dem/dialog/heightmap_loader.ui.css",
    "grid/dem/dialog/heightmap_loader.ui.xml",
    "grid/dem/dialog/trimesh_loader.ui.css",
    "grid/dem/dialog/trimesh_loader.ui.xml",
    "resources/orthogrid.style.json",
    "resources/world3d.style.json",
  ]
  outputs = [ "$root_out_dir/../plugins/world3d/{{source_file_part}}" ]
}

# Data stub docs → out/plugins/world3d/data/ (GeoTIFFs are user-supplied).
copy("world3d_data_stub") {
  sources = [ "resources/data/README.md" ]
  outputs = [ "$root_out_dir/../plugins/world3d/data/{{source_file_part}}" ]
}

# DEM XYZ/heightmap kernels (Views + leftover plugin_dem / plugin_model3d).
source_set("world3d_dem") {
  sources = [
    "grid/dem/loader/heightmap_loader.cc",
    "grid/dem/loader/heightmap_loader.h",
    "grid/dem/loader/trimesh_loader.cc",
    "grid/dem/loader/trimesh_loader.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  public_deps = [
    "//src/gis/geo:geo",
    "//third_party:gdal",
  ]
  deps = [
    "//src/gis/geo:tin",
    "//src/base:core",
    "//src/base/math:math",
  ]
}

# Alias for leftover GN that still named the kernel set "processing".
group("world3d_processing") {
  public_deps = [ ":world3d_dem" ]
}

source_set("world3d_hexgrid") {
  sources = [
    "grid/hexgrid/register.cc",
    "grid/hexgrid/register.h",
    "detail/contribute.h",
    "grid/hexgrid/present/mesh.cc",
    "grid/hexgrid/present/mesh.h",
    "grid/hexgrid/solve/boundary_solve.cc",
    "grid/hexgrid/solve/boundary_solve.h",
    "grid/hexgrid/lattice/hex_lattice.cc",
    "grid/hexgrid/lattice/hex_lattice.h",
    "grid/hexgrid/sample/sample_volume.cc",
    "grid/hexgrid/sample/sample_volume.h",
    "grid/hexgrid/io/vtk_structured.cc",
    "grid/hexgrid/io/vtk_structured.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/content:content",
    "//src/content:scene3d_present",
    "//src/gis:gis",
    "//src/gis/geo:geo",
    "//src/gis/geo:tin",
    "//src/base:core",
    "//src/base/math:math",
    "//src/plugin/runtime/host:host",
    "//src/tool:tool",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
}

# XY lattice buffer only (gdal). Leftover rhi2d / 2010 orthogrid kernel may
