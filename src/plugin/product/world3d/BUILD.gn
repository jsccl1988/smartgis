import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

# Plugin-owned markup/assets → $root_out_dir/plugins/world3d (not out/ui).
# Shell --plugins-dir defaults to <exe>/plugins (out/Debug/plugins or
# out/Release/plugins).
copy("world3d_resources") {
  sources = [
    "scene/dem/dialog/heightmap_loader.ui.css",
    "scene/dem/dialog/heightmap_loader.ui.xml",
    "scene/dem/dialog/trimesh_loader.ui.css",
    "scene/dem/dialog/trimesh_loader.ui.xml",
    "manifest/plugin.json",
    "resources/orthogrid.style.json",
    "resources/world3d.style.json",
  ]
  outputs = [ "$root_out_dir/plugins/world3d/{{source_file_part}}" ]
}

# Data stub docs → $root_out_dir/plugins/world3d/data/ (GeoTIFFs are user-supplied).
copy("world3d_data_stub") {
  sources = [ "resources/data/README.md" ]
  outputs = [ "$root_out_dir/plugins/world3d/data/{{source_file_part}}" ]
}

# DEM XYZ/heightmap kernels (Views + leftover plugin_dem / plugin_model3d).
source_set("world3d_dem") {
  sources = [
    "scene/dem/loader/heightmap_loader.cc",
    "scene/dem/loader/heightmap_loader.h",
    "scene/dem/loader/trimesh_loader.cc",
    "scene/dem/loader/trimesh_loader.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  public_deps = [
    "//src/gis/geo:geo",
    "//third_party:gdal",
  ]
  deps = [
    "//src/gis/geo:tin",
    "//src/base:core",
    "//src/base/math:math",
  ]
}

# Alias for leftover GN that still named the kernel set "processing".
group("world3d_processing") {
  public_deps = [ ":world3d_dem" ]
}

