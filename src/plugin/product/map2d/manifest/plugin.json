{
  "id": "smartgis.map2d",
  "name": "二维地图样例",
  "version": "1.0.0",
  "api_version": 2,
  "kind": "native",
  "library": "map2d.dll",
  "author": "The Mogu Authors",
  "description": "China carto, MapLibre align style, orthogrid mesh seed, and map print preview. Leftover SmtAMMapPrint maps to this id (former smartgis.print).",
  "startup": {
    "activate": true,
    "viewport": "map2d",
    "priority": 20
  },
  "contributes": {
    "commands": [
      {"id": "map2d.seed", "title": "加载二维样例", "menu": "tools"},
      {"id": "map2d.open_map", "title": "打开二维地图", "menu": "tools"},
      {"id": "map2d.frame_to", "title": "二维框选", "menu": "tools"},
      {"id": "map2d.attach_dataset", "title": "挂载二维数据", "menu": "tools"},
      {"id": "map2d.load_hillshade", "title": "加载二维DEM", "menu": "tools"},
      {"id": "map2d.apply_look", "title": "二维外观预设", "menu": "tools"},
      {"id": "map2d.frame_fly", "title": "二维飞入", "menu": "tools"},
      {"id": "map2d.export_bmp", "title": "导出二维BMP", "menu": "tools"},
      {"id": "map2d.present_gpu", "title": "二维GPU呈现", "menu": "tools"},
      {"id": "map2d.add_standin_layer", "title": "二维占位多边形", "menu": "tools"},
      {"id": "print.preview", "title": "打印", "menu": "file"}
    ],
    "dialogs": [
      {"id": "print.preview", "title": "打印"}
    ],
    "processing": [
      {"id": "map2d.seed", "title": "Seed map2d showcase document"},
      {"id": "map2d.open_map", "title": "打开二维地图"},
      {"id": "map2d.frame_to", "title": "二维框选"},
      {"id": "map2d.attach_dataset", "title": "挂载二维数据"},
      {"id": "map2d.load_hillshade", "title": "加载二维DEM"},
      {"id": "map2d.apply_look", "title": "二维外观预设"},
      {"id": "map2d.frame_fly", "title": "二维飞入"},
      {"id": "map2d.export_bmp", "title": "导出二维BMP"},
      {"id": "map2d.present_gpu", "title": "二维GPU呈现"},
      {"id": "map2d.add_standin_layer", "title": "二维占位多边形"}
    ]
  }
}
