import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("map2d_resources") {
  sources = [ "manifest/plugin.json" ]
  outputs = [ "$root_out_dir/plugins/map2d/{{source_file_part}}" ]
}

# Views-free compositor used by harness print present and chrome layout.
source_set("print_composer") {
  sources = [
    "print/composer/print_composer.cc",
    "print/composer/print_composer.h",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
}

source_set("map2d_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "print/register.cc",
    "print/register.h",
    "print/views/print_preview_dialog.cc",
    "print/views/print_preview_dialog.h",
    "seed/seed.cc",
    "seed/seed.h",
    "ops.cc",
    "ops.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    ":print_composer",
    "//src/content:browser_session",
    "//src/content:content",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:dispatch",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
  libs = [ "user32.lib" ]
  data_deps = [ ":map2d_resources" ]
}

# Contract checks used by map2d_gate_test. Kept off the native DLL object list
# so the basename does not collide with another gate.cc in the same target.
source_set("map2d_gate") {
  sources = [
    "gate.cc",
    "gate.h",
  ]
  include_dirs += [ "//src" ]
  deps = [ ":map2d_views" ]
}

native_plugin("map2d_native") {
  package = "map2d"
  entry = "dll_entry.cc"
  deps = [ ":map2d_views" ]
  data_deps = [ ":map2d_resources" ]
}

test("map2d_gate_test") {
  output_name = "map2d_gate_test"
  sources = [
    "gate.cc",
    "gate.h",
    "tests/gate_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":map2d_views",
    "//src/plugin/runtime/host:host",
    "//third_party/gn:dll_search",
  ]
  ldflags = [ "/ENTRY:mainCRTStartup", "/INCLUDE:__pfnDliNotifyHook2" ]
}

test("map2d_seed_test") {
  output_name = "map2d_seed_test"
  sources = [ "tests/seed_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":map2d_views" ]
}

test("map2d_sink_test") {
  output_name = "map2d_sink_test"
  sources = [ "tests/sink_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":map2d_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
  ]
}

test("print_composer_test") {
  output_name = "print_composer_test"
  sources = [ "print/composer/print_composer_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":print_composer" ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
}
