import("//build/smartgis.gni")
import("//testing/test.gni")

copy("self_test_resources") {
  sources = [ "manifest/plugin.json" ]
  outputs = [ "$root_out_dir/../plugins/self_test/{{source_file_part}}" ]
}

source_set("self_test_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "console_self_test.cc",
    "edit_m0.cc",
    "layers_m1.cc",
    "layout_bounds.cc",
    "milestones.cc",
    "navigate.cc",
    "present.cc",
    "probe.cc",
    "probe.h",
    "run.cc",
    "shell.h",
    "shell_ready.cc",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/base:base",
    "//src/content:content",
    "//src/content:debug_agent",
    "//src/content:embed_sample",
    "//src/content:browser_session",
    "//src/gis:gis",
    "//src/gis/edit:edit",
    "//src/gis/tile:tile",
    "//src/gpu:gpu_lib",
    "//src/net:net",
    "//src/plugin/product/print:print_views",
    "//src/plugin/runtime/host:host",
    "//src/render:rhi",
    "//src/tool:dispatch",
    "//src/tool:workspace",
    "//src/ui/gis:ui_gis",
    "//src/ui/views:views",
    "//third_party:gdal",
  ]
  libs = [ "user32.lib" ]
  data_deps = [ ":self_test_resources" ]
}

test("self_test_register_test") {
  output_name = "self_test_register_test"
  sources = [ "tests/register_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":self_test_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//src/tool:dispatch",
  ]
}
