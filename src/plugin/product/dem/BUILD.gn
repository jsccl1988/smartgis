import("//build/smartgis.gni")
import("//testing/test.gni")

# MFC-free XYZ→TIN and heightmap→grid kernels for dem_views (and legacy DLL).
source_set("dem_processing") {
  sources = [
    "processing/grid_loader.cc",
    "processing/grid_loader.h",
    "processing/tin_loader.cc",
    "processing/tin_loader.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  public_deps = [
    "//src/gis/kernel/geo:geo",
    "//third_party:gdal",
  ]
  deps = [
    "//src/gis/kernel/tin:tin",
    "//src/base:core",
    "//src/base/math:math",
  ]
}

source_set("dem_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "views/grid_loader_dialog.cc",
    "views/grid_loader_dialog.h",
    "views/tin_loader_dialog.cc",
    "views/tin_loader_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    ":dem_processing",
    "//src/gis/kernel/geo:geo",
    "//src/gis/kernel/tin:tin",
    "//src/base:core",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
}

test("dem_loader_test") {
  output_name = "dem_loader_test"
  sources = [ "tests/loader_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":dem_processing",
    ":dem_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    "//src/gis/kernel/tin:tin",
    "//src/gis/kernel/geo:geo",
    "//third_party:gdal_runtime_dlls",
  ]
}
