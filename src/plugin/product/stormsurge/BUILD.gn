import("//build/python.gni")
import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("stormsurge_levels_plugin") {
  sources = [
    "script/plugin.json",
    "script/plugin.py",
  ]
  outputs = [ "$root_out_dir/plugins/stormsurge_levels/{{source_file_part}}" ]
}

copy("stormsurge_levels_ext") {
  sources = [ "script/ext/__init__.py" ]
  outputs = [ "$root_out_dir/plugins/stormsurge_levels/ext/__init__.py" ]
}

copy("stormsurge_resources") {
  sources = [
    "manifest/plugin.json",
    "resources/run.ui.css",
    "resources/run.ui.xml",
    "resources/stormsurge.style.json",
  ]
  outputs = [ "$root_out_dir/plugins/stormsurge/{{source_file_part}}" ]
}

source_set("stormsurge_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "present/mask.cc",
    "present/mask.h",
    "present/water_mesh.cc",
    "present/water_mesh.h",
    "views/run_dialog.cc",
    "views/run_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/base:base",
    "//src/content:content",
    "//src/content:scene3d_present",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:tool",
    "//src/ui/views:views",
    "//src/vista:vista",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [ ":stormsurge_resources" ]
}

native_plugin("stormsurge_native") {
  package = "stormsurge"
  entry = "dll_entry.cc"
  deps = [ ":stormsurge_views" ]
  data_deps = [
    ":stormsurge_resources",
    ":stormsurge_levels_plugin",
    ":stormsurge_levels_ext",
  ]
}

test("stormsurge_run_test") {
  output_name = "stormsurge_run_test"
  sources = [
    "gate.cc",
    "gate.h",
    "tests/run_test.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":stormsurge_views",
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
    "//third_party/gn:dll_search",
  ]
  data_deps = [
    ":stormsurge_resources",
    "//third_party:gdal_runtime_dlls",
  ]
  ldflags = [ "/ENTRY:mainCRTStartup", "/INCLUDE:__pfnDliNotifyHook2" ]
}

test("stormsurge_level_curve_test") {
  output_name = "stormsurge_level_curve_test"
  sources = [ "tests/level_curve_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":stormsurge_views",
    "//src/base:base",
    "//src/content:content",
    "//src/content/browser/glang.runtime:cpython",
    "//src/gis:gis",
    "//src/plugin/runtime/extension:extension",
    "//src/plugin/runtime/host:host",
    "//src/ui/views:views",
    "//third_party:gdal",
    "//third_party:rapidjson",
    "//third_party/gn:dll_search",
  ]
  defines = [
    "STORMSURGE_LEVELS_DIR=\"" +
        rebase_path("//src/plugin/product/stormsurge/script") + "\"",
  ]
  data_deps = [
    ":stormsurge_resources",
    ":stormsurge_levels_plugin",
    ":stormsurge_levels_ext",
    "//third_party:gdal_runtime_dlls",
  ]
  if (python_enabled && python_dll != "") {
    data_deps += [
      "//src/plugin/runtime/extension:python312_dll",
      "//src/plugin/runtime/extension:python3_dll",
    ]
  }
  ldflags = [ "/ENTRY:mainCRTStartup", "/INCLUDE:__pfnDliNotifyHook2" ]
}
