import("//build/smartgis.gni")
import("//src/plugin/product/native_plugin.gni")
import("//testing/test.gni")

copy("stormsurge_resources") {
  sources = [
    "manifest/plugin.json",
    "resources/run.ui.css",
    "resources/run.ui.xml",
    "resources/stormsurge.style.json",
  ]
  outputs = [ "$root_out_dir/plugins/stormsurge/{{source_file_part}}" ]
}

source_set("stormsurge_views") {
  sources = [
    "commands.cc",
    "commands.h",
    "present/mask.cc",
    "present/mask.h",
    "present/water_mesh.cc",
    "present/water_mesh.h",
    "views/run_dialog.cc",
    "views/run_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/content:content",
    "//src/content:scene3d_present",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/widgets:widgets",
    "//src/tool:tool",
    "//src/ui/views:views",
    "//src/vista:vista",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [ ":stormsurge_resources" ]
}

native_plugin("stormsurge_native") {
  package = "stormsurge"
  entry = "dll_entry.cc"
  deps = [ ":stormsurge_views" ]
  data_deps = [ ":stormsurge_resources" ]
}

source_set("stormsurge_harness") {
  sources = [
    "scenario/interact.cc",
    "scenario/interact.h",
    "scenario/register.cc",
    "scenario/register.h",
    "scenario/run.cc",
    "scenario/run.h",
    "scenario/seed.cc",
    "scenario/seed.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    ":stormsurge_views",
    "//src/content:content",
    "//src/content:scene3d_present",
    "//src/plugin/product/world3d:world3d_harness",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
}

test("stormsurge_run_test") {
  output_name = "stormsurge_run_test"
  sources = [ "tests/run_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":stormsurge_views",
    "//src/content:content",
    "//src/gis:gis",
    "//src/plugin/runtime/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    ":stormsurge_resources",
    "//third_party:gdal_runtime_dlls",
  ]
}
