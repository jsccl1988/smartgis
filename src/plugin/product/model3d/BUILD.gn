import("//build/smartgis.gni")
import("//testing/test.gni")

source_set("model3d_views") {
  sources = [
    "commands.cc",
    "commands.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/content:content",
    "//src/plugin/runtime/host:host",
    "//src/ui/views:views",
    "//third_party:rapidjson",
  ]
}

test("model3d_scene_writer_test") {
  output_name = "model3d_scene_writer_test"
  sources = [ "tests/scene_writer_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":model3d_views",
    "//src/content:content",
    "//src/plugin/runtime/host:host",
  ]
}
