# Product builtin façade for horizon PluginShell. Owns the shipped plugin table
# so app/views never #include product commands.h.

import("//build/smartgis.gni")

source_set("product_builtins") {
  sources = [
    "builtins.cc",
    "builtins.h",
  ]
  include_dirs += [ "//src" ]
  public_deps = [
    "//src/plugin/runtime/host:host",
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/product/traffic:traffic_views",
    "//src/plugin/product/flood:flood_views",
    "//src/plugin/product/stormsurge:stormsurge_views",
    "//src/plugin/product/mine:mine_views",
    "//src/plugin/product/geochem:geochem_views",
    "//src/plugin/product/print:print_views",
    "//src/plugin/product/map2d:map2d_views",
    "//src/plugin/product/report:report_views",
    "//src/plugin/product/self_test:self_test_views",
  ]
  deps = [
    "//src/base:base",
    "//src/content:content",
  ]
}
