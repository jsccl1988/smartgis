# product_views: in-process source_sets for harness/unit tests that call
# register_* directly. Product shell discovers native DLLs via scan of
# $root_out_dir/plugins/<package>/ (product_native), not this link group.

import("//build/smartgis.gni")

group("product_views") {
  public_deps = [
    "//src/plugin/runtime/processing:processing_views",
    "//src/plugin/product/world3d:world3d_views",
    "//src/plugin/product/traffic:traffic_views",
    "//src/plugin/product/flood:flood_views",
    "//src/plugin/product/stormsurge:stormsurge_views",
    "//src/plugin/product/mine:mine_views",
    "//src/plugin/product/geochem:geochem_views",
    "//src/plugin/product/map2d:map2d_views",
    "//src/plugin/product/report:report_views",
  ]
}

group("product_native") {
  deps = [
    "//src/plugin/product/map2d:map2d_native",
    "//src/plugin/product/world3d:world3d_native",
    "//src/plugin/product/flood:flood_native",
    "//src/plugin/product/traffic:traffic_native",
    "//src/plugin/product/mine:mine_native",
    "//src/plugin/product/geochem:geochem_native",
    "//src/plugin/product/stormsurge:stormsurge_native",
    "//src/plugin/product/report:report_native",
  ]
}
