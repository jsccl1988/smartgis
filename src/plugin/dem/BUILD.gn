import("//build/smartgis.gni")
import("//testing/test.gni")

# MFC-free XYZ→TIN and heightmap→grid kernels for dem_views (and legacy DLL).
source_set("dem_loaders") {
  sources = [
    "grid_loader.h",
    "grid_loader_core.cc",
    "tin_loader.h",
    "tin_loader_core.cc",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  public_deps = [
    "//src/algorithm/geo:geo",
    "//third_party:gdal",
  ]
  deps = [
    "//src/algorithm/tin:tin",
    "//src/base:core",
    "//src/render/math:math",
  ]
}

source_set("dem_views") {
  sources = [
    "dem_commands.cc",
    "dem_commands.h",
    "grid_loader_dialog.cc",
    "grid_loader_dialog.h",
    "tin_loader_dialog.cc",
    "tin_loader_dialog.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    ":dem_loaders",
    "//src/algorithm/geo:geo",
    "//src/algorithm/tin:tin",
    "//src/base:core",
    "//src/content:content",
    "//src/plugin/host:host",
    "//src/plugin/widgets:widgets",
    "//src/ui/views:views",
    "//third_party:gdal",
  ]
}

test("dem_loader_test") {
  output_name = "dem_loader_test"
  sources = [ "dem_loader_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":dem_loaders",
    ":dem_views",
    "//src/content:content",
    "//src/plugin/host:host",
    "//third_party:gdal",
  ]
  data_deps = [
    "//src/algorithm/tin:tin",
    "//src/algorithm/geo:geo",
    "//third_party:gdal_runtime_dlls",
  ]
}
