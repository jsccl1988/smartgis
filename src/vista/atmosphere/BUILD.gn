# CPU atmosphere session (FieldStore / ingest / systems). Not a dep of
# atmosphere_sources: hosts project float* / AtmosphereParams themselves.
source_set("session_sources") {
  sources = [
    "session/atmosphere_params.h",
    "session/cloud_system.cc",
    "session/cloud_system.h",
    "session/environment.cc",
    "session/environment.h",
    "session/field_channel.h",
    "session/field_ingest.cc",
    "session/field_ingest.h",
    "session/field_store.cc",
    "session/field_store.h",
    "session/ocean_system.cc",
    "session/ocean_system.h",
    "session/procedural.cc",
    "session/procedural.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    "//src/vista/domain:domain_sources",
    "//src/vista/terrain:land_mask",
    "//src/base:foundation",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
  ]
}

