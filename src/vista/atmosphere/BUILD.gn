import("//build/smartgis.gni")
import("//testing/test.gni")

# Atmosphere GPU passes. Compiled into vista.dll.
# Headers sit with their .cc under ocean/ cloud/ sky/ fog/ common/ frame/.
# Shared raster/mesh/math is detail/.
# cpu_waves is atmosphere_cpu_sources. Session fields are session_sources.
# This GPU set must not depend on session_sources (that set pulls land_mask).
source_set("atmosphere_cpu_sources") {
  sources = [
    "ocean/cpu_waves.cc",
    "ocean/cpu_waves.h",
  ]
  include_dirs += [ "//src" ]
  assert_no_deps = [ "//src/render:render" ]
}

source_set("atmosphere_sources") {
  sources = [
    "cloud/cloud_pass.cc",
    "cloud/cloud_pass.h",
    "cloud/constants.h",
    "cloud/hlsl.h",
    "common/field_texture.cc",
    "common/field_texture.h",
    "fog/constants.h",
    "fog/fog_pass.cc",
    "fog/fog_pass.h",
    "fog/hlsl.h",
    "frame/atmosphere_effects.cc",
    "frame/atmosphere_effects.h",
    "frame/atmosphere_frame.cc",
    "frame/atmosphere_frame.h",
    "globe/constants.h",
    "globe/globe_pass.cc",
    "globe/globe_pass.h",
    "globe/hlsl.h",
    "globe/sat_cloud_pass.cc",
    "globe/sat_cloud_pass.h",
    "ocean/constants.h",
    "ocean/gpu_fields.cc",
    "ocean/gpu_fields.h",
    "ocean/hlsl.h",
    "ocean/ocean_pass.cc",
    "ocean/ocean_pass.h",
    "sky/constants.h",
    "sky/hlsl.h",
    "sky/sky_pass.cc",
    "sky/sky_pass.h",
  ]
  include_dirs += [ "//src" ]
  defines = [ "VISTA_EXPORTS" ]
  deps = [
    ":atmosphere_cpu_sources",
    "//src/render:render",
  ]
}

# In-process Null RHI smoke (RENDER_EXPORTS) to avoid LNK1168 on render.dll.
# rhi_sources objs dllimport base::log_write — must link //src/base:base.
test("cloud_pass_test") {
  output_name = "cloud_pass_test"
  sources = [
    "cloud/cloud_pass.cc",
    "cloud/cloud_pass_test.cc",
  ]
  include_dirs += [ "//src" ]
  defines = [
    "RENDER_EXPORTS",
    "VISTA_EXPORTS",
  ]
  deps = [
    "//src/base:base",
    "//src/render:rhi_sources",
  ]
}

