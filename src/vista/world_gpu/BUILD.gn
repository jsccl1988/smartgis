import("//build/smartgis.gni")
import("//testing/test.gni")

# GPU: GpuMesh upload / pipelines / record. Facade WorldPass.
# CPU sync, tess, cull, and index live in //src/vista/world:world_sources.
source_set("world_gpu_sources") {
  sources = [
    "cull/frustum_camera.cc",
    "cull/frustum_camera.h",
    "draw_pass.cc",
    "draw_pass.h",
    "gpu_mesh.h",
    "opaque_effect.cc",
    "opaque_effect.h",
    "pass.cc",
    "pass.h",
    "rebuild.cc",
    "scene_draw.cc",
    "tint.cc",
    "tint.h",
    "upload.cc",
    "upload.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [ "VISTA_EXPORTS" ]
  public_deps = [
    "//src/render:render",
    "//src/vista/world:world_sources",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gis:gis",
  ]
}

test("scene_gpu_test") {
  output_name = "scene_gpu_test"
  sources = [ "scene_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [ "//src/vista:vista" ]
}

test("unified_draw_test") {
  output_name = "unified_draw_test"
  sources = [ "unified_draw_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/vista:vista",
    "//src/base:base",
    "//src/gis:gis",
  ]
  if (smt_has_flycube) {
    defines = [ "SMT_HAS_FLYCUBE" ]
  }
}
