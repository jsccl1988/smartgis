import("//build/smartgis.gni")
import("//testing/benchmark.gni")
import("//testing/test.gni")

# DEM domain layers under dem/{raster,shade,mask,bake,nv,cache,contour,height}.
# No World type in these headers. Seed-into-World lives in
# //src/vista/component/world:world_sources (terrain/seed).

_thrust_gis_obj = "$root_out_dir/obj/vista_thrust_gis.cu.obj"
if (has_cuda) {
  action("thrust_gis_cu") {
    script = "//build/nvcc_obj.py"
    sources = [ "dem/nv/thrust_gis.cu" ]
    inputs = [
      "dem/nv/thrust_gis.h",
      "dem/nv/bake_pixel.h",
      "//build/nvcc_obj.py",
    ]
    outputs = [ _thrust_gis_obj ]
    args = [
      "--nvcc",
      cuda_home + "/bin/nvcc.exe",
      "--src",
      rebase_path("dem/nv/thrust_gis.cu", root_build_dir),
      "--out",
      rebase_path(_thrust_gis_obj, root_build_dir),
      "--include",
      rebase_path("//src", root_build_dir),
    ]
    if (is_debug) {
      args += [ "--debug" ]
    }
  }
} else {
  not_needed([ "_thrust_gis_obj" ])
}

source_set("land_mask") {
  sources = [
    "dem/mask/land_mask.cc",
    "dem/mask/land_mask.h",
    "dem/nv/thrust_gis.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/gis:gis",
  ]
  if (has_cuda) {
    deps += [ ":thrust_gis_cu" ]
    lib_dirs += [ cuda_home + "/lib/x64" ]
    libs = [ "cudart.lib" ]
    ldflags = [ rebase_path(_thrust_gis_obj, root_build_dir) ]
  } else {
    sources += [ "dem/nv/thrust_gis_stub.cc" ]
  }
}

# Isoline pipeline (msquares → chain/Chaikin → paint/mesh). Public face stays
# dem/dem_contour.h. Tests that avoid vista.dll link this source_set in-process.
source_set("dem_contour_sources") {
  sources = [
    "dem/contour/levels.cc",
    "dem/contour/levels.h",
    "dem/contour/mesh.cc",
    "dem/contour/mesh.h",
    "dem/contour/msquares.cc",
    "dem/contour/msquares.h",
    "dem/contour/paint.cc",
    "dem/contour/paint.h",
    "dem/contour/smooth.cc",
    "dem/contour/smooth.h",
    "dem/dem_contour.cc",
    "dem/dem_contour.h",
    "dem/dem_frame.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  deps = [
    ":land_mask",
    "//src/base:base",
    "//src/base/execution:execution",
  ]
}

# Disk IO + chunk pipeline for bake caches (no DemRaster link).
source_set("dem_cache_io_sources") {
  sources = [
    "dem/cache/io.cc",
    "dem/cache/io.h",
    "dem/cache/io_file_loader.h",
    "dem/cache/io_pipeline.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  deps = [
    "//src/base:base",
    "//src/base/execution:execution",
  ]
}

# Process + disk DEM bake caches. Public face: dem/dem_bake_cache.h.
source_set("dem_bake_cache_sources") {
  sources = [
    "dem/cache/hypso_cache.cc",
    "dem/cache/mesh_cache.cc",
    "dem/cache/phase.cc",
    "dem/cache/raster_cache.cc",
    "dem/cache/view_seed_cache.cc",
    "dem/dem_bake_cache.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  public_deps = [ ":dem_cache_io_sources" ]
  deps = [
    "//src/base:base",
  ]
}

# Real dem_bake blobs: Baseline vs Mapped+io_pipeline vs FileLoader.
benchmark("dem_io_benchmark") {
  output_name = "dem_io_benchmark"
  sources = [ "dem/cache/io_benchmark.cc" ]
  include_dirs += [ "//src" ]
  use_benchmark_main = false
  deps = [
    ":dem_cache_io_sources",
    "//src/base:base",
  ]
}

# AVX2-width lit / LOD / minmax via vir-simd. Separate TU so scalar files stay
# free of /arch:AVX2 (same pattern as map_multiply_avx2).
source_set("dem_shade_avx2") {
  sources = [
    "dem/detail/dem_simd.h",
    "dem/detail/dem_simd_avx2.cc",
    "dem/shade/lit_avx2.cc",
    "dem/shade/lit_kern.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  if (current_cpu == "x64" || current_cpu == "x86") {
    configs += [ "//src/base/math:math_simd_avx2" ]
  }
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  public_deps = [ "//src/base/simd:simd" ]
}

# Compiled into //src/vista:vista (dll_stem = vista).
source_set("terrain_sources") {
  sources = [
    "dem/bake/bake_backend.h",
    "dem/bake/bake_parallel.h",
    "dem/dem_frame.h",
    "dem/detail/dem_simd.cc",
    "dem/detail/dem_simd.h",
    "dem/height/dem_height_field.cc",
    "dem/height/dem_height_field.h",
    "dem/raster/bake_util.h",
    "dem/raster/dem_raster.h",
    "dem/raster/drape.cc",
    "dem/raster/grid.cc",
    "dem/raster/hypso.cc",
    "dem/raster/load.cc",
    "dem/raster/material.cc",
    "dem/raster/mesh.cc",
    "dem/raster/overlay.cc",
    "dem/raster/sample.cc",
    "dem/raster/synthetic.cc",
    "dem/raster/synthetic.h",
    "dem/shade/dem_hillshade.cc",
    "dem/shade/dem_hillshade.h",
    "dem/shade/lit_kern.h",
    "dem/shade/lit_dispatch.cc",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
    "//src/vista/component/world:world_sources",
  ]
  public_deps = [
    ":dem_bake_cache_sources",
    ":dem_contour_sources",
    ":dem_shade_avx2",
    ":land_mask",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
    "//src/base/execution:execution",
    "//src/gis:gis",
  ]
}

group("terrain") {
  public_deps = [ "//src/vista:vista" ]
}

