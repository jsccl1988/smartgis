# Dataset × scheme matrix: shade / mesh / hypso under serial|parallel ×
# scalar|simd|cuda. Writes captures/analysis/terrain_kernel/.
# Links terrain_sources in-process (not vista.dll) so the matrix can build
# while vista_d.dll is locked by a running shell.
test("dem_kernel_benchmark") {
  output_name = "dem_kernel_benchmark"
  sources = [ "dem/dem_kernel_benchmark.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":terrain_sources",
    "//src/base:base",
    "//src/base/execution:execution",
    "//src/gis:gis",
    "//third_party:gdal",
  ]
}
