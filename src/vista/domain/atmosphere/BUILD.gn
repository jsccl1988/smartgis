import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/vista:vista (dll_stem = vista).
# CPU atmosphere is flattened: FieldStore / ingest / systems share this dir.
source_set("atmosphere_sources") {
  sources = [
    "atmosphere_params.h",
    "cloud_system.cc",
    "cloud_system.h",
    "environment.cc",
    "environment.h",
    "field_channel.h",
    "field_ingest.cc",
    "field_ingest.h",
    "field_store.cc",
    "field_store.h",
    "ocean_system.cc",
    "ocean_system.h",
    "procedural.cc",
    "procedural.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
    "//src/legacy/render:*",
    "//src/legacy/ui:*",
    "//src/legacy/app:*",
  ]
  public_deps = [
    "//src/vista/domain:domain_sources",
    "//src/vista/world:land_mask",
    "//src/base:foundation",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
  ]
}

group("atmosphere") {
  public_deps = [ "//src/vista:vista" ]
}

# In-process VISTA_EXPORTS copies: LNK1168 on vista_d.dll is residual P4 debt.
test("field_store_test") {
  output_name = "field_store_test"
  sources = [
    "field_store.cc",
    "field_store_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "VISTA_EXPORTS" ]
  deps = [ "//src/base:base" ]
}

test("procedural_test") {
  output_name = "procedural_test"
  sources = [
    "field_store.cc",
