import("//build/smartgis.gni")
import("//testing/test.gni")

# CPU tessellation of GIS geometry into xyz + indices. No RHI, no World.
# Compiled into //src/vista:vista (dll_stem = vista).
#
# Layout by responsibility (one level under mesh/):
#   tessellate.*     — public API + dispatch
#   fill/            — polygon / ring fill tess
#   line/            — stroked ribbon tess
#   detail/          — types, append, scratch pools, process-trace

source_set("mesh_sources") {
  sources = [
    "detail/mesh_append.cc",
    "detail/mesh_append.h",
    "detail/mesh_scratch.cc",
    "detail/mesh_scratch.h",
    "detail/mesh_types.h",
    "detail/tess_trace.cc",
    "detail/tess_trace.h",
    "fill/fill_tess.cc",
    "fill/fill_tess.h",
    "line/line_tess.cc",
    "line/line_tess.h",
    "tessellate.cc",
    "tessellate.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
    "//src/vista/component/world:world_sources",
  ]
  public_deps = [
    "//src/gis:gis",
    "//third_party:gdal",
  ]
  deps = [ "//src/base:base" ]
}

group("mesh") {
  public_deps = [ "//src/vista:vista" ]
}

test("tessellate_style_test") {
  output_name = "tessellate_style_test"
  sources = [ "tessellate_style_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":mesh",
    "//src/base:base",
    "//third_party:gdal",
  ]
}
