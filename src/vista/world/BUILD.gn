import("//build/smartgis.gni")
import("//testing/test.gni")

# Logical node graph plus the adapters that write DEM / point buckets into it.
# Codecs live in //src/vista/assets. DEM math lives in //src/vista/terrain.
# CPU tessellation lives in //src/vista/mesh.

source_set("world_sources") {
  sources = [
    "coord.cc",
    "coord.h",
    "dem_seed.cc",
    "dem_seed.h",
    "pointcloud/chunk.cc",
    "pointcloud/chunk.h",
    "pointcloud/lod.cc",
    "pointcloud/lod.h",
    "world.cc",
    "world.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    "//src/vista/assets:assets_sources",
    "//src/vista/terrain:terrain_sources",
    "//src/base/math:math",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  deps = [
    "//src/gis:gis",
    "//src/base:base",
    "//src/base:core",
  ]
}

group("world") {
  public_deps = [ "//src/vista:vista" ]
}

test("world_test") {
  output_name = "world_test"
  sources = [ "world_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

test("pointcloud_test") {
  output_name = "pointcloud_test"
  sources = [ "pointcloud/pointcloud_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//third_party:gdal",
    "//third_party:laszip",
  ]
}
