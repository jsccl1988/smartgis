import("//build/smartgis.gni")
import("//testing/test.gni")

# Pure lon/lat ring tests — no VISTA_EXPORTS. Leftover DEM + Views both compile this in.
source_set("land_mask") {
  sources = [
    "terrain/process/land_mask.cc",
    "terrain/process/land_mask.h",
  ]
  include_dirs += [ "//src" ]
}

# Compiled into //src/vista:vista (dll_stem = vista).
source_set("world_sources") {
  sources = [
    "world.cc",
    "world.h",
    "pointcloud/process/chunk.cc",
    "pointcloud/process/chunk.h",
    "pointcloud/ingest/las_io.cc",
    "pointcloud/ingest/las_io.h",
    "pointcloud/ingest/laz_io.cc",
    "pointcloud/ingest/laz_io.h",
    "pointcloud/ingest/load.cc",
    "pointcloud/ingest/load.h",
    "pointcloud/process/lod.cc",
    "pointcloud/process/lod.h",
    "pointcloud/point_cloud.cc",
    "pointcloud/point_cloud.h",
    "pointcloud/ingest/pdal_io.h",
    "pointcloud/ingest/text_io.cc",
    "pointcloud/ingest/text_io.h",
    "terrain/dem/dem_frame.h",
    "terrain/process/dem_hillshade.cc",
    "terrain/process/dem_hillshade.h",
    "terrain/dem/dem_bake_cache.cc",
    "terrain/dem/dem_bake_cache.h",
    "terrain/dem/dem_raster.cc",
    "terrain/dem/dem_raster.h",
    # Former legacy/gis/vista adapters (product path; scenic/leftover include these).
    "coord.cc",
    "coord.h",
    "terrain/dem/dem_height_field.cc",
    "terrain/dem/dem_height_field.h",
    "terrain/dem/dem_to_world.cc",
    "terrain/dem/dem_to_world.h",
    "terrain/mesh/fill_tess.cc",
    "terrain/mesh/fill_tess.h",
    "terrain/mesh/line_tess.cc",
    "terrain/mesh/line_tess.h",
    "terrain/mesh/mesh_append.cc",
    "terrain/mesh/mesh_append.h",
    "terrain/mesh/mesh_scratch.cc",
    "terrain/mesh/mesh_scratch.h",
    "terrain/mesh/mesh_types.h",
    "terrain/mesh/tess_trace.cc",
    "terrain/mesh/tess_trace.h",
    "terrain/mesh/tessellate.cc",
    "terrain/mesh/tessellate.h",
  ]
  if (smt_has_pdal) {
    sources += [ "pointcloud/ingest/pdal_io.cc" ]
  } else {
    sources += [ "pointcloud/ingest/pdal_io_stub.cc" ]
  }
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
    "//src/legacy/render:*",
    "//src/legacy/ui:*",
    "//src/legacy/app:*",
  ]
  public_deps = [
    "//src/vista/assets:assets_sources",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  deps = [
    ":land_mask",
    "//src/gis:gis",
    "//src/base:base",
    "//src/base:core",
    "//third_party:laszip",
  ]
  if (smt_has_pdal) {
    deps += [ "//third_party:pdal" ]
  }
}

group("world") {
  public_deps = [ "//src/vista:vista" ]
}

test("world_test") {
  output_name = "world_test"
  sources = [ "world_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

