import("//build/smartgis.gni")
import("//testing/test.gni")

# Map GPU pass. Compiled into vista.dll. Effect vtable stays in frame_graph.h.
source_set("map_sources") {
  sources = [
    "detail/atlas.cc",
    "detail/atlas.h",
    "detail/color.h",
    "detail/encode.cc",
    "detail/encode.h",
    "detail/place.cc",
    "detail/place.h",
    "detail/upload.cc",
    "detail/upload.h",
    "glyph_windows.cc",
    "map_effect.cc",
    "map_effect.h",
    "pass.cc",
    "pass.h",
  ]
  include_dirs += [ "//src" ]
  defines = [ "VISTA_EXPORTS" ]
  deps = [
    "//src/base:base",
    "//src/base:foundation",
    "//src/gis:gis",
    "//src/render:render",
    "//src/vista/frame:frame_sources",
  ]
  libs = [ "gdiplus.lib" ]
}

# In-process Null RHI smoke. Compiles the pass here (RENDER_EXPORTS) so the
# test does not load render.dll. The stub rasterizer needs no window; GDI+
# is linked because the WindowsGlyphRasterizer vtable lives in this binary.
test("map_effect_test") {
  output_name = "map2d_pass_test"
  sources = [
    "detail/atlas.cc",
    "detail/encode.cc",
    "detail/place.cc",
    "detail/upload.cc",
    "../frame/detail/layout/multiply.cc",
    "glyph_windows.cc",
    "pass.cc",
    "pass_test.cc",
  ]
  include_dirs += [ "//src" ]
  defines = [
    "RENDER_EXPORTS",
    "VISTA_EXPORTS",
  ]
  libs = [ "gdiplus.lib" ]
  deps = [
    "//src/base:base",
    "//src/base:foundation",
    "//src/gis:gis",
    "//src/render:programs_sources",
    "//src/render:rhi_sources",
  ]
}
