# Product vista layer — CPU MapIR / World / atmosphere session + GPU
# MapPass / WorldPass / atmosphere_pass passes. One DLL (dll_stem = vista).
# May depend on gis.dll. gis.dll must not depend on this target.
# Layout lock: docs/superpowers/specs/2026-09-13-render-rhi-scene-design.md
# §Vista subdirectory tighten. README: src/vista/README.md.

import("//build/smartgis.gni")

product_shared_library("vista") {
  dll_stem = "vista"
  defines = [ "VISTA_EXPORTS" ]
  deps = [
    "//src/vista/assets:assets_sources",
    "//src/vista/component/world:atmosphere_cpu_sources",
    "//src/vista/component/world:session_sources",
    "//src/vista/pass/world/atmosphere:atmosphere_pass_sources",
    "//src/vista/domain:domain_sources",
    "//src/vista/component/map:map_sources",
    "//src/vista/pass/map:map_pass_sources",
    "//src/vista/mesh:mesh_sources",
    "//src/vista/pass/world:world_pass_sources",
    "//src/vista/terrain:terrain_sources",
    "//src/vista/component/world:world_sources",
  ]
  public_deps = [
    "//src/base:base",
    "//src/gis:gis",
    "//src/render:render",
    "//third_party:gdal",
  ]
  libs = [ "gdiplus.lib" ]
}

group("vista_test_all") {
  testonly = true
  deps = [
    "//src/vista/assets:model_test",
    "//src/vista/assets:pdal_io_test",
    "//src/vista/assets:tileset_test",
    "//src/vista/pass/world/atmosphere:atmosphere_frame_test",
    "//src/vista/pass/world/atmosphere:cloud_pass_test",
    "//src/vista/pass/world/atmosphere:fog_pass_test",
    "//src/vista/pass/world/atmosphere:globe_pass_test",
    "//src/vista/pass/world/atmosphere:ocean_pass_test",
    "//src/vista/pass/world/atmosphere:sky_pass_test",
    "//src/vista/component/world:cloud_system_test",
    "//src/vista/component/world:contour_sheet_test",
    "//src/vista/component/world:environment_test",
    "//src/vista/component/world:field_ingest_test",
    "//src/vista/component/world:field_store_test",
    "//src/vista/component/world:ocean_system_test",
    "//src/vista/component/world:procedural_test",
    "//src/vista/pass/map:map_effect_test",
    "//src/vista/component/map:frame_test",
    "//src/vista/mesh:tessellate_style_test",
    "//src/vista/pass/world:scene_gpu_test",
    "//src/vista/pass/world:terrain_pass_test",
    "//src/vista/pass/world:unified_draw_test",
    "//src/vista/terrain:dem_raster_test",
    "//src/vista/terrain:land_mask_test",
    "//src/vista/component/world:pointcloud_test",
    "//src/vista/component/world:seed_tin_test",
    "//src/vista/component/world:world_test",
  ]
}
