import("//build/smartgis.gni")
import("//testing/test.gni")

# Atmosphere GPU passes. Compiled into vista.dll.
# Public facade at the module root (AtmosphereFrame / effects).
# Per-kind recorders under ocean/ cloud/ sky/ fog/ globe/.
# Shared raster/mesh/field_texture is detail/.
# CPU math is vista/component/atmosphere/detail/math.h.
# Depends on atmosphere_cpu_sources (cpu_waves). Must not depend on
# session_sources (that set pulls land_mask).

source_set("atmosphere_pass_sources") {
  sources = [
    "atmosphere_effects.cc",
    "atmosphere_effects.h",
    "atmosphere_frame.cc",
    "atmosphere_frame.h",
    "cloud/cloud_pass.cc",
    "cloud/cloud_pass.h",
    "cloud/constants.h",
    "cloud/hlsl.h",
    "detail/field_texture.cc",
    "detail/field_texture.h",
    "detail/mesh.h",
    "detail/raster.h",
    "fog/constants.h",
    "fog/fog_pass.cc",
    "fog/fog_pass.h",
    "fog/hlsl.h",
    "globe/constants.h",
    "globe/globe_pass.cc",
    "globe/globe_pass.h",
    "globe/hlsl.h",
    "globe/sat_cloud_pass.cc",
    "globe/sat_cloud_pass.h",
    "ocean/constants.h",
    "ocean/gpu_fields.cc",
    "ocean/gpu_fields.h",
    "ocean/hlsl.h",
    "ocean/ocean_pass.cc",
    "ocean/ocean_pass.h",
    "sky/constants.h",
    "sky/hlsl.h",
    "sky/sky_pass.cc",
    "sky/sky_pass.h",
  ]
  include_dirs += [ "//src" ]
  defines = [ "VISTA_EXPORTS" ]
  deps = [
    "//src/vista/component/atmosphere:atmosphere_cpu_sources",
    "//src/render:render",
  ]
}

# In-process Null RHI smoke (RENDER_EXPORTS) to avoid LNK1168 on render.dll.
# rhi_sources objs dllimport base::log_write — must link //src/base:base.
test("cloud_pass_test") {
  output_name = "cloud_pass_test"
  sources = [
    "cloud/cloud_pass.cc",
    "cloud/cloud_pass_test.cc",
  ]
  include_dirs += [ "//src" ]
  defines = [
    "RENDER_EXPORTS",
    "VISTA_EXPORTS",
  ]
  deps = [
    "//src/base:base",
    "//src/render:rhi_sources",
  ]
}

test("ocean_pass_test") {
  output_name = "ocean_pass_test"
  sources = [
    "detail/field_texture.cc",
