import("//build/smartgis.gni")
import("//testing/benchmark.gni")
import("//testing/test.gni")

# CPU Layout → MapIR. place has no RHI and compiles here.
# Ortho is the current camera; perspective uses the same Layout.
# Compiled into //src/vista:vista. Not a second scene.
source_set("map_sources") {
  sources = [
    "batch.cc",
    "batch.h",
    "carto/filter.cc",
    "carto/filter.h",
    "carto/resolve.cc",
    "carto/resolve.h",
    "carto/style.cc",
    "carto/collision.cc",
    "carto/collision.h",
    "color.h",
    "draw.h",
    "ir.h",
    "mvt/mvt.cc",
    "mvt/mvt.h",
    "place/place.cc",
    "place/place.h",
    "shade/attach.cc",
    "shade/attach.h",
    "shade/bake.cc",
    "shade/bake.h",
    "tile/math.cc",
    "tile/math.h",
    "layout.cc",
    "layout.h",
    "layout/geom/attrs.cc",
    "layout/geom/attrs.h",
    "layout/geom/clip.cc",
    "layout/geom/clip.h",
    "layout/geom/geom_walk.cc",
    "layout/geom/geom_walk.h",
    "layout/geom/mesh_emit.cc",
    "layout/geom/mesh_emit.h",
    "layout/paint/fill.cc",
    "layout/paint/fill.h",
    "layout/paint/line.cc",
    "layout/paint/line.h",
    "layout/paint/point.cc",
    "layout/paint/point.h",
    "layout/paint/raster.cc",
    "layout/paint/raster.h",
    "layout/paint/source_index.h",
    "layout/paint/symbol.cc",
    "layout/paint/symbol.h",
    "layout/paint/tess_jobs.h",
    "layout/policy/gen.h",
    "layout/policy/slice_key.h",
    "layout/policy/tess_grain.h",
    "layout/policy/view_metrics.cc",
    "layout/policy/view_metrics.h",
    "layout/stage/coalesce.cc",
    "layout/stage/coalesce.h",
    "layout/stage/collect.cc",
    "layout/stage/collect.h",
    "layout/stage/emit.cc",
    "layout/stage/emit.h",
    "layout/stage/pack.cc",
    "layout/stage/pack.h",
    "view.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    ":map_multiply",
  ]
  deps = [
    "//src/base:foundation",
    "//src/base:base",
    "//src/gis:gis",
    "//src/vista/mesh:mesh_sources",
    "//src/vista/terrain:terrain_sources",
  ]
}

# AVX2 lives in its own TU so the scalar file is not compiled with /arch:AVX2.
# Runtime CPUID in shade/multiply.cc skips the kernel when YMM is unavailable.
source_set("map_multiply") {
  sources = [
    "shade/multiply.cc",
    "shade/multiply.h",
    "shade/multiply_kern.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  public_deps = [ ":map_multiply_avx2" ]
}

source_set("map_multiply_avx2") {
  sources = [ "shade/multiply_avx2.cc" ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  if (current_cpu == "x64" || current_cpu == "x86") {
    configs += [ "//src/base/math:math_simd_avx2" ]
  }
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  public_deps = [ "//src/base/simd:simd" ]
}

# Scalar vs AVX2 vs public dispatch. Kernel time only (memcpy is paused).
benchmark("multiply_benchmark") {
  output_name = "multiply_benchmark"
  sources = [ "shade/multiply_benchmark.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  use_benchmark_main = false
  deps = [
    ":map_multiply",
    ":map_multiply_avx2",
  ]
}

group("map") {
  public_deps = [ "//src/vista:vista" ]
}

test("frame_test") {
  output_name = "frame_test"
  sources = [ "map2d_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":map",
    "//src/base:base",
    "//third_party:gdal",
  ]
}
