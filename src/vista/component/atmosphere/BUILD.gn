import("//build/smartgis.gni")
import("//testing/test.gni")

# CPU atmosphere IR. Public facade at the module root. Field store, ocean
# system, and cloud system sit one responsibility level down.
# cpu_waves is a small set GPU ocean may consume without pulling land_mask.
# assert_no_deps render. GPU recorders live in //src/vista/pass/atmosphere.

source_set("atmosphere_cpu_sources") {
  sources = [
    "detail/math.h",
    "ocean/cpu_waves.cc",
    "ocean/cpu_waves.h",
  ]
  include_dirs += [ "//src" ]
  assert_no_deps = [ "//src/render:render" ]
}

source_set("session_sources") {
  sources = [
    "atmosphere_params.h",
    "cloud/cloud_system.cc",
    "cloud/cloud_system.h",
    "contour/contour_color_scale.cc",
    "contour/contour_color_scale.h",
    "contour/contour_sheet.cc",
    "contour/contour_sheet.h",
    "environment.cc",
    "environment.h",
    "field/field_channel.h",
    "field/field_ingest.cc",
    "field/field_ingest.h",
    "field/field_store.cc",
    "field/field_store.h",
    "field/procedural.cc",
    "field/procedural.h",
    "ocean/ocean_system.cc",
    "ocean/ocean_system.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    "//src/vista/domain:domain_sources",
    "//src/vista/terrain:land_mask",
    "//src/base:foundation",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
    # ContourSheet uses dem_contour (compiled into vista.dll terrain_sources).
    "//src/vista/terrain:terrain_sources",
  ]
}

# In-process VISTA_EXPORTS copies: LNK1168 on vista_d.dll is residual P4 debt.
test("field_store_test") {
  output_name = "field_store_test"
  sources = [
    "field/field_store.cc",
    "field/field_store_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "VISTA_EXPORTS" ]
  deps = [ "//src/base:base" ]
}

