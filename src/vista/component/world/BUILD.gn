import("//build/smartgis.gni")
import("//testing/test.gni")

# Node graph plus CPU instance sync, tessellation, cull, and the spatial index.
# Codecs live in //src/vista/assets. DEM math lives in //src/vista/terrain.
# Generic geometry tessellation lives in //src/vista/mesh.
# Device upload is //src/vista/pass/world. This target assert_no_deps render.

# Separate set: same basename as terrain/lod.cc → MSVC lod.obj collision in one
# source_set (GN Duplicate object file).
source_set("world_pointcloud_lod") {
  sources = [
    "pointcloud/point_lod.cc",
    "pointcloud/point_lod.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  public_deps = [
    "//src/vista/terrain:terrain_sources",
    "//src/base:base",
    "//third_party:octree",
  ]
}

source_set("world_sources") {
  sources = [
    "coord.cc",
    "coord.h",
    "pointcloud/chunk.cc",
    "pointcloud/chunk.h",
    "terrain/lod.cc",
    "terrain/lod.h",
    "terrain/payload.h",
    "terrain/seed.cc",
    "terrain/seed.h",
    "cull/frustum_aabb.cc",
    "cull/frustum_aabb.h",
    "cull/mesh_cull.h",
    "cull/prep_cull.cc",
    "cull/prep_cull.h",
    "envelope.cc",
    "envelope.h",
    "index/aabb_octree.cc",
    "index/aabb_octree.h",
    "instance.h",
    "kind_tess.cc",
    "kind_tess.h",
    "paint.cc",
    "paint.h",
    "pipelines.cc",
    "pipelines.h",
    "sync.cc",
    "sync.h",
    "tessellate.cc",
    "tessellate.h",
    "world.cc",
    "world.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    ":world_pointcloud_lod",
    "//src/vista/assets:assets_sources",
    "//src/vista/mesh:mesh_sources",
    "//src/vista/terrain:terrain_sources",
    "//src/base/math:math",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  deps = [
    "//src/base/execution:execution",
    "//src/gis:gis",
    "//src/base:base",
    "//src/base:core",
  ]
}

group("world") {
  public_deps = [ "//src/vista:vista" ]
}

test("world_test") {
  output_name = "world_test"
  sources = [ "world_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

test("pointcloud_test") {
  output_name = "pointcloud_test"
  sources = [ "pointcloud/pointcloud_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//third_party:gdal",
    "//third_party:laszip",
  ]
}
