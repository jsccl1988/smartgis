import("//build/smartgis.gni")
import("//testing/test.gni")

# Node graph plus CPU instance sync, tessellation, cull, and the spatial index.
# Codecs live in //src/vista/assets. DEM math lives in //src/vista/terrain.
# Generic geometry tessellation lives in //src/vista/mesh.
# Device upload is //src/vista/pass/world. This target assert_no_deps render.

source_set("world_sources") {
  sources = [
    "instance.h",
    "instance/kind.cc",
    "instance/kind.h",
    "instance/paint.cc",
    "instance/paint.h",
    "instance/pipelines.cc",
    "instance/pipelines.h",
    "instance/sync.cc",
    "instance/sync.h",
    "instance/tessellate.cc",
    "instance/tessellate.h",
    "pointcloud/chunk.cc",
    "pointcloud/chunk.h",
    "pointcloud/point_lod.cc",
    "pointcloud/point_lod.h",
    "space/coord.cc",
    "space/coord.h",
    "space/cull/frustum_aabb.cc",
    "space/cull/frustum_aabb.h",
    "space/cull/mesh_cull.h",
    "space/cull/prep_cull.cc",
    "space/cull/prep_cull.h",
    "space/envelope.cc",
    "space/envelope.h",
    "space/index/aabb_octree.cc",
    "space/index/aabb_octree.h",
    "terrain/grid.cc",
    "terrain/grid.h",
    "terrain/mesh.cc",
    "terrain/mesh.h",
    "terrain/nested.cc",
    "terrain/payload.h",
    "terrain/policy.cc",
    "terrain/policy.h",
    "terrain/raster.cc",
    "terrain/seed.h",
    "terrain/surface.cc",
    "terrain/tin.cc",
    "world.cc",
    "world.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "VISTA_EXPORTS",
  ]
  assert_no_deps = [
    "//src/render:render",
  ]
  public_deps = [
    "//src/vista/assets:assets_sources",
    "//src/vista/mesh:mesh_sources",
    "//src/vista/terrain:terrain_sources",
    "//src/base/math:math",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  deps = [
    "//src/base/execution:execution",
    "//src/gis:gis",
    "//src/base:base",
    "//src/base:core",
  ]
}

group("world") {
  public_deps = [ "//src/vista:vista" ]
}

test("world_test") {
  output_name = "world_test"
  sources = [ "world_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

test("seed_tin_test") {
  output_name = "seed_tin_test"
  sources = [ "terrain/seed_tin_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

test("pointcloud_test") {
  output_name = "pointcloud_test"
  sources = [ "pointcloud/pointcloud_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//third_party:gdal",
    "//third_party:laszip",
  ]
}
