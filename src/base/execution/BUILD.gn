  public_configs = [
    ":execution_config",
    "//src/base:foundation_config",
  ]
  public_deps = [
    "//src/base/concurrency:concurrency",
    "//src/base/synchronization:synchronization",
    "//src/base/trace:trace",
  ]
}

test("execution_test") {
  output_name = "execution_test"
  sources = [ "execution_test.cc" ]
  deps = [ ":execution" ]
}
