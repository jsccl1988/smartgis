import("//build/smartgis.gni")
import("//testing/test.gni")

declare_args() {
  # Optional float32 AVX2 batch path in base/math. Default: scalar.
  base_math_simd = false
}

# Scene math layers (namespace `base`). Temporary `render::` aliases remain
# in headers for leftover call sites. Source sets do not join base.dll.
# Do not add this directory itself to include_dirs: a local math.h would
# shadow the system <math.h> and break Eigen / <cmath> on MSVC.
# Do not depend on rhi, programs, graph, effect, or gis.
config("math_headers") {
  include_dirs += [ "//src" ]
}

config("math_simd_avx2") {
  defines = [ "BASE_MATH_SIMD=1" ]
  if (is_win) {
    cflags = [ "/arch:AVX2" ]
  } else {
    cflags = [ "-mavx2" ]
  }
}

# scalar + linear + traits + xform + simd entry. Header-only Eigen adapters.
source_set("linear") {
  public_configs = [ ":math_headers" ]
  public_deps = [ "//third_party:eigen" ]
  sources = [
    "detail/eigen.h",
    "linear/affine2.h",
    "linear/matrix.h",
    "linear/matrix4.h",
    "linear/point.h",
    "linear/quat.h",
    "linear/vector.h",
    "scalar/constants.h",
    "traits/vector_traits.h",
    "xform/interpolate.h",
    "xform/transform.h",
    "xform/transform_stack.h",
  ]
}

# Oriented / axis-aligned boxes, planes, rays, frustum.
source_set("bounds") {
  sources = [
    "geom/aabb.cpp",
    "geom/aabb.h",
    "geom/cull.h",
    "geom/frustum.cpp",
    "geom/frustum.h",
    "geom/obb.cpp",
    "geom/obb.h",
    "geom/plane.cpp",
    "geom/plane.h",
    "geom/ray.cpp",
    "geom/ray.h",
  ]
  public_deps = [ ":linear" ]
}

# Public facade: linear + bounds + optional SIMD TU.
source_set("math") {
  public_configs = [ ":math_headers" ]
  public_deps = [
    ":bounds",
    ":linear",
  ]
  sources = [
    "math.h",
    "simd/simd.cc",
    "simd/simd.h",
  ]
  if (base_math_simd) {
    configs += [ ":math_simd_avx2" ]
  }
}

test("math_test") {
  output_name = "math_test"
  sources = [ "math_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":math" ]
}
