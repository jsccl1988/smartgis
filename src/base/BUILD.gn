import("//build/smartgis.gni")

# Foundation (mogu-aligned, mostly header-only) + product base DLL.
# Disk stem matches the src/ top-level tree: base → base.dll / base_d.dll.
# #include "base/..." resolves via //src (see BUILDCONFIG / //build:legacy).

config("foundation_config") {
  # Append; do not replace BUILDCONFIG / legacy include_dirs.
  include_dirs += [ "//src" ]
}

# Header-only foundation aggregate (core/threading/util/files/memory/time +
# archive/ipc). Not a product DLL — statically linked into consumers.
source_set("foundation") {
  sources = [
    "core/build_config.h",
    "core/debug.h",
    "core/export.h",
    "core/log.h",
    "core/macros.h",
    "threading/thread.h",
    "util/path.h",
    "util/library.h",
    "util/plugin.h",
    "files/read_file.h",
    "memory/object_pool.h",
    "time/elapsed_timer.h",
    "time/frame_timer.h",
  ]
  public_configs = [ ":foundation_config" ]
  public_deps = [
    "//src/base/archive:archive",
    "//src/base/ipc:ipc",
  ]
}

group("core") {
  public_deps = [ ":base" ]
}

# //src/base/math:{math,bounds} stay separate source_sets, outside this DLL.
smt_shared_library("base") {
  dll_stem = "base"
  defines = [ "BASE_EXPORTS" ]
  deps = [
    ":foundation",
    "//src/base/carto:carto_sources",
    "//src/legacy/core:core_sources",
    "//src/legacy/xml:xml_sources",
    "//src/legacy/sys:sys_sources",
  ]
  public_deps = [ "//src/base/archive:archive" ]
}

# Legacy GN label; same DLL as :base (disk stem is base, not platform).
group("platform") {
  public_deps = [ ":base" ]
}

# Optional aggregator (foundation + base DLL).
group("base_all") {
  public_deps = [
    ":foundation",
    ":base",
  ]
}
