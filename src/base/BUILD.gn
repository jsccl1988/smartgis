import("//build/smartgis.gni")

# One layer directory, four modules (mogu base/* layout under //src):
#   core/     core DLL — BUILD in core/; this file re-exports //src/base:core
#   style/    style DLL — cartographic pen/brush/symbol + Envelope (not Views/CSS)
#   archive/  header-only BinarySink / archive() (mogu base/archive subset)
#   ipc/      named pipe + codec (source_set, not a DLL; chrome must not include it)

# Stable label for dependents. Real target: //src/base/core:core.
group("core") {
  public_deps = [ "//src/base/core:core" ]
}

smt_shared_library("base") {
  dll_stem = "style"
  defines = [ "STYLE_EXPORTS=1" ]
  sources = [
    "style/style_api.cpp",
    "style/envelope.cpp",
    "style/style.cpp",
    "style/stylemanager.cpp",
    "style/styletable.cpp",
  ]
  public_deps = [ ":core" ]
}

# Optional aggregator (foundation modules under this layer).
group("base_all") {
  public_deps = [
    ":core",
    ":base",
    "//src/base/archive:archive",
    "//src/base/ipc:ipc",
  ]
}
