import("//build/smartgis.gni")

# Foundation layer → one DLL (dll_stem = base):
#   core/ + style/ + //src/sys + //src/net source_sets
#   archive/ + ipc/ remain source_sets chained into this DLL
# Stable labels //src/base:core, :base, //src/sys:sys, //src/net:net → group to :base.

group("core") {
  public_deps = [ ":base" ]
}

source_set("style_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "STYLE_EXPORTS=1",
  ]
  sources = [
    "style/style_api.cpp",
    "style/envelope.cpp",
    "style/style.cpp",
    "style/stylemanager.cpp",
    "style/styletable.cpp",
  ]
}

smt_shared_library("base") {
  dll_stem = "base"
  defines = [
    "BASE_EXPORTS",
    "CORE_EXPORTS=1",
    "STYLE_EXPORTS=1",
    "SYS_EXPORTS=1",
    "NET_EXPORTS",
  ]
  deps = [
    "//src/base/core:core_sources",
    ":style_sources",
    "//src/sys:sys_sources",
    "//src/net:net_sources",
    "//src/base/ipc:ipc_sources",
  ]
  public_deps = [
    "//src/base/archive:archive",
    "//third_party:asio",
    "//third_party:cpp_httplib",
  ]
  libs = [ "ws2_32.lib" ]
}

# Optional aggregator (foundation modules under this layer).
group("base_all") {
  public_deps = [ ":base" ]
}
