import("//build/smartgis.gni")

# Foundation (mogu-aligned, mostly header-only) + product platform DLL.
# Disk stem for the shared library: platform → platform.dll / platform_d.dll.
# #include "base/..." resolves via //src (see BUILDCONFIG / //build:legacy).

config("foundation_config") {
  # Append; do not replace BUILDCONFIG / legacy include_dirs.
  include_dirs += [ "//src" ]
}

# Header-only foundation aggregate (core/threading/util/files/memory/time +
# archive/ipc). Not a product DLL — statically linked into consumers.
source_set("foundation") {
  sources = [
    "core/build_config.h",
    "core/debug.h",
    "core/export.h",
    "core/log.h",
    "core/macros.h",
    "threading/thread.h",
    "util/path.h",
    "util/library.h",
    "util/plugin.h",
    "files/read_file.h",
    "memory/object_pool.h",
    "time/elapsed_timer.h",
    "time/frame_timer.h",
  ]
  public_configs = [ ":foundation_config" ]
  public_deps = [
    "//src/base/archive:archive",
    "//src/base/ipc:ipc",
  ]
}

group("core") {
  public_deps = [ ":base" ]
}

smt_shared_library("base") {
  dll_stem = "platform"
  defines = [
    "BASE_EXPORTS",
    "CORE_EXPORTS=1",
    "STYLE_EXPORTS=1",
    "SYS_EXPORTS=1",
    "NET_EXPORTS",
  ]
  deps = [
    ":foundation",
    "//src/base/core:core_sources",
    "//src/base/carto:carto_sources",
    "//src/legacy/xml:xml_sources",
    "//src/sys:sys_sources",
    "//src/net:net_sources",
  ]
  public_deps = [
    "//src/base/archive:archive",
    "//third_party:asio",
    "//third_party:cpp_httplib",
  ]
  libs = [ "ws2_32.lib" ]
}

# Alias for the disk stem name (same DLL as :base).
group("platform") {
  public_deps = [ ":base" ]
}

# Optional aggregator (foundation + platform DLL).
group("base_all") {
  public_deps = [
    ":foundation",
    ":base",
  ]
}
