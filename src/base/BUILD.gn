import("//build/smartgis.gni")

# Foundation (mogu-aligned, mostly header-only) + product base DLL.
# Disk stem matches the src/ top-level tree: base → base.dll / base_d.dll.
# #include "base/..." resolves via //src (see BUILDCONFIG / //build:legacy).

config("foundation_config") {
  # Append; do not replace BUILDCONFIG / legacy include_dirs.
  include_dirs += [ "//src" ]
}

# Header-only foundation aggregate (core/threading/util/files/memory/time +
# archive/ipc). Not a product DLL — statically linked into consumers.
source_set("foundation") {
  sources = [
    "core/build_config.h",
    "core/debug.h",
    "core/export.h",
    "core/log.h",
    "core/macros.h",
    "threading/thread.h",
    "util/path.h",
    "util/library.h",
    "util/plugin.h",
    "files/read_file.h",
    "time/elapsed_timer.h",
    "time/frame_timer.h",
    "util/type_utils.h",
    "tuple/tuple.h",
    "tuple/algorithm.h",
    # Memory / concurrency / sync / trace live in dedicated source_sets.
  ]
  public_configs = [ ":foundation_config" ]
  public_deps = [
    "//src/base/archive:archive",
    "//src/base/concurrency:concurrency",
    "//src/base/execution:execution",
    "//src/base/ipc:ipc",
    "//src/base/log:log",
    "//src/base/memory:memory",
    "//src/base/synchronization:synchronization",
    "//src/base/trace:trace",
  ]
}

group("core") {
  public_deps = [ ":base" ]
}

# Process-wide CLI switches (compiled into base.dll).
source_set("process_switches_sources") {
  sources = [
    "process/switches.cc",
    "process/switches.h",
  ]
  defines = [ "BASE_EXPORTS" ]
  public_configs = [ ":foundation_config" ]
}

# //src/base/math:{math,bounds} stay separate source_sets, outside this DLL.
product_shared_library("base") {
  dll_stem = "base"
  defines = [ "BASE_EXPORTS" ]
  deps = [
    ":foundation",
    ":process_switches_sources",
    "//src/base/log:log_sources",
    "//src/base/trace:process_trace_sources",
  ]
  public_deps = [
    ":process_switches_sources",
    "//src/base/archive:archive",
    "//src/base/log:log",
    "//src/base/trace:trace",
  ]
}

# Legacy GN label; same DLL as :base (disk stem is base, not platform).
group("platform") {
  public_deps = [ ":base" ]
}

# Optional aggregator (foundation + base DLL).
group("base_all") {
  public_deps = [
    ":foundation",
    ":base",
  ]
}
