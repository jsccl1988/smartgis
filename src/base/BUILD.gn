import("//build/smartgis.gni")

# One layer directory, three modules:
#   core/  core DLL (threads, log, plugin LoadLibrary, xml, …)
#   style/ style DLL — cartographic pen/brush/symbol + Envelope (not Views/CSS)
#   ipc/   named pipe + pickle (source_set, not a DLL; chrome must not include it)

smt_shared_library("core") {
  dll_stem = "core"
  deps = [ "//third_party:CxImage" ]
  defines = [ "CORE_EXPORTS=1" ]
  sources = [
    "core/api.cpp",
    "core/core_assert.cpp",
    "core/command.cpp",
    "core/cslock.cpp",
    "core/dynlib.cpp",
    "core/dynlibmanager.cpp",
    "core/filesys.cpp",
    "core/listener.cpp",
    "core/listenermanager.cpp",
    "core/log.cpp",
    "core/logmanager.cpp",
    "core/mempool.cpp",
    "core/mempoolmgr.cpp",
    "core/memshare.cpp",
    "core/msg.cpp",
    "core/plugin.cpp",
    "core/pluginmanager.cpp",
    "core/srwlock.cpp",
    "core/thread.cpp",
    "core/threadpool.cpp",
    "core/timer.cpp",
    "core/winservice.cpp",
    "core/workthread.cpp",
    "core/xml.cpp",
    "core/xmlerror.cpp",
    "core/xmlparser.cpp",
  ]
}

smt_shared_library("base") {
  dll_stem = "style"
  defines = [ "STYLE_EXPORTS=1" ]
  sources = [
    "style/style_api.cpp",
    "style/envelope.cpp",
    "style/style.cpp",
    "style/stylemanager.cpp",
    "style/styletable.cpp",
  ]
  deps = [ ":core" ]
}
