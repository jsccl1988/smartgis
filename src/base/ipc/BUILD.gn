# Named-pipe + BinarySink codec (via //src/base/archive). Static foundation
# (//src/base:foundation); Shell hosts must not include these headers.

import("//testing/test.gni")

source_set("ipc_sources") {
  sources = [
    "channel/channel.cc",
    "channel/channel.h",
    "codec/codec.h",
    "data_pipe/data_pipe.cc",
    "data_pipe/data_pipe.h",
    "endpoint/endpoint.h",
    "handle/handle.cc",
    "handle/handle.h",
    "invitation/invitation.cc",
    "invitation/invitation.h",
    "portal/portal.cc",
    "portal/portal.h",
    "receiver/receiver.cc",
    "receiver/receiver.h",
  ]
  public_deps = [ "//src/base/archive:archive" ]
  public_configs = [ "//src/base:foundation_config" ]
}

group("ipc") {
  public_deps = [ ":ipc_sources" ]
}

test("ipc_test") {
  output_name = "ipc_test"
  sources = [ "ipc_test.cc" ]
  deps = [ ":ipc" ]
  libs = [ "ws2_32.lib" ]
}
