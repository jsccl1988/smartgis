# Named-pipe + BinarySink codec (via //src/base/archive). Static foundation
# (//src/base:foundation); Chrome hosts must not include these headers.

import("//testing/test.gni")

source_set("ipc_sources") {
  sources = [
    "channel.cc",
    "channel.h",
    "codec.h",
    "data_pipe.cc",
    "data_pipe.h",
    "endpoint.h",
    "handle.cc",
    "handle.h",
    "invitation.cc",
    "invitation.h",
    "portal.cc",
    "portal.h",
    "receiver.cc",
    "receiver.h",
  ]
  public_deps = [ "//src/base/archive:archive" ]
  public_configs = [ "//src/base:foundation_config" ]
}

group("ipc") {
  public_deps = [ ":ipc_sources" ]
}

test("ipc_test") {
  output_name = "ipc_test"
  sources = [ "ipc_test.cc" ]
  deps = [ ":ipc" ]
  libs = [ "ws2_32.lib" ]
}
