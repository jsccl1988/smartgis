import("//build/smartgis.gni")

# Compiled into //src/base:base (dll_stem = base).
# Label alias //src/base:core / //src/base/core:core keeps call sites stable.

source_set("core_sources") {
  configs += [ "//build:legacy" ]
  deps = [ "//third_party:CxImage" ]
  defines = [
    "_USRDLL",
    "CORE_EXPORTS=1",
  ]
  sources = [
    "api.cpp",
    "core_assert.cpp",
    "command.cpp",
    "cslock.cpp",
    "dynlib.cpp",
    "dynlibmanager.cpp",
    "filesys.cpp",
    "listener.cpp",
    "listenermanager.cpp",
    "log.cpp",
    "logmanager.cpp",
    "mempool.cpp",
    "mempoolmgr.cpp",
    "memshare.cpp",
    "msg.cpp",
    "plugin.cpp",
    "pluginmanager.cpp",
    "srwlock.cpp",
    "thread.cpp",
    "threadpool.cpp",
    "timer.cpp",
    "winservice.cpp",
    "workthread.cpp",
    "xml.cpp",
    "xmlerror.cpp",
    "xmlparser.cpp",
  ]
}

group("core") {
  public_deps = [ "//src/base:base" ]
}
