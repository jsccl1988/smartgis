import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/base:base (dll_stem = platform).
# Foundation headers (log/macros/export/…) live alongside leftovers in this
# directory; aggregate target is //src/base:foundation.
# Phase 6: xml → //src/legacy/xml; matrix2d → //src/algorithm/geo.
# Remaining: listener / command / msg / api / bas_struct / env_struct /
# core_assert — deferred (wide product fan-out via #include "base/core/…").

source_set("core_sources") {
  configs += [ "//build:legacy" ]
  deps = [
    "//src/base:foundation",
    "//third_party:CxImage",
  ]
  defines = [
    "_USRDLL",
    "CORE_EXPORTS=1",
  ]
  sources = [
    "api.cpp",
    "core_assert.cpp",
    "command.cpp",
    "listener.cpp",
    "listenermanager.cpp",
    "msg.cpp",
  ]
}

group("core") {
  public_deps = [ "//src/base:base" ]
}

# HMENU UINT_PTR + MBCS AppendMenuA captions used by leftover 2D/3D views.
test("menu_test") {
  output_name = "menu_test"
  sources = [ "menu_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [ "//src/base:core" ]
  libs = [ "user32.lib" ]
}
