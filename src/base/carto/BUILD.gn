import("//build/smartgis.gni")

# Cartographic pen/brush/Envelope (NOT MapLibre Style JSON — that is //src/gis/present/style).
#
# DLL choice: compiled into the product base DLL (//src/base:base,
# dll_stem=base). geo (inside gis.dll) includes Envelope, so gis.dll
# depends on base. Do not move carto into gis.dll.
# Revisit when Envelope is header-only / no longer exported from base.

source_set("carto_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "BASE_EXPORTS=1",
  ]
  sources = [
    "style_api.cpp",
    "envelope.cpp",
    "style.cpp",
    "stylemanager.cpp",
    "styletable.cpp",
  ]
}

group("carto") {
  public_deps = [ "//src/base:base" ]
}
