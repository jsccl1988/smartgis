# GPU process payload. Linked into the shell PE so
# --type=gpu relaunches the same image. Optional leftover console exe still
# builds as SmartGisRender.exe when smt_build_render is set.

import("//testing/test.gni")

config("gpu_config") {
  include_dirs += [ "//src" ]
}

# CPU src-over only (CompositorFrame IR + blend_render_pass). No OutputSurface,
# RHI, tile, or net. Safe for in-process legacy GDI buffer compose (Phase 1).
source_set("compositor_cpu_blend") {
  sources = [
    "compositor/composer/software_blend.cc",
    "compositor/composer/software_blend.h",
    "compositor/frame/frame.h",
  ]
  public_configs = [ ":gpu_config" ]
}

# Output surface, software compositor, and direct/tile raster. No //src/content:content dep.
# Basemap parses Style JSON via //src/gis/carto/style and Style `sources` via
# //src/gis/carto/tile (gis.dll). content/public headers are include-only.
# gfx: use :gfx_headers only — do not pull ui_views.dll / content / tool here.
source_set("gpu_backend") {
  sources = [
    "compositor/composer/composer.cc",
    "compositor/composer/composer.h",
    "compositor/composer/rhi_composer.cc",
    "compositor/composer/rhi_composer.h",
    "compositor/composer/software_composer.cc",
    "compositor/composer/software_composer.h",
    "compositor/underlay/underlay_bridge.cc",
    "compositor/underlay/underlay_bridge.h",
    "device/adapter_id.h",
    "device/gpu_device_hub.cc",
    "device/gpu_device_hub.h",
    "display/display.cc",
    "display/display.h",
    "display/output_surface.cc",
    "display/output_surface.h",
    "display/present_mailbox.cc",
    "display/present_mailbox.h",
    "frame_sink.h",
    "raster/direct/direct.cc",
    "raster/direct/direct.h",
    "raster/direct/mesh.cc",
    "raster/direct/mesh.h",
    "raster/tile/decode.cc",
    "raster/tile/decode.h",
    "raster/tile/fetch.cc",
    "raster/tile/mosaic.cc",
    "raster/tile/mosaic.h",
    "raster/tile/tile_quads.cc",
    "raster/tile/tile_quads.h",
  ]
  public_configs = [ ":gpu_config" ]
  public_deps = [ ":compositor_cpu_blend" ]
  deps = [
    "//src/net:net",
    "//src/gis/carto/style",
    "//src/gis/carto/tile",
    "//src/vista:vista",
    # Multi-GPU RHI compose (FrameComposer kRhi). Links render.dll; FlyCube
    # shared-handle import is still TODO on Device (see rhi.h defaults).
    "//src/vista:vista",
    "//src/render:rhi",
    "//src/render/graph:graph",
    "//src/ui/gfx:gfx_headers",
    # DWM / DXGI BeginFrame clock (shared with MapViewport; not ui_views.dll).
    "//src/ui/gfx:vblank_wait",
  ]
  libs = [
    "d3d11.lib",
    "dxgi.lib",
    "gdi32.lib",
    "ole32.lib",
    "user32.lib",
    "windowscodecs.lib",
  ]
}

source_set("gpu_lib") {
  sources = [
    "legacy_host.cc",
    "gpu.h",
    "gpu_main.cc",
    "self_test.cc",
  ]
  deps = [
    ":gpu_backend",
    "//src/base/ipc:ipc",
    "//src/content:content",
  ]
  public_configs = [ ":gpu_config" ]
}

test("render_backend_test") {
  output_name = "render_backend_test"
  sources = [ "paint_frame_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":gpu_backend" ]
  data_deps = [ "//src/render:render" ]
}

if (smt_build_render) {
  console_app("gpu") {
    output_name = "SmartGisRender"
    sources = [ "gpu_exe.cc" ]
    deps = [ ":gpu_lib" ]
    data_deps = [ "//src:src_all" ]
  }
}
