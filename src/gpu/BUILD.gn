# GPU process payload (Chromium //gpu). Linked into the chrome PE so
# --type=gpu relaunches the same image. Optional leftover console exe still
# builds as SmartGisRender.exe when smt_build_render is set.

import("//testing/test.gni")
import("maplibre.gni")

config("gpu_config") {
  include_dirs += [ "//src" ]
}

# Present + Track A/B paint. No //src/content:content dep. Track A parses
# Style JSON via //src/gis/style and Style `sources` via //src/gis/tile
# (sdb DLL). Headers under content/public are include-only.
source_set("gpu_backend") {
  sources = [
    "maplibre_adapter.cc",
    "maplibre_adapter.h",
    "maplibre_runtime.cc",
    "maplibre_runtime.h",
    "present.cc",
    "present.h",
    "render_backend.cc",
    "render_backend.h",
  ]
  public_configs = [ ":gpu_config" ]
  deps = [
    "//src/net:net",
    "//src/gis/style",
    "//src/gis/tile",
    "//src/gis/world:world",
  ]
  libs = [
    "d3d11.lib",
    "dxgi.lib",
    "gdi32.lib",
    "ole32.lib",
    "user32.lib",
    "windowscodecs.lib",
  ]
  if (smt_enable_maplibre) {
    defines += [ "SMT_ENABLE_MAPLIBRE" ]
    public_deps = [ "//third_party/maplibre:maplibre_native" ]
  }
}

source_set("gpu_lib") {
  sources = [
    "adapter.cc",
    "gpu.h",
    "gpu_main.cc",
    "self_test.cc",
  ]
  deps = [
    ":gpu_backend",
    "//src/base/ipc:ipc",
    "//src/content:content",
  ]
  public_configs = [ ":gpu_config" ]
}

test("render_backend_test") {
  output_name = "render_backend_test"
  sources = [ "render_backend_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":gpu_backend" ]
}

if (smt_build_render) {
  console_app("gpu") {
    output_name = "SmartGisRender"
    sources = [ "gpu_exe.cc" ]
    deps = [ ":gpu_lib" ]
    data_deps = [ "//src:src_all" ]
  }
}
