import("//build/smartgis.gni")

# Optional leftover render engines ? one DLL (dll_stem = legacy_render).
# Not in //src:src_all. Opt-in: ninja -C out legacy_render / legacy_render_all

# Every TU in this DLL must see dllexport for sibling leftovers (avoids
# dllimport of locally-defined symbols when headers cross module lines).
config("legacy_render_exports") {
  defines = [
    "LEGACY_RENDER_EXPORTS",
    "RENDER_EXPORTS",
    "RENDER3D_EXPORTS",
    "RENDER_GDI_EXPORTS",
    "RENDER_GDI_SIMPLE_EXPORTS",
    "RENDER_GL_EXPORTS",
    "SCENE3D_EXPORTS",
    "MODEL3D_EXPORTS",
    "POINTCLOUD_EXPORTS",
    "TERRAIN_EXPORTS",
  ]
}

smt_shared_library("legacy_render") {
  dll_stem = "legacy_render"
  defines = [
    "LEGACY_RENDER_EXPORTS",
    "RENDER_EXPORTS",
    "RENDER3D_EXPORTS",
    "RENDER_GDI_EXPORTS",
    "RENDER_GDI_SIMPLE_EXPORTS",
    "RENDER_GL_EXPORTS",
    "SCENE3D_EXPORTS",
    "MODEL3D_EXPORTS",
    "POINTCLOUD_EXPORTS",
    "TERRAIN_EXPORTS",
  ]
  deps = [
    "//src/legacy_render/bridge:render_sources",
    "//src/legacy_render/gdi:render_gdi_sources",
    "//src/legacy_render/gdi_simple:render_gdi_simple_sources",
    "//src/legacy_render/gl:render_gl_sources",
    "//src/legacy_render/model3d:model3d_sources",
    "//src/legacy_render/pointcloud:pointcloud_sources",
    "//src/legacy_render/render3d:render3d_sources",
    "//src/legacy_render/scene3d:scene3d_sources",
    "//src/legacy_render/terrain:terrain_sources",
  ]
  public_deps = [
    "//src/base:base",
    "//src/render/math:math",
    "//third_party:gdal",
  ]
  libs = [
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("legacy_render_all") {
  public_deps = [ ":legacy_render" ]
}
