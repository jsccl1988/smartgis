import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/gis:gis (dll_stem = sdb).
source_set("edit_sources") {
  sources = [
    "session/command_edit_session.cc",
    "session/command_edit_session.h",
    "session/edit_session.h",
    "session/memory_edit_session.cc",
    "session/memory_edit_session.h",
    "session/optimistic_layer_store.cc",
    "session/optimistic_layer_store.h",
  ]
  include_dirs += [
    "//src",
    "//src/base/core",
  ]
  # Export EditSession hierarchy from the sdb DLL (see gis_export.h).
  defines = [ "GIS_EXPORTS" ]
  deps = [ "//src/base:core" ]
}

source_set("map_edit_sources") {
  sources = [
    "map_edit/map_edit_session.cc",
    "map_edit/map_edit_session.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [
    ":edit_sources",
    "//src/gis/datasource/ogr:ogr_codec",
    "//third_party:gdal",
  ]
}

group("edit") {
  public_deps = [ "//src/gis:gis" ]
}

group("map_edit") {
  public_deps = [ "//src/gis:gis" ]
}

# M4: dual MemoryEditSession + OptimisticLayerStore conflict floor.
test("edit_conflict_test") {
  output_name = "edit_conflict_test"
  sources = [ "session/edit_conflict_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    ":edit",
    "//src/base:core",
  ]
}
