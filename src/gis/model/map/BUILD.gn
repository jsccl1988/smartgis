import("//build/smartgis.gni")
import("//testing/test.gni")

# Map document. Feature objects compile in //src/gis/model/feature:feature_sources.
# No deps on legacy_render / render3d (SmtMaterial stays opaque in feature.cpp).
source_set("gis_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "map.cpp",
    "map_layer.cpp",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/gis/model/feature:feature_sources",
    "//src/gis/kernel/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
  ]
}

group("gis") {
  public_deps = [ "//src/gis:gis" ]
}

# Point / box QueryFeature on china_plp + flash copy must keep features.
test("select_query_test") {
  output_name = "select_query_test"
  sources = [ "select_query_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":gis",
    "//src/legacy/datasource/mgr:sde_mgr",
    "//testing/data:china_map_samples",
    "//third_party:gdal",
  ]
}
