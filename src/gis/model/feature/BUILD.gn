import("//build/smartgis.gni")
import("//testing/test.gni")

# Product feature (OGRFeature + style / Grid / Tin sidecars).
# Compiled into //src/gis:gis.
source_set("feature_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    # Same DLL as geo. Without this, Grid/Tin calls are dllimport of
    # same-module symbols (LNK2019 on __imp_*).
  ]
  sources = [
    "feature.cpp",
    "feature_api.cpp",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/gis/kernel/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
  ]
}

test("feature_test") {
  output_name = "feature_test"
  sources = [ "feature_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/gis:gis",
    "//third_party:gdal",
  ]
}
