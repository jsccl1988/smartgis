import("//build/smartgis.gni")
import("//testing/test.gni")

# CPU MapFrame. Ortho is the current camera; perspective uses the same
# Layout. Compiled into //src/gis:gis. Not a second scene.
source_set("frame_sources") {
  sources = [
    "default_style.cc",
    "detail/collision.cc",
    "detail/collision.h",
    "frame.h",
    "layout.cc",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  deps = [
    "//src/base:foundation",
    "//src/gis/present/style:style_sources",
    "//src/gis/vista/world:world_sources",
  ]
}

group("frame") {
  public_deps = [ "//src/gis:gis" ]
}

test("frame_test") {
  output_name = "frame_test"
  sources = [ "map2d_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":frame",
    "//src/base:base",
    "//third_party:gdal",
  ]
}
