import("//build/smartgis.gni")
import("//testing/test.gni")

# Pure lon/lat ring tests — no GIS_EXPORTS. Leftover DEM + Views both compile this in.
source_set("land_mask") {
  sources = [
    "terrain/land_mask.cc",
    "terrain/land_mask.h",
  ]
  include_dirs += [ "//src" ]
}

# Compiled into //src/gis:gis (dll_stem = gis).
source_set("world_sources") {
  sources = [
    "world.cc",
    "world.h",
    "terrain/dem_frame.h",
    "terrain/dem_raster.cc",
    "terrain/dem_raster.h",
    "terrain/tessellate.cc",
    "terrain/tessellate.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/gis/vista/assets:assets_sources",
    "//third_party:gdal",
  ]
  deps = [
    ":land_mask",
    "//src/gis/kernel/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
    "//src/gis/datasource/provider/impl/ogr:ogr_codec",
  ]
}

group("world") {
  public_deps = [ "//src/gis:gis" ]
}

test("world_test") {
  output_name = "world_test"
  sources = [ "world_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//third_party:gdal",
  ]
}

test("land_mask_test") {
  output_name = "land_mask_test"
  sources = [ "terrain/land_mask_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":land_mask" ]
}

test("dem_raster_test") {
  output_name = "dem_raster_test"
  sources = [ "terrain/dem_raster_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//third_party:gdal",
  ]
}

test("tessellate_style_test") {
  output_name = "tessellate_style_test"
  sources = [ "terrain/tessellate_style_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":world",
    "//src/base:base",
    "//third_party:gdal",
  ]
}
