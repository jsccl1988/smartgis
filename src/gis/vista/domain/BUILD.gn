import("//build/smartgis.gni")

# Header-only domain seam. GN sources must sit under this BUILD file, so the
# header cannot be listed from vista/world. //src/gis:gis depends on this
# target. Implemented session packs live under domain/atmosphere/.

source_set("domain_sources") {
  sources = [ "domain.h" ]
  include_dirs += [ "//src" ]
}
