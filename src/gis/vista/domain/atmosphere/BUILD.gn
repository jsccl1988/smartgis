import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/gis:gis (dll_stem = gis).
source_set("atmosphere_sources") {
  sources = [
    "field/field_channel.h",
    "field/field_ingest.cc",
    "field/field_ingest.h",
    "field/field_store.cc",
    "field/field_store.h",
    "systems/atmosphere_params.h",
    "systems/cloud_system.cc",
    "systems/cloud_system.h",
    "systems/environment.cc",
    "systems/environment.h",
    "systems/ocean_system.cc",
    "systems/ocean_system.h",
    "systems/procedural.cc",
    "systems/procedural.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/gis/vista/domain:domain_sources",
    "//src/gis/vista/world:land_mask",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
  ]
}

group("atmosphere") {
  public_deps = [ "//src/gis:gis" ]
}

# Unit tests compile field/cloud sources in-process (GIS_EXPORTS) so a locked
# gis_d.dll (LNK1168) does not block verification.
test("field_store_test") {
  output_name = "field_store_test"
  sources = [
    "field/field_store.cc",
    "field/field_store_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [ "//src/base:base" ]
}

test("procedural_test") {
  output_name = "procedural_test"
  sources = [
    "field/field_store.cc",
    "systems/procedural.cc",
    "systems/procedural_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [
    "//src/base:base",
    "//src/gis/vista/world:land_mask",
  ]
}

test("field_ingest_test") {
  output_name = "field_ingest_test"
  sources = [
    "field/field_ingest.cc",
    "field/field_store.cc",
    "field/field_ingest_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [
    "//src/base:base",
    "//third_party:gdal",
