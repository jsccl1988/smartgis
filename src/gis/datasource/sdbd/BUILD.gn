import("//build/smartgis.gni")
import("//testing/test.gni")

# Remote mogu sdbd (HTTP :8021 / FnRPC :9032) plus the local SDBD GDAL
# decorator. Client is its own source_set so unit tests skip the gis DLL.

source_set("sdbd_client") {
  configs += [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  sources = [
    "client/sdbd_client.cc",
    "client/sdbd_client.h",
    "sdbd_endpoint.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/net:net",
  ]
}

# Compiled into //src/gis:gis via //src/gis/datasource/gdal:sde_gdal_sources.
source_set("sdbd_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "decorator/sdbd_dataset.cc",
    "decorator/sdbd_dataset.h",
    "decorator/sdbd_gdal_driver.cc",
    "decorator/sdbd_gdal_driver.h",
    "decorator/sdbd_handler.cc",
    "decorator/sdbd_handler.h",
    "decorator/sdbd_json.cc",
    "decorator/sdbd_json.h",
    "decorator/sdbd_layer.cc",
    "decorator/sdbd_layer.h",
    "decorator/sdbd_remote_dataset.cc",
    "decorator/sdbd_remote_dataset.h",
    "decorator/sdbd_types.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":sdbd_client",
    "//src/gis/datasource/ogr:ogr_codec",
    "//src/base:base",
    "//src/base:core",
    "//src/net:net",
    "//third_party:gdal",
  ]
}

test("sdbd_client_test") {
  output_name = "sdbd_client_test"
  sources = [
    "client/sdbd_client_test.cc",
    # parse_json only — no GDAL; avoids linking the gis DLL for this unit test.
    "decorator/sdbd_json.cc",
  ]
  defines = [ "GIS_EXPORTS" ]
  include_dirs += [ "//src" ]
  deps = [
    ":sdbd_client",
    "//src/base:base",
    "//src/net:net",
  ]
}

test("sdbd_live_test") {
  output_name = "sdbd_live_test"
  sources = [
    "decorator/sdbd_live_test.cc",
    # parse_json is not SDE_GDAL_EXPORT; compile locally like sdbd_client_test.
    "decorator/sdbd_json.cc",
  ]
  # Do not set GIS_EXPORTS here — that re-exports Feature/Grid/Tin in the test
  # PE and LNK2005s against gis_d.dll.
  include_dirs += [
    "//src",
    "//src/gis/datasource/mgr",
  ]
  deps = [
    "//src/gis/datasource/gdal:sde_gdal",
    "//src/gis/datasource/ogr:ogr_codec",
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/gis/datasource/mgr:sde_mgr",
    "//src/net:net",
    "//third_party:gdal",
  ]
  data_deps = [
    "//src/gis/datasource/gdal:sde_gdal",
    "//third_party:gdal_runtime_dlls",
  ]
}
