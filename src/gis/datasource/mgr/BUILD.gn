import("//build/smartgis.gni")

# Compiled into //src/gis:gis (dll_stem = sdb).
# No deps on //src/gis/map:gis or :sde_gdal groups (same DLL — avoid GN cycles).
source_set("sde_mgr_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "SDE_MGR_EXPORTS",
  ]
  sources = [ "datasource_mgr.cc" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//third_party:gdal",
  ]
}

group("sde_mgr") {
  public_deps = [ "//src/gis:gis" ]
}
