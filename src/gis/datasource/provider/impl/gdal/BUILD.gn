import("//build/smartgis.gni")
import("//testing/test.gni")

# L3 register entry: GDALAllRegister + SDBD driver.
# OGR codec: //src/gis/datasource/provider/impl/ogr. SDBD: //src/gis/datasource/provider/impl/sdbd.
# Aggregated into //src/gis:gis.

source_set("sde_gdal_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "gdal_driver.cc",
    "gdal_driver.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/gis/datasource/provider/impl/ogr:ogr_codec",
    "//src/gis/datasource/provider/impl/ogr:ogr_raster",
    "//src/gis/datasource/provider/impl/sdbd:sdbd_client",
    "//src/gis/datasource/provider/impl/sdbd:sdbd_sources",
    "//src/base:base",
    "//src/base:core",
    "//src/net:net",
    "//third_party:gdal",
  ]
}

group("sde_gdal") {
  public_deps = [ "//src/gis:gis" ]
}

test("sde_gdal_test") {
  output_name = "sde_gdal_test"
  sources = [ "sde_gdal_test.cc" ]
  include_dirs += [
    "//src",
    "//src/legacy/datasource/mgr",
  ]
  deps = [
    ":sde_gdal",
    "//src/gis/datasource/provider/impl/ogr:ogr_codec",
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/datasource/mgr:sde_mgr",
    "//src/gis/model/map:gis",
    "//third_party:gdal",
  ]
  data_deps = [
    ":sde_gdal",
    "//third_party:gdal_runtime_dlls",
  ]
}
