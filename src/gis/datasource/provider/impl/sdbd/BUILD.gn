import("//build/smartgis.gni")
import("//testing/test.gni")

# Remote mogu sdbd (HTTP :8021 / FnRPC :9032) plus the local SDBD GDAL
# driver. Client is its own source_set so unit tests skip the gis DLL.

source_set("sdbd_client") {
  configs += [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  sources = [
    "client/sdbd_client.cc",
    "client/sdbd_client.h",
    "sdbd_endpoint.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/net:net",
    "//third_party:rapidjson",
  ]
}

# Compiled into //src/gis:gis via //src/gis/datasource/provider/impl/gdal:sde_gdal_sources.
source_set("sdbd_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "codec/sdbd_json.cc",
    "codec/sdbd_json.h",
    "driver/sdbd_dataset.cc",
    "driver/sdbd_dataset.h",
    "driver/sdbd_driver.cc",
    "driver/sdbd_driver.h",
    "driver/sdbd_layer.cc",
    "driver/sdbd_layer.h",
    "remote/sdbd_remote_dataset.cc",
    "remote/sdbd_remote_dataset.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":sdbd_client",
    "//src/gis/datasource/provider/impl/ogr:ogr_codec",
    "//src/base:base",
    "//src/base:core",
    "//src/net:net",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
}

test("sdbd_client_test") {
  output_name = "sdbd_client_test"
  sources = [
    "client/sdbd_client_test.cc",
    # parse_collection_ids only — no GDAL; avoids linking the gis DLL.
    "codec/sdbd_json.cc",
  ]
  defines = [ "GIS_EXPORTS" ]
  include_dirs += [ "//src" ]
  deps = [
    ":sdbd_client",
    "//src/base:base",
    "//src/net:net",
    "//third_party:rapidjson",
  ]
}

test("sdbd_live_test") {
  output_name = "sdbd_live_test"
  sources = [
    "remote/sdbd_live_test.cc",
    # parse_collection_ids is not SDE_GDAL_EXPORT; compile locally.
    "codec/sdbd_json.cc",
  ]
  # Do not set GIS_EXPORTS here — that re-exports Feature/Grid/Tin in the test
  # PE and LNK2005s against gis_d.dll. Use ogr_codec_client (no GIS_EXPORTS).
  include_dirs += [
    "//src",
    "//src/legacy/gis/datasource",
  ]
  deps = [
    "//src/gis/datasource/provider/impl/gdal:sde_gdal",
    "//src/gis/datasource/provider/impl/ogr:ogr_codec_client",
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/net:net",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  data_deps = [
    "//src/gis/datasource/provider/impl/gdal:sde_gdal",
    "//third_party:gdal_runtime_dlls",
  ]
}
