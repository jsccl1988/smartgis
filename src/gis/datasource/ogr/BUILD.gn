import("//build/smartgis.gni")
import("//testing/test.gni")

# OGR field codec and connection traits.
#
# Two compile variants (same sources):
# - ogr_codec: GIS_EXPORTS — linked only into //src/gis:gis (and in-DLL
#   source_sets). Inline GIS_EXPORT members must not also appear in a second
#   PE that imports gis.dll (LNK2005).
# - ogr_codec_client: no GIS_EXPORTS — leftover / content / tests that already
#   link //src/gis:gis. GIS_EXPORT becomes dllimport so Tin/Style inlines
#   resolve via gis.lib.

# Windows charset helper only (no GDAL). Views + leftover GDI both decode
# OGR field bytes with this so GBK is not treated as loose UTF-8.
source_set("ogr_text_encoding") {
  sources = [
    "ogr_text_encoding.cc",
    "ogr_text_encoding.h",
  ]
  include_dirs += [ "//src" ]
}

template("ogr_codec_set") {
  source_set(target_name) {
    sources = [
      "ogr_connect.cc",
      "ogr_connect.h",
      "ogr_feature_codec.cc",
      "ogr_feature_codec.h",
      "ogr_feature_kind.h",
    ]
    configs += [ "//build:legacy" ]
    public_configs = [ "//build:legacy" ]
    include_dirs += [ "//src" ]
    # Do not forward_variables_from(defines) — BUILDCONFIG already sets
    # defines = [] and forward_* refuses to clobber.
    defines = invoker.extra_defines
    public_deps = [
      "//src/gis/datasource/pipeline:pipeline",
      "//third_party:gdal",
    ]
    if (defined(invoker.extra_public_deps)) {
      public_deps += invoker.extra_public_deps
    }
    deps = [
      # Grid/Tin live in gis.dll. Do not dep :geo (group → that DLL; the
      # in-DLL variant is linked into it, so that cycles) or :geo_sources
      # (would duplicate Tin objs). Out-of-DLL callers depend on
      # //src/gis/geo:geo / //src/gis:gis.
      "//src/base:base",
      "//src/base:core",
      "//src/base:foundation",
    ]
    if (defined(invoker.extra_deps)) {
      deps += invoker.extra_deps
    }
  }
}

# In-DLL objs for //src/gis:gis (sde_gdal_sources, ogr_raster, sdbd, …).
ogr_codec_set("ogr_codec") {
  extra_defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  extra_deps = [ ":ogr_text_encoding" ]
}

# External PEs that link gis.dll — do not set GIS_EXPORTS.
ogr_codec_set("ogr_codec_client") {
  extra_defines = [ "_USRDLL" ]
  extra_public_deps = [ "//src/gis:gis" ]
}

# Raster scratch layer. Compiled into //src/gis:gis via sde_gdal_sources.
source_set("ogr_raster") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "ogr_raster_layer.cc",
    "ogr_raster_layer.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    ":ogr_codec",
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
    "//third_party:gdal",
  ]
}

test("ogr_text_encoding_test") {
  output_name = "ogr_text_encoding_test"
  sources = [ "ogr_text_encoding_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":ogr_text_encoding" ]
}
