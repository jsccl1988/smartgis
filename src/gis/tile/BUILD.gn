import("//build/smartgis.gni")
import("//testing/test.gni")

# HTTP(S) XYZ/WMTS TileProvider. Compiled into //src/gis:gis (dll_stem = sdb).
source_set("tile_sources") {
  sources = [
    "cache/tile_cache.h",
    "cache/tile_disk_cache.cc",
    "cache/tile_disk_cache.h",
    "cache/tile_disk_cache_paths.cc",
    "cache/tile_disk_cache_paths.h",
    "layer/provider_tile_layer.cc",
    "layer/provider_tile_layer.h",
    "layer/tile_map_layer.cc",
    "layer/tile_map_layer.h",
    "protocol/lonlat_xyz.cc",
    "protocol/lonlat_xyz.h",
    "protocol/mercator_math.cc",
    "protocol/mercator_math.h",
    "protocol/tile_image.h",
    "protocol/wmts.cc",
    "protocol/wmts.h",
    "protocol/xyz_math.h",
    "provider/mvt.cc",
    "provider/mvt.h",
    "provider/source_registry.cc",
    "provider/source_registry.h",
    "provider/style_source.cc",
    "provider/style_source.h",
    "provider/tile_provider.cc",
    "provider/tile_provider.h",
    "provider/xyz_source.cc",
    "provider/xyz_source.h",
  ]
  libs = [ "wininet.lib" ]
  include_dirs += [
    "//src",
    "//third_party/.install/include",
    "//third_party/.src/CxImage/zlib",
  ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/net:net",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
    "//third_party/CxImage:zlib",
  ]
}

group("tile") {
  public_deps = [ "//src/gis:gis" ]
}

test("tile_test") {
  output_name = "tile_test"
  sources = [ "tile_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":tile",
    "//src/base:base",
    "//src/base:core",
    "//src/net:net",
    "//src/gis:gis",
    "//src/vista:vista",
  ]
}

test("lonlat_xyz_test") {
  output_name = "lonlat_xyz_test"
  sources = [ "protocol/lonlat_xyz_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":tile",
    "//src/base:base",
    "//src/base:core",
    "//src/gis:gis",
  ]
  # Legacy WINDOWS subsystem; CRT entry still calls gtest_main's main().
  ldflags = [ "/ENTRY:mainCRTStartup" ]
}
