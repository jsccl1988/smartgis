import("//build/smartgis.gni")
import("//testing/test.gni")

# ANTLR-generated parser + evaluator. Keep //build:legacy off so
# _HAS_STD_BYTE=0 / smt_compat.h do not break the C++ runtime.
source_set("stat_eval") {
  sources = [
    "detail/ops.cc",
    "eval/evaluate.cc",
    "gen/StatExprLexer.cpp",
    "gen/StatExprParser.cpp",
  ]
  include_dirs += [
    "//src",
    "//src/gis/kernel/stat",
    "//src/gis/kernel/stat/gen",
  ]
  defines = [
    "BUILD_AS_DLL",
    "GIS_EXPORTS",
    "ANTLR4CPP_STATIC",
    "NOMINMAX",
    "_CRT_DECLARE_NONSTDC_NAMES=0",
  ]
  public_deps = [ "//third_party:antlr4" ]
}

# Compiled into //src/gis:gis (dll_stem = gis). :stat is the consumer label.
source_set("stat_sources") {
  sources = [ "value/value_set.cc" ]
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "ANTLR4CPP_STATIC",
    "_CRT_DECLARE_NONSTDC_NAMES=0",
  ]
  deps = [
    ":stat_eval",
    "//src/base:core",
  ]
}

group("stat") {
  public_deps = [ "//src/gis:gis" ]
}

test("stat_expr_test") {
  output_name = "stat_expr_test"
  sources = [ "stat_expr_test.cc" ]
  include_dirs += [
    "//src",
    "//src/gis/kernel/stat",
    "//src/base/core",
  ]
  defines = [
    "NOMINMAX",
    "_CRT_DECLARE_NONSTDC_NAMES=0",
  ]
  deps = [
    ":stat",
    "//src/base:core",
  ]
}
