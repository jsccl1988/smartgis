import("//build/smartgis.gni")
import("//testing/benchmark.gni")
import("//testing/test.gni")

# PROJ 9 comes from //third_party:gdal (public_deps :PROJ; copies
# proj.db / runtime DLLs next to out/). Do not vendor a second PROJ.
# Compiled into //src/gis:gis (dll_stem = gis). :proj is the consumer label.
source_set("proj_sources") {
  sources = [
    "backend/proj_backend.cc",
    "backend/proj_runtime.cpp",
    "api/projection.cpp",
  ]
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  deps = [
    "//src/gis/kernel/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
    "//third_party:gdal",
  ]
  if (is_debug) {
    libs += [ "proj_d.lib" ]
  } else {
    libs += [ "proj.lib" ]
  }
}

group("proj") {
  public_deps = [ "//src/gis:gis" ]
}

test("proj_test") {
  output_name = "proj_test"
  sources = [ "api/proj_test.cpp" ]
  include_dirs += [
    "//src/gis/kernel/proj",
    "//src/base/core",
    "//src",
  ]
  deps = [
    ":proj",
    "//src/base:core",
    "//third_party:gdal",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}

# google/benchmark for project_point / transform_xy / naive_webmerc.
benchmark("proj_benchmark") {
  output_name = "proj_benchmark"
  sources = [ "api/proj_benchmark.cc" ]
  include_dirs += [
    "//src/gis/kernel/proj",
    "//src/base/core",
    "//src",
  ]
  deps = [
    ":proj",
    "//src/base:core",
    "//third_party:gdal",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}
