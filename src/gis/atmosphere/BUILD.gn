import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/gis:gis (dll_stem = gis).
source_set("atmosphere_sources") {
  sources = [
    "atmosphere_params.h",
    "cloud_system.cc",
    "cloud_system.h",
    "environment.cc",
    "environment.h",
    "field_channel.h",
    "field_ingest.cc",
    "field_ingest.h",
    "field_store.cc",
    "field_store.h",
    "ocean_system.cc",
    "ocean_system.h",
    "procedural.cc",
    "procedural.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/gis/world:land_mask",
    "//third_party:gdal",
  ]
  deps = [
    "//src/base:base",
  ]
}

group("atmosphere") {
  public_deps = [ "//src/gis:gis" ]
}

# Unit tests compile field/cloud sources in-process (GIS_EXPORTS) so a locked
# gis_d.dll (LNK1168) does not block verification.
test("field_store_test") {
  output_name = "field_store_test"
  sources = [
    "field_store.cc",
    "field_store_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [ "//src/base:base" ]
}

test("procedural_test") {
  output_name = "procedural_test"
  sources = [
    "field_store.cc",
    "procedural.cc",
    "procedural_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  defines = [ "GIS_EXPORTS" ]
  deps = [
    "//src/base:base",
    "//src/gis/world:land_mask",
  ]
}

