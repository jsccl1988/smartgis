import("//build/smartgis.gni")
import("//testing/test.gni")

# Product Feature: OGRFeature composition. Geometry type is OGRwkbGeometryType.
# Compiled into //src/gis:gis.
source_set("feature_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    # Same DLL as geo. Without this, Grid/Tin calls are dllimport of
    # same-module symbols (LNK2019 on __imp_*).
  ]
  sources = [
    "attrs.h",
    "feature.cc",
    "feature.h",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//third_party:gdal" ]
  deps = [
    "//src/gis/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
  ]
}

test("feature_test") {
  output_name = "feature_test"
  sources = [ "feature_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/gis:gis",
    "//third_party:gdal",
  ]
}

# Header-only FeatureId / NamedField helpers (no DLL link required).
test("feature_attrs_test") {
  output_name = "feature_attrs_test"
  sources = [ "attrs_test.cc" ]
  include_dirs += [ "//src" ]
}
