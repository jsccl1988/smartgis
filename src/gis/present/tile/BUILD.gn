import("//build/smartgis.gni")
import("//testing/test.gni")

# HTTP(S) XYZ/WMTS TileProvider. Compiled into //src/gis:gis (dll_stem = sdb).
source_set("tile_sources") {
  sources = [
    "cache/tile_cache.h",
    "cache/tile_disk_cache.cc",
    "cache/tile_disk_cache.h",
    "protocol/wmts.cc",
    "protocol/wmts.h",
    "protocol/xyz_math.h",
    "provider/mvt_stub.cc",
    "provider/mvt_stub.h",
    "provider/provider_tile_layer.cc",
    "provider/provider_tile_layer.h",
    "provider/source_registry.cc",
    "provider/source_registry.h",
    "provider/style_source.cc",
    "provider/style_source.h",
    "provider/tile_map_layer.cc",
    "provider/tile_map_layer.h",
    "provider/tile_provider.cc",
    "provider/tile_provider.h",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  public_deps = [
    "//src/net:net",
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
  ]
}

group("tile") {
  public_deps = [ "//src/gis:gis" ]
}

test("tile_test") {
  output_name = "tile_test"
  sources = [ "tile_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    ":tile",
    "//src/base:base",
    "//src/base:core",
    "//src/net:net",
    "//src/gis/model/map:gis",
    "//src/gis/vista/world:world",
  ]
}
