import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/gis:gis. Public product API remains plugin::
# (thin forwarders under plugin/runtime/processing).
source_set("analysis_sources") {
  sources = [
    "geochem/grade.cc",
    "geochem/grade.h",
    "geochem/idw.cc",
    "geochem/idw.h",
    # idw_profile.cc is empty (helpers are header-inline in idw_profile.h).
    "geochem/idw_profile.h",
    "geochem/samples.cc",
    "geochem/samples.h",
    "geochem/stats.cc",
    "geochem/stats.h",
    "geology/borehole.cc",
    "geology/borehole.h",
    "geology/prism_volume.cc",
    "geology/prism_volume.h",
    "geology/stratum_tin.cc",
    "geology/stratum_tin.h",
    "geometry/fit.cc",
    "geometry/fit.h",
    "network/cost_path.cc",
    "network/cost_path.h",
    "ops/ops_runner.cc",
    "ops/ops_runner.h",
    "raster/dem/dem_gradient.cc",
    "raster/dem/dem_gradient.h",
    "raster/dem/dem_gradient_profile.cc",
    "raster/dem/dem_gradient_profile.h",
    "raster/dem/flood_fill.cc",
    "raster/dem/flood_fill.h",
    "raster/dem/hillshade.cc",
    "raster/dem/hillshade.h",
    "raster/mask/ring_mask.cc",
    "raster/mask/ring_mask.h",
    "raster/dem/storm_surge.cc",
    "raster/dem/storm_surge.h",
    "raster/dem/storm_surge_stats.cc",
    "raster/dem/storm_surge_stats.h",
    "raster/filter/raster_convolve.cc",
    "raster/filter/raster_convolve.h",
    # raster_convolve_profile.cc is a GN placeholder; GIS_EXPORT lives in
    # raster_convolve.cc.
    "raster/filter/raster_convolve_profile.h",
    "raster/filter/raster_smooth.cc",
    "raster/filter/raster_smooth.h",
  ]
  include_dirs += [ "//src" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "NOMINMAX",
  ]
  public_deps = [
    "//third_party:gdal",
    "//third_party:rapidjson",
  ]
  deps = [
    "//src/base:base",
    "//src/base/execution:execution",
    "//src/base/math:math",
    "//third_party:eigen",
  ]
}

group("analysis") {
  public_deps = [ "//src/gis:gis" ]
}

