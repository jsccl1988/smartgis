# google/benchmark for //:benchmark_all / Console :gis bench.
group("gis_benchmark_all") {
  testonly = true
  deps = [
    "//src/gis/kernel/geo:geo_benchmark",
    "//src/gis/kernel/proj:proj_benchmark",
