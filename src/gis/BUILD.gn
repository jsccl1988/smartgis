# GIS product tree (QGIS qgis_core + analysis kernels) — not a literal database.
# One DLL (dll_stem = gis). Top-level groups (no extra public namespace):
#   {feature,map,edit} + envelope.h  (no gis/model/, no one-file layer/crs)
#   datasource/{session,provider,pipeline,ogr,sdbd,gdal}

#   carto/{style,tile}    — StyleDocument, symbols, tiles; inputs to MapIR.
#   CPU MapIR / World / vista GPU live in //src/vista:vista (vista.dll).
#   geo/{mesh,ops,proj,tin,grid} / stat  (no kernel/ parent; no sibling proj/tin)
#   analysis/{ops,geometry,raster} — processing kernels; plugin:: only forwards
# //src/gis:algorithm and :geom forward to :gis.
# In-DLL source_sets depend on //src/gis/geo:geo_sources (not :geo)
# so the group can point back at this DLL without a GN cycle.

import("//build/smartgis.gni")

product_shared_library("gis") {
  dll_stem = "gis"
  assert_no_deps = [ "//src/vista:vista" ]
  defines = [
    "SDB_EXPORTS",
    "GIS_EXPORTS",
  ]
  deps = [
    "//src/gis/map:gis_sources",
    "//src/gis/datasource/gdal:sde_gdal_sources",
    "//src/gis/datasource/session:session_sources",
    "//src/gis/datasource/provider:provider_sources",
    "//src/gis/tile:tile_sources",
    "//src/gis/edit:edit_sources",
    "//src/gis/edit:map_edit_sources",
    "//src/gis/style:style_sources",
    "//src/gis/geo:geo_sources",
    "//src/gis/geo:proj_sources",
    "//src/gis/stat:stat_sources",
    "//src/gis/geo:tin_sources",
    "//src/gis/geo:grid_sources",
    "//src/gis/analysis:analysis_sources",
  ]
  # TileProvider / Sdbd headers expose net::; consumers that include them need net.lib.
  # LOGGING / log_sink live in base.dll (not statically absorbed via foundation).
  # MVT gunzip needs zlib symbols on the DLL link line. CxImage.dll does not
  # export inflate*; product_shared_library also may not absorb CxImage:zlib static.
  public_deps = [
    "//src/base:base",
    "//src/net:net",
    "//third_party:gdal",
  ]
  lib_dirs += [ "//third_party/.install/lib" ]
  # Prefer install static zlib by path. Bare "zlib.lib" resolves to
  # out/<config>/zlib.lib (CxImage import lib) before LIBPATH and has no
  # inflate* — Release then LNK2001 on mvt.obj. Debug uses zlibstaticd.lib
  # which does not collide with that import name.
  if (is_debug) {
    libs += [ "zlibstaticd.lib" ]
  } else {
    libs +=
        [ rebase_path("//third_party/.install/lib/zlib.lib", root_build_dir) ]
  }
}

group("gis_all") {
  public_deps = [ ":gis" ]
}

group("datasource") {
  public_deps = [ ":gis" ]
}

# Former algorithm.dll. Kernels are objects in gis.dll; these labels remain
# so existing deps do not need a second target name.
group("algorithm") {
  public_deps = [ ":gis" ]
}

group("geom") {
  public_deps = [ ":gis" ]
}

group("algorithm_all") {
  public_deps = [ ":gis" ]
}

