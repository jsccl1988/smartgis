# GIS product tree (QGIS qgis_core + analysis kernels) — not a literal database.
# One DLL (dll_stem = gis). Top-level groups (no extra public namespace):
#   model/{feature,layer,map,crs,edit}
#   datasource/{session,provider,pipeline}  L3 under provider/impl/{sdbd,ogr,gdal}
#     L1 session → L2 provider → L3 impl; L4 pipeline
#     leftover DataSourceMgr → //src/legacy/gis/datasource

#   present/{style,tile}  — StyleDocument, symbols, tiles; inputs to MapFrame.
#                           Leftover carto POD: //src/legacy/gis/present/carto
#                           Not folded into vista.
#   vista/{frame,world,assets,domain}
#       frame is the CPU MapFrame (ortho now, perspective later); no RHI
#       world is the gis::World node graph
#       domain/atmosphere is the only implemented DomainKind session (kAtmosphere)
#   kernel/{geo,proj,tin,stat}
#   analysis/{ops,geometry,raster} — processing kernels; plugin:: only forwards
# //src/gis:algorithm and :geom forward to :gis.
# In-DLL source_sets depend on //src/gis/kernel/geo:geo_sources (not :geo)
# so the group can point back at this DLL without a GN cycle.

import("//build/smartgis.gni")

smt_shared_library("gis") {
  dll_stem = "gis"
  defines = [
    "SDB_EXPORTS",
    "GIS_EXPORTS",
  ]
  deps = [
    "//src/gis/model/map:gis_sources",
    "//src/gis/datasource/provider/impl/gdal:sde_gdal_sources",
    "//src/legacy/gis/datasource:sde_mgr_sources",
    "//src/gis/datasource/session:session_sources",
    "//src/gis/datasource/provider:provider_sources",
    "//src/gis/present/tile:tile_sources",
    "//src/gis/vista/assets:assets_sources",
    "//src/gis/vista/world:world_sources",
    "//src/gis/vista/domain/atmosphere:atmosphere_sources",
    "//src/gis/vista/domain:domain_sources",
    "//src/gis/model/edit:edit_sources",
    "//src/gis/model/edit:map_edit_sources",
    "//src/gis/present/style:style_sources",
    "//src/legacy/gis/present/carto:carto_sources",
    "//src/gis/vista/frame:frame_sources",
    "//src/gis/kernel/geo:geo_sources",
    "//src/gis/kernel/proj:proj_sources",
    "//src/gis/kernel/stat:stat_sources",
    "//src/gis/kernel/tin:tin_sources",
    "//src/gis/analysis:analysis_sources",
  ]
  # TileProvider / Sdbd headers expose net::; consumers that include them need net.lib.
  # LOGGING / log_sink live in base.dll (not statically absorbed via foundation).
  public_deps = [
    "//src/base:base",
    "//src/net:net",
    "//third_party:gdal",
  ]
}

group("gis_all") {
  public_deps = [ ":gis" ]
}

group("datasource") {
  public_deps = [ ":gis" ]
}

# Former algorithm.dll. Kernels are objects in gis.dll; these labels remain
# so existing deps do not need a second target name.
group("algorithm") {
  public_deps = [ ":gis" ]
}

group("geom") {
  public_deps = [ ":gis" ]
}

group("algorithm_all") {
  public_deps = [ ":gis" ]
}

