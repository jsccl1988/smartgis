  testonly = true
  deps = [
    "//src/gis/geo:ops_test",
    "//src/gis/geo:indexed_tin_test",
    "//src/gis/geo:proj_test",
    "//src/gis/stat:stat_expr_test",
    "//src/gis/geo:tin_delaunay_test",
    "//src/gis/geo:geo_grid_laplace_test",
    "//src/gis/datasource/session:datasource_session_test",
    "//src/gis/datasource/pipeline:feature_load_pipeline_test",
    "//src/gis/datasource/gdal:sde_gdal_test",
    "//src/gis/datasource/ogr:ogr_text_encoding_test",
    "//src/gis/datasource/sdbd:sdbd_client_test",
    "//src/gis/datasource/sdbd:sdbd_live_test",
    "//src/gis/feature:feature_test",
    "//src/gis/map:select_query_test",
    "//src/gis/map:map_layer_test",
    "//src/gis/edit:edit_conflict_test",
    "//src/gis/style:style_test",
    "//src/gis/tile:tile_test",
    "//src/gis/analysis:analysis_eigen_test",
    "//src/gis/analysis:analysis_geology_test",
    "//src/gis/analysis:analysis_dem_gradient_profile_test",
  ]
}

# google/benchmark for //:benchmark_all / Console :gis bench.
# Analysis CPU benches are custom-main test() binaries (serial vs parallel).
group("gis_benchmark_all") {
  testonly = true
  deps = [
    "//src/gis/geo:buffer_benchmark",
    "//src/gis/geo:proj_benchmark",
    "//src/gis/datasource/session:datasource_benchmark",
    "//src/gis/datasource/pipeline:feature_load_pipeline_bench",
    "//src/gis/analysis:analysis_dem_gradient_bench",
    "//src/gis/analysis:analysis_convolve_bench",
    "//src/gis/analysis:analysis_idw_bench",
  ]
}
