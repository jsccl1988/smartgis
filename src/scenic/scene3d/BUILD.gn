import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/scenic:scenic_impl (dll_stem = scenic_impl).
# Layout: host/ scene/ primitive/{mesh,feature,surface}/ test/.
# Device-free DEM/World: //src/vista/component/world; feature tess: primitive/feature.
source_set("scene3d_sources") {
  sources = [
    "scene/scene.cpp",
    "scene/scene.h",
    "scene/octree.cpp",
    "scene/octree.h",
    "scene/d3d_deferred_objects.h",
    "scene/map_to_scene.cc",
    "scene/map_to_scene.h",
    "scene/scene_to_world.cc",
    "scene/scene_to_world.h",
    "scene/object.cc",
    "scene/object.h",
    "host/stereo_hwnd_view.cc",
    "host/stereo_hwnd_view.h",
    "primitive/feature/tess_map.cc",
    "primitive/feature/tess_world.cc",
    "primitive/feature/feature_mesh.h",
    "primitive/mesh/mesh_gpu.cc",
    "primitive/mesh/mesh_gpu.h",
    "primitive/mesh/cube.cc",
    "primitive/mesh/northarray.cc",
    "primitive/mesh/sphere.cc",
    "primitive/mesh/water.cc",
    "primitive/feature/geo_object.cc",
    "primitive/feature/geo_object.h",
    "primitive/feature/map_label_batch.cc",
    "primitive/feature/map_label_batch.h",
    "primitive/surface/surface_base.cc",
    "primitive/surface/surface_base.h",
    "primitive/surface/pointcloud.cpp",
    "primitive/surface/pointcloud.h",
    "primitive/surface/terrain.cpp",
    "primitive/surface/terrain.h",
  ]
  configs += [
    "//build:legacy",
    "//src/scenic:scenic_impl_exports",
  ]
  defines = [
    "_USRDLL",
    "NOMINMAX",
  ]
  deps = [
    "//src/gis:gis",
    "//src/gis/geo:geo",
    "//src/gis/geo:tin",
    "//src/base:base",
    "//src/base:core",
    "//src/scenic/render/rhi2d/impl/common:gdi_common_sources",
    "//src/scenic/render/rhi3d:rhi_sources",
    "//src/base/math:bounds",
    "//src/gis/datasource/ogr:ogr_codec_client",
    "//src/vista:vista",
    "//third_party:gdal",
  ]
  libs = [
    "gdiplus.lib",
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("scene3d") {
  public_deps = [ "//src/scenic:scenic_copy_all" ]
}

test("scenic_dem_stereo_test") {
  output_name = "scenic_dem_stereo_test"
  sources = [ "test/dem_stereo_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/scenic:scenic_impl",
    "//src/vista:vista",
    "//src/base/math:bounds",
    "//third_party:gdal",
  ]
}

# Public china_dem → XYZRGB load gate for PointCloud3d.
test("scenic_pointcloud_load_test") {
  output_name = "scenic_pointcloud_load_test"
  sources = [ "test/pointcloud_load_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/scenic:scenic_impl",
    "//src/vista:vista",
    "//testing/data:china_map_samples",
  ]
}
