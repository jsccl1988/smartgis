import("//build/smartgis.gni")

# GDI+ AA text / process token — used by all rhi2d ports for anno.
source_set("aa_sources") {
  sources = [
    "aa/gdiplus.cpp",
    "aa/gdiplus.h",
  ]
  configs += [
    "//build:legacy",
    "//src/scenic:scenic_impl_exports",
  ]
  defines = [ "_USRDLL" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    # Import ogr_bytes_* from gis.dll (do not link ogr_text_encoding.obj).
    "//src/gis:gis",
  ]
  libs = [ "gdiplus.lib" ]
}
