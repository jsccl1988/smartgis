source_set("render_gdi_sources") {
  public_deps = [ ":rhi2d_gdi_backend_sources" ]
}

group("render_gdi") {
  public_deps = [ "//src/scenic:scenic_rhi2d_gdi" ]
}

group("gdi_common_sources") {
  public_deps = [ ":rhi2d_common_sources" ]
}

