# Shared leftover rhi2d host tree (neutral names). Port DLLs add create_backend.cc
# only — runtime selection is Renderer2d::CreateDevice(chAPI) LoadLibrary.
source_set("rhi2d_common_sources") {
  sources = [
    "surface/composer/composer.cc",
    "surface/composer/composer.h",
    "surface/composer/submit.cc",
    "surface/composer/submit.h",
    "surface/dib/dib.h",
    "surface/dib/owned.cc",
    "surface/dib/owned.h",
    "surface/dib/pool.cc",
    "surface/dib/pool.h",
    "paint/carto/frame/carto_frame.cc",
    "paint/carto/frame/carto_frame.h",
    "paint/backend/paint_backend.h",
  ]
  configs += [
    "//build:legacy",
    "//src/scenic:scenic_impl_exports",
  ]
  defines = [ "_USRDLL" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/base/math:math",
    # Prefer gis.dll import for ogr_bytes_* (avoid LNK2005 vs ogr_text_encoding.obj).
    "//src/gis:gis",
    "//src/gpu:compositor_cpu_blend",
    "//third_party:CxImage",
    "//src/scenic/render/rhi2d/impl/gdiplus:aa_sources",
  ]
}

