template("rhi2d_device_port_sources") {
  source_set(target_name) {
    sources = _rhi2d_device_tree_sources + invoker.port_sources
    configs += [ "//build:legacy" ]
    defines = [
      "_USRDLL",
      "LEGACY_RHI2D_DEVICE_EXPORTS",
    ]
    include_dirs += [ "//src" ]
    deps = [
      ":rhi2d_common_sources",
      # Headers from scenic/detail; Style/err symbols come from scenic_impl
      # (do not also link :scenic_detail — LNK2005 vs scenic_impl_d.dll.lib).
      "//src/scenic:scenic_impl",
      "//src/gis/geo:geo",
      "//src/plugin/product/world3d:world3d_orthogrid_lattice",
      "//src/base:base",
      "//src/base:core",
      "//src/base/math:math",
      "//src/gis:gis",
      "//src/gis/datasource/ogr:ogr_codec_client",
      "//third_party:CxImage",
      "//third_party:gdal",
      "//src/scenic/render/rhi2d/impl/gdiplus:aa_sources",
    ]
    libs = [
      "gdi32.lib",
      "user32.lib",
      "gdiplus.lib",
    ]
  }
}

rhi2d_device_port_sources("rhi2d_gdi_backend_sources") {
  port_sources = [
    "../gdi/backend/gdi_backend.cc",
    "../gdi/backend/gdi_backend.h",
    "../gdi/create_backend.cc",
    "../gdi/traits.h",
