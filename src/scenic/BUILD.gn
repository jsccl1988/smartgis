# Layer lock (product Scenic vs copy backends vs main GIS stack):
#   1) //src/scenic:scenic  — façade DLL (namespace scenic). Public
#      umbrellas at root (engine.h, scenic_export.h). Engine stubs in
#      engine/. May dep product //src/gis. No content/app/leftover.
#      Product C++23 defaults — not //build:legacy. Not in src_all.
#   2) scenic::detail        — Map2d/Scene3d/Null in engine/ + copy
#      backends. No scenic/detail/ dump dir.
#   3) scenic_copy_all       — render/{rhi2d,rhi3d} + scene3d copy.
#      Shared copy headers: render/{err,frame,scenic_impl_export}.h
#      (geom/math retired → base/math).
#      Opt-in. May dep gis/vista/gdal. Not in src_all. Not a second public API.
# Living: docs/superpowers/specs/2026-09-13-render-rhi-scene-design.md §Scenic.

import("//build/smartgis.gni")
import("//testing/test.gni")

config("scenic_impl_exports") {
  defines = [ "SCENIC_IMPL_EXPORTS" ]
}

config("scenic_render_gl_exports") {
  defines = [ "SCENIC_RENDER_GL_EXPORTS" ]
}

config("scenic_render_d3d_exports") {
  defines = [ "SCENIC_RENDER_D3D_EXPORTS" ]
}

# Product façade may use //src/gis; must not pull leftover / content / app /
# copy engines. vista/render stay optional (façade stubs today).
_scenic_product_assert_no_deps = [
  "//src/content:*",
  "//src/content/*",
  "//src/app:*",
  "//src/app/*",
  "//src/tool:*",
  "//src/tool/*",
  "//src/plugin:*",
  "//src/plugin/*",
  "//src/vista:*",
  "//src/vista/*",
  "//src/render:*",
  "//src/render/*",
  ":scenic_impl",
  ":scenic_copy_all",
  ":scenic_rhi2d_gdi",
  ":scenic_rhi2d_gdiplus",
  ":scenic_rhi2d_skia",
  ":scenic_render_gl",
  ":scenic_render_d3d",
  "//src/scenic/render:*",
  "//src/scenic/render/*",
  "//src/scenic/scene3d:*",
  "//src/scenic/scene3d/*",
]

# Product DLL: façade TUs compile here so SCENIC_EXPORTS → dllexport.
# Do not split them into a source_set (parent defines do not apply; vtable
# / default virtuals become dllimport and the DLL fails to link).
# Default C++23 configs — not product_shared_library / //build:legacy.
shared_library("scenic") {
  if (is_debug) {
    output_name = "scenic_d"
  } else {
    output_name = "scenic"
  }
  defines = [
    "SCENIC_EXPORTS",
    "_USRDLL",
  ]
  sources = [
    "engine.h",
    "engine/map2d_engine.cc",
    "engine/mem_frame.h",
    "engine/null_engine.cc",
    "engine/scene3d_engine.cc",
    "scenic_export.h",
  ]
  include_dirs += [ "//src" ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
  assert_no_deps = _scenic_product_assert_no_deps
}

test("scenic_engine_test") {
  output_name = "scenic_engine_test"
  sources = [ "engine/engine_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":scenic" ]
  assert_no_deps = _scenic_product_assert_no_deps
}

group("scenic_test_all") {
  testonly = true
  deps = [ ":scenic_engine_test" ]
}

# Transitional copy of leftover/render (may dep leftover GIS / gis.dll). Opt-in.
product_shared_library("scenic_impl") {
  dll_stem = "scenic_impl"
  defines = [ "SCENIC_IMPL_EXPORTS" ]
  # Ban content/app. leftover/gis and leftover/plugin remain until those
  # seams finish moving; dual-run leftover/render leftover/ui leftover/app leftover/tool are gone.
  assert_no_deps = [
    "//src/content:*",
    "//src/content/*",
    "//src/app:*",
    "//src/app/*",
    ":scenic",
  ]
  deps = [
    "//src/scenic/render/rhi2d:rhi2d_sources",
    "//src/scenic/render/rhi2d/impl/common:gdi_common_sources",
    "//src/scenic/render/rhi3d:rhi_sources",
    "//src/scenic/scene3d:scene3d_sources",
    "//src/render:render",
  ]
  public_deps = [
    "//src/base:base",
    "//src/base/math:math",
    "//third_party:gdal",
    "//third_party:CxImage",
  ]
}

product_shared_library("scenic_rhi2d_gdi") {
  dll_stem = "scenic_rhi2d_gdi"
  defines = [ "SCENIC_RHI2D_DEVICE_EXPORTS" ]
  deps = [
    ":scenic_impl",
    "//src/scenic/render/rhi2d/impl/common:rhi2d_gdi_backend_sources",
  ]
}

product_shared_library("scenic_rhi2d_gdiplus") {
  dll_stem = "scenic_rhi2d_gdiplus"
  defines = [ "SCENIC_RHI2D_DEVICE_EXPORTS" ]
  deps = [
    ":scenic_impl",
    "//src/scenic/render/rhi2d/impl/common:rhi2d_gdiplus_backend_sources",
  ]
}

product_shared_library("scenic_rhi2d_skia") {
  dll_stem = "scenic_rhi2d_skia"
  defines = [ "SCENIC_RHI2D_DEVICE_EXPORTS" ]
  deps = [
    ":scenic_impl",
    "//src/scenic/render/rhi2d/impl/common:rhi2d_skia_backend_sources",
  ]
}

product_shared_library("scenic_render_gl") {
  dll_stem = "scenic_render_gl"
  defines = [ "SCENIC_RENDER_GL_EXPORTS" ]
  deps = [
    ":scenic_impl",
    "//src/scenic/render/rhi3d/impl/gl:gl_sources",
  ]
  libs = [
    "opengl32.lib",
    "glu32.lib",
  ]
}

product_shared_library("scenic_render_d3d") {
  dll_stem = "scenic_render_d3d"
  defines = [ "SCENIC_RENDER_D3D_EXPORTS" ]
  deps = [
    ":scenic_impl",
    "//src/scenic/render/rhi3d/impl/d3d:d3d_sources",
  ]
  libs = [
    "d3d11.lib",
    "dxgi.lib",
    "d3dcompiler.lib",
  ]
}

group("scenic_copy_all") {
  public_deps = [
    ":scenic_impl",
    ":scenic_rhi2d_gdi",
    ":scenic_rhi2d_gdiplus",
    ":scenic_rhi2d_skia",
    ":scenic_render_gl",
    ":scenic_render_d3d",
  ]
}
