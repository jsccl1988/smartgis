import("//build/smartgis.gni")
import("//testing/test.gni")

# GEOS 3.13 Delaunay (geos_c) via //third_party:gdal. Runtime DLLs match
# the shared third_party install prefix so geos_c.dll / geos.dll sit
# next to the exe.
smt_shared_library("tin") {
  dll_stem = "tin"
  defines = [ "TIN_EXPORTS" ]
  sources = [
    "tin_api.cpp",
    "tin_geos_backend.cpp",
    "xyz_points.cc",
  ]
  public_deps = [ "//src/render/math:math" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//third_party:gdal",
  ]
}

test("tin_delaunay_test") {
  output_name = "tin_delaunay_test"
  sources = [ "tin_delaunay_test.cc" ]
  include_dirs += [
    "//src/algorithm/tin",
    "//src/algorithm/geo",
    "//src/render/math",
    "//src",
  ]
  deps = [
    ":tin",
    "//src/algorithm/geo:geo",
    "//src/base:core",
    "//src/render/math:math",
    "//third_party:gdal",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}

test("tin_xyz_test") {
  output_name = "tin_xyz_test"
  sources = [ "tin_xyz_test.cc" ]
  include_dirs += [
    "//src/algorithm/tin",
    "//src/render/math",
    "//src",
  ]
  deps = [
    ":tin",
    "//src/base:core",
    "//src/render/math:math",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}
