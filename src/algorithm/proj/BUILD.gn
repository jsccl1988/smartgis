import("//build/smartgis.gni")
import("//testing/test.gni")

# PROJ 9 comes from //third_party:gdal (public_deps :PROJ; copies
# proj.db / runtime DLLs next to out/). Do not vendor a second PROJ.
smt_shared_library("proj") {
  dll_stem = "proj"
  defines = [ "PROJ_EXPORTS" ]
  sources = [
    "proj_backend.cc",
    "proj_runtime.cpp",
    "projection.cpp",
  ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//third_party:gdal",
  ]
  if (is_debug) {
    libs += [ "proj_d.lib" ]
  } else {
    libs += [ "proj.lib" ]
  }
}

test("proj_test") {
  output_name = "proj_test"
  sources = [ "proj_test.cpp" ]
  include_dirs += [
    "//src/algorithm/proj",
    "//src/base/core",
    "//src",
  ]
  deps = [
    ":proj",
    "//src/base:core",
    "//third_party:gdal",
  ]
  data_deps = [ "//third_party:gdal_runtime_dlls" ]
}
