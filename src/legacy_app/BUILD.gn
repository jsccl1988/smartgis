import("//build/smartgis.gni")

# Leftover MFC desktop exe. Output name stays SmartGis.exe. Not in //src:src_all.
smt_mfc_executable("app") {
  output_name = "SmartGis"
  # Match #include "legacy_app/stdafx.h" under -I../src (MSVC /Yc name must match).
  precompiled_header = "legacy_app/stdafx.h"
  sources = [
    "child_frame.cpp",
    "main_frame.cpp",
    "smart_3d_view.cpp",
    "smart_data_source_view.cpp",
    "smart_gis.cpp",
    "smart_gis.rc",
    "smart_gis_doc.cpp",
    "smart_gis_view.cpp",
    "smart_map_edit_view.cpp",
    "stdafx.cpp",
  ]
  deps = [
    "//src/legacy_app/app_core:app_core",
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/legacy_render/model3d:model3d",
    "//src/plugin:plugin",
    "//src/legacy_render/bridge:render",
    "//src/legacy_render/render3d:render3d",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/legacy_render/scene3d:scene3d",
    "//src/sys:sys",
    "//src/legacy_tool:tool",
    "//src/legacy_tool/group:tool_group",
    "//src/legacy_ui/gui:gui",
    "//src/legacy_ui/mfc_ex:mfc_ex",
    "//src/legacy_ui/xambox:xambox",
    "//src/legacy_ui/xcatalog:xcatalog",
    "//src/legacy_ui/xview:xview",
  ]
}

group("legacy_app_all") {
  public_deps = [ ":app" ]
}
