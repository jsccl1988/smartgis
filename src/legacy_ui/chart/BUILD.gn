import("//build/smartgis.gni")

# Stat chart dialogs. Compiled into //src/legacy_ui:ui_legacy (no separate CWinApp).
source_set("stat_chart_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "STAT_CHART_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "dlg_2d_x_chart_view.cpp",
    "diagram.rc",
    "chart_api.cpp",
    "chart.cpp",
    "diagramdata.cpp",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/stat:stat",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/sdb/map:gis",
    "//src/sys:sys",
    "//third_party:gdal",
  ]
}

group("stat_chart") {
  public_deps = [ "//src/legacy_ui:ui_legacy" ]
}
