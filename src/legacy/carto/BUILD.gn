import("//build/smartgis.gni")

# Leftover cartographic pen/brush/StyleManager (NOT MapLibre Style JSON —
# that is //src/gis/present/style). Envelope lives in //src/gis/model/envelope.h.
#
# Compiled into the product base DLL (//src/base:base, dll_stem=base) so
# gis::style::to_smt_style and leftover render/tool/ui keep one PE import.

source_set("carto_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "BASE_EXPORTS=1",
  ]
  sources = [
    "style_api.cpp",
    "style.cpp",
    "stylemanager.cpp",
    "styletable.cpp",
  ]
  include_dirs += [ "//src" ]
}

group("carto") {
  public_deps = [ "//src/base:base" ]
}
