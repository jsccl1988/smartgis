import("//build/smartgis.gni")

# Leftover Smt core is header-only (util / listener / command / msg / diag).
# Still absorbed as a public face of //src/base:base for include/deps hygiene.
# CxImage is required by util/image.h consumers (their targets must dep it).

source_set("core_sources") {
  configs += [ "//build:legacy" ]
  deps = [ "//src/base:foundation" ]
  # No translation units — all headers.
  sources = []
}

group("core") {
  public_deps = [ "//src/base:base" ]
}
