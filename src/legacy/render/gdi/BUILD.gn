import("//build/smartgis.gni")
import("//testing/test.gni")

# Shared GDI helpers (aux / bufpool / renderbuf). Compiled once into the
# legacy_render DLL; gdi + gdi_simple devices both use these objects.
source_set("gdi_common_sources") {
  sources = [
    "gdi_aux_api.cpp",
    "gdi_bufpool.cpp",
    "gdi_gdiplus.cpp",
    "gdi_gdiplus.h",
    "gdi_renderbuf.cpp",
    "map_carto2d.cc",
    "map_carto2d.h",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gis/datasource/gdal:ogr_text_encoding",
    "//third_party:CxImage",
  ]
  libs = [ "gdiplus.lib" ]
}

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
source_set("render_gdi_sources") {
  sources = [
    "gdi_renderdevice.cpp",
    "gdi_renderthread.cpp",
    "gdi_renderthread_draw.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    ":gdi_common_sources",
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/bridge:leftover_record",
    "//src/legacy/render/bridge:render_sources",
    "//src/gis/datasource/gdal:ogr_codec",
    "//src/gis/map:gis",
    "//third_party:CxImage",
    "//third_party:gdal",
  ]
}

group("render_gdi") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

test("map_carto2d_test") {
  output_name = "map_carto2d_test"
  sources = [
    "map_carto2d.cc",
    "map_carto2d_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
}

# Hidden HWND + china_plp.geojson → GDI realtime paint must produce pixels.
test("gdi_map_paint_test") {
  output_name = "gdi_map_paint_test"
  sources = [ "gdi_map_paint_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/gis/datasource/gdal:ogr_codec",
    "//src/gis/map:gis",
    "//testing/data:china_map_samples",
    "//third_party:gdal",
  ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
}
