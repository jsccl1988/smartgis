import("//build/smartgis.gni")

# Shared GDI helpers (aux / bufpool / renderbuf). Compiled once into the
# legacy_render DLL; gdi + gdi_simple devices both use these objects.
source_set("gdi_common_sources") {
  sources = [
    "gdi_aux_api.cpp",
    "gdi_bufpool.cpp",
    "gdi_renderbuf.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
  ]
}

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
source_set("render_gdi_sources") {
  sources = [
    "gdi_renderdevice.cpp",
    "gdi_renderthread.cpp",
    "gdi_renderthread_draw.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    ":gdi_common_sources",
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/bridge:leftover_record",
    "//src/legacy/render/bridge:render_sources",
    "//src/sdb/datasource/gdal:ogr_codec",
    "//src/sdb/map:gis",
    "//third_party:CxImage",
    "//third_party:gdal",
  ]
}

group("render_gdi") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}
