import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
# Layout: scene/ index/ primitive/{mesh,feature,surface}/ seed/ test/.
# Device-free DEM/World: //src/legacy/gis/vista; feature tess: //src/legacy/gis/feature.
source_set("scene3d_sources") {
  sources = [
    "scene/scene.cpp",
    "scene/object.cc",
    "scene/object.h",
    "scene/stereo_hwnd_view.cc",
    "scene/stereo_hwnd_view.h",
    "scene/d3d_deferred_objects.h",
    "index/octree.cpp",
    "index/vertex_octree.cpp",
    "seed/map_to_scene.cc",
    "seed/map_to_scene.h",
    "seed/scene_to_world.cc",
    "seed/scene_to_world.h",
    "primitive/mesh/cube.cpp",
    "primitive/mesh/northarray.cpp",
    "primitive/mesh/sphere.cpp",
    "primitive/mesh/water.cpp",
    "primitive/feature/geo_object.cc",
    "primitive/feature/geo_object.h",
    "primitive/feature/map_label_batch.cc",
    "primitive/feature/map_label_batch.h",
    "primitive/surface/surface_base.cc",
    "primitive/surface/surface_base.h",
    "primitive/surface/pointcloud.cpp",
    "primitive/surface/pointcloud.h",
    "primitive/surface/terrain.cpp",
    "primitive/surface/terrain.h",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  # NOMINMAX: unibn Octree.hpp uses std::max; windows.h max macros break it.
  defines = [
    "_USRDLL",
    "NOMINMAX",
  ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/gis/kernel/tin:tin",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/rhi2d/impl/common:gdi_common_sources",
    "//src/legacy/render/rhi3d:rhi_sources",
    "//src/base/math:bounds",
    "//src/legacy/gis/present/carto:carto",
    "//src/legacy/gis/vista:vista",
    "//src/legacy/gis/feature:feature",
    "//src/gis/datasource/provider/impl/ogr:ogr_codec_client",
    "//src/gis/vista/world:world",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  libs = [
    "gdiplus.lib",
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("scene3d") {
  public_deps = [ "//src/legacy/render:legacy_render_all" ]
}

test("dem_stereo_test") {
  output_name = "dem_stereo_test"
  sources = [ "test/dem_stereo_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/legacy/gis/vista:vista",
    "//src/gis/vista/world:world",
    "//src/base/math:bounds",
    "//third_party:gdal",
  ]
}

# Public china_dem → XYZRGB load gate for leftover Smt3DPointCloud.
test("pointcloud_load_test") {
  output_name = "pointcloud_load_test"
  sources = [ "test/pointcloud_load_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/legacy/gis/vista:vista",
    "//testing/data:china_map_samples",
  ]
}
