import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
source_set("scene3d_sources") {
  sources = [
    "bl3d_scene.cpp",
    "bl3d_sceneocttree.cpp",
    "bl3d_sceneocttreenode.cpp",
    "bl3d_vertexocttree.cpp",
    "bl3d_vertextreenode.cpp",
    "dem_height_field.cc",
    "dem_height_field.h",
    "dem_to_world.cc",
    "dem_to_world.h",
    "map_label_batch.cc",
    "map_label_batch.h",
    "map_to_scene.cc",
    "map_to_scene.h",
    "scene_to_world.cc",
    "scene_to_world.h",
    "stereo_hwnd_view.cc",
    "stereo_hwnd_view.h",
    "stereo_terrain.cc",
    "stereo_terrain.h",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:core",
    "//src/legacy/render/gdi:gdi_common_sources",
    "//src/legacy/render/model3d:model3d_sources",
    "//src/legacy/render/render3d:render3d_sources",
    "//src/render/math:bounds",
    "//src/base/carto:carto",
    "//src/gis/datasource/gdal:ogr_codec",
    "//src/gis/world:world",
    "//third_party:gdal",
  ]
  libs = [
    "gdiplus.lib",
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("scene3d") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

test("dem_stereo_test") {
  output_name = "dem_stereo_test"
  sources = [ "dem_stereo_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/gis/world:world",
    "//src/render/math:bounds",
    "//third_party:gdal",
  ]
}
