import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
# Layout (B, colocated, P2.4 + SP4b): scene/ index/ primitive/ feature/
# surface/ dem/ bridge/ test/.
source_set("scene3d_sources") {
  sources = [
    "scene/scene.cpp",
    "index/octree.cpp",
    "index/octree_node.cpp",
    "index/vertex_octree.cpp",
    "index/vertex_octree_node.cpp",
    "dem/dem_height_field.cc",
    "dem/dem_height_field.h",
    "dem/dem_to_world.cc",
    "dem/dem_to_world.h",
    "dem/stereo_hwnd_view.cc",
    "dem/stereo_hwnd_view.h",
    "dem/stereo_terrain.cc",
    "dem/stereo_terrain.h",
    "bridge/map_label_batch.cc",
    "bridge/map_label_batch.h",
    "bridge/map_to_scene.cc",
    "bridge/map_to_scene.h",
    "bridge/scene_to_world.cc",
    "bridge/scene_to_world.h",
    "primitive/cube.cpp",
    "primitive/northarray.cpp",
    "primitive/sphere.cpp",
    "primitive/water.cpp",
    "feature/2dgeoobject.cpp",
    "feature/3dgeoobject.cpp",
    "surface/pointcloud.cpp",
    "surface/terrain.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  # NOMINMAX: unibn Octree.hpp uses std::max; windows.h max macros break it.
  defines = [
    "_USRDLL",
    "NOMINMAX",
  ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/gis/kernel/tin:tin",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/rhi2d/impl/gdi:gdi_common_sources",
    "//src/legacy/render/rhi3d:rhi_sources",
    "//src/base/math:bounds",
    "//src/base/carto:carto",
    "//src/gis/datasource/ogr:ogr_codec",
    "//src/gis/vista/world:world",
    "//third_party:gdal",
    "//third_party:octree",
  ]
  libs = [
    "gdiplus.lib",
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("scene3d") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

test("dem_stereo_test") {
  output_name = "dem_stereo_test"
  sources = [ "test/dem_stereo_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/gis/vista/world:world",
    "//src/base/math:bounds",
    "//third_party:gdal",
  ]
}
