  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gpu:compositor_cpu_blend",
    "//third_party:CxImage",
  ]
  libs = [
    "gdi32.lib",
    "user32.lib",
    "Msimg32.lib",
  ]
}

