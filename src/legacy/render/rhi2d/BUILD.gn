import("//build/smartgis.gni")

# Leftover 2D abstract API (SmtRenderDevice / SmtRenderer).
# Compiled into //src/legacy/render:legacy_render.
# Layout mirrors rhi/: header-only public/device + impl/gdi; DLL bodies in detail/.
source_set("rhi2d_sources") {
  sources = [ "detail/renderer.cpp" ]
  include_dirs += [ "//src" ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/gis/model/map:gis",
  ]
}

group("rhi2d") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}
