import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
source_set("render_gl_sources") {
  sources = [
    "gl_3drenderdevice.cpp",
    "gl_devicecaps.cpp",
    "gl_extinterface.cpp",
    "gl_fbofunc.cpp",
    "gl_fbofuncimp.cpp",
    "gl_indexbuffer.cpp",
    "gl_mipmapfunc.cpp",
    "gl_mipmapfuncimp.cpp",
    "gl_multitexturefuncimp.cpp",
    "gl_mutitexturefunc.cpp",
    "gl_rdev_effect.cpp",
    "gl_rdev_fastdraw.cpp",
    "gl_rdev_fbo.cpp",
    "gl_rdev_font.cpp",
    "gl_rdev_misc.cpp",
    "gl_rdev_mtx.cpp",
    "gl_rdev_render.cpp",
    "gl_rdev_shader.cpp",
    "gl_rdev_textures.cpp",
    "gl_rdev_util.cpp",
    "gl_rdev_vba.cpp",
    "gl_rdev_vbo.cpp",
    "gl_shaderfunc.cpp",
    "gl_shaderfuncimp.cpp",
    "gl_statesmanager.cpp",
    "gl_text.cpp",
    "gl_vbofunc.cpp",
    "gl_vbofuncimp.cpp",
    "gl_vertexbuffer.cpp",
    "gl_vsyncfunc.cpp",
    "gl_vsyncfuncimp.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/bridge:leftover_record",
    "//src/legacy/render/bridge:render_sources",
    "//src/legacy/render/render3d:render3d_sources",
    "//third_party:CxImage",
    "//third_party:khronos_gl",
  ]
  libs = [
    "opengl32.lib",
    "glu32.lib",
  ]
}

group("render_gl") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

# Shown HWND + china_plp.geojson → leftover GL must produce non-black pixels.
test("gl_map_paint_test") {
  output_name = "gl_map_paint_test"
  sources = [ "gl_map_paint_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/sdb:sdb",
    "//testing/data:china_map_samples",
    "//third_party:gdal",
  ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
}
