import("//build/smartgis.gni")

# Optional leftover render engines ? one DLL (dll_stem = legacy_render).
# Not in //src:src_all. Opt-in: ninja -C out legacy_render / legacy_render_all

# Every TU in this DLL must see dllexport for sibling leftovers (avoids
# dllimport of locally-defined symbols when headers cross module lines).
# Do not define RENDER_EXPORTS here — that macro belongs to //src/render
# (render_d.dll / render_export.h). Sharing it made GpuScene inlines
# dllexport into leftover_session.obj and LNK2005 against render_d.dll.lib.
config("legacy_render_exports") {
  defines = [ "LEGACY_RENDER_EXPORTS" ]
}

smt_shared_library("legacy_render") {
  dll_stem = "legacy_render"
  defines = [ "LEGACY_RENDER_EXPORTS" ]
  deps = [
    "//src/legacy/render/rhi2d:rhi2d_sources",
    "//src/legacy/render/rhi2d/impl/gdi:render_gdi_sources",
    "//src/legacy/render/rhi3d:rhi_sources",
    "//src/legacy/render/rhi3d/impl/d3d:d3d_sources",
    "//src/legacy/render/rhi3d/impl/gl:gl_sources",
    "//src/legacy/render/scene3d:scene3d_sources",
    # RHI Device/CommandList (render_d.dll). GpuScene is caller-linked from
    # //src/effect/scene:scene_sources via leftover_record, not this DLL.
    "//src/render:render",
  ]
  public_deps = [
    "//src/base:base",
    "//src/base/math:math",
    "//third_party:gdal",
    # Public RHI headers inline SmtTexture::Load, which includes ximage.h.
    "//third_party:CxImage",
  ]
  libs = [
    "opengl32.lib",
    "glu32.lib",
    "d3d11.lib",
    "dxgi.lib",
  ]
}

group("legacy_render_all") {
  public_deps = [ ":legacy_render" ]
}
