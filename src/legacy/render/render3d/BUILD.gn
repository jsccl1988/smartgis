import("//build/smartgis.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
source_set("render3d_sources") {
  sources = [
    "3dmaterial.cpp",
    "3drenderer.cpp",
    "arbvcamera.cpp",
    "camera.cpp",
    "camera_factory.cpp",
    "color.cpp",
    "combinedcamera.cpp",
    "fpscamera.cpp",
    "framebuffer.cpp",
    "light.cpp",
    "orthcamera.cpp",
    "perspcamera.cpp",
    "program.cpp",
    "programmanager.cpp",
    "shader.cpp",
    "shadermanager.cpp",
    "statesmanager.cpp",
    "texture.cpp",
    "texturemanager.cpp",
    "videobuffer.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  public_deps = [ "//src/render/math:math" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//third_party:CxImage",
  ]
}

group("render3d") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}
