import("//build/smartgis.gni")

# Device only — shared aux/bufpool/renderbuf come from gdi:gdi_common_sources.
# Factory exports CreateGdiSimpleRenderDevice (not CreateRenderDevice) so both
# GDI devices can live in legacy_render.dll.
source_set("render_gdi_simple_sources") {
  sources = [ "gdi_simplerenderdevice.cpp" ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/algorithm/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/bridge:leftover_record",
    "//src/legacy/render/bridge:render_sources",
    "//src/legacy/render/gdi:gdi_common_sources",
    "//src/gis/datasource/gdal:ogr_codec",
    "//src/gis/map:gis",
    "//third_party:CxImage",
    "//third_party:gdal",
  ]
}

group("render_gdi_simple") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}
