import("//build/smartgis.gni")
import("//testing/test.gni")

# Shared leftover 3D FrameJob / prep helpers (GL + D3D ports).
source_set("common_frame_sources") {
  sources = [
    "frame/frame_request.h",
    "frame/prep_runner.cc",
    "frame/prep_runner.h",
    "frame/scheduler.cc",
    "frame/scheduler.h",
  ]
  include_dirs += [ "//src" ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
  ]
}

test("rhi3d_frame_scheduler_test") {
  output_name = "rhi3d_frame_scheduler_test"
  sources = [
    "frame/scheduler.cc",
    "frame/scheduler.h",
    "frame/frame_request.h",
    "test/frame_scheduler_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
  ]
  libs = [ "user32.lib" ]
}

test("rhi3d_prep_runner_test") {
  output_name = "rhi3d_prep_runner_test"
  sources = [
    "frame/prep_runner.cc",
    "frame/prep_runner.h",
    "test/prep_runner_test.cc",
  ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
  ]
}
