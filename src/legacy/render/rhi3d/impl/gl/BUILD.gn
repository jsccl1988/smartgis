import("//build/smartgis.gni")
import("//testing/test.gni")

# Compiled into //src/legacy/render:legacy_render (dll_stem = legacy_render).
# OpenGL leftover impl under rhi3d/impl/gl/ (parallel to impl/d3d/).
# Layout: host/resource/paint/caps/ext. File basenames drop the gl_ prefix
# (types/SmtGL* unchanged). Former label: //src/legacy/render/gl:render_gl_sources.
source_set("gl_sources") {
  sources = [
    "caps/device_caps.cpp",
    "ext/ext_interface.cpp",
    "ext/fbo_func.cpp",
    "ext/fbo_func_imp.cpp",
    "ext/mipmap_func.cpp",
    "ext/mipmap_func_imp.cpp",
    "ext/multitexture_func_imp.cpp",
    "ext/multitexture_func.cpp",
    "ext/shader_func.cpp",
    "ext/shader_func_imp.cpp",
    "ext/vbo_func.cpp",
    "ext/vbo_func_imp.cpp",
    "ext/vsync_func.cpp",
    "ext/vsync_func_imp.cpp",
    "host/render_device.cpp",
    "host/device_present.cpp",
    "paint/effect.cpp",
    "paint/fast_draw.cpp",
    "paint/misc.cpp",
    "paint/matrix.cpp",
    "paint/shader.cpp",
    "paint/util.cpp",
    "paint/vba.cpp",
    "paint/vbo.cpp",
    "paint/states_manager.cpp",
    "resource/buffer/index_buffer.cpp",
    "resource/buffer/vertex_buffer.cpp",
    "resource/frame_buffer.cpp",
    "resource/font.cpp",
    "resource/texture.cpp",
    "resource/text/text.cpp",
  ]
  configs += [
    "//build:legacy",
    "//src/legacy/render:legacy_render_exports",
  ]
  defines = [ "_USRDLL" ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/render/rhi3d:leftover_record",
    "//src/legacy/render/rhi2d:rhi2d_sources",
    "//src/legacy/render/rhi3d:rhi_sources",
    "//src/gis/datasource/provider/impl/ogr:ogr_text_encoding",
    "//third_party:CxImage",
    "//third_party:khronos_gl",
  ]
  libs = [
    "opengl32.lib",
    "glu32.lib",
  ]
}

# Compat alias for former //src/legacy/render/gl:render_gl_sources.
group("render_gl_sources") {
  public_deps = [ ":gl_sources" ]
}

group("render_gl") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

group("gl") {
  public_deps = [ "//src/legacy/render:legacy_render" ]
}

# Shown HWND + china_plp.geojson → leftover GL must produce non-black pixels.
test("gl_map_paint_test") {
  output_name = "gl_map_paint_test"
  sources = [ "test/map_paint_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//src/gis:gis",
    "//testing/data:china_map_samples",
    "//third_party:gdal",
  ]
  libs = [
    "gdi32.lib",
    "user32.lib",
  ]
}

# Hidden HWND: CreateTexture/Build/Bind + FBO clear/unbind + CreateFont/GetFrustum.
test("gl_texture_test") {
  output_name = "gl_texture_test"
  sources = [ "test/gl_texture_test.cc" ]
  include_dirs += [ "//src" ]
  configs = [ "//build:legacy" ]
  deps = [
    "//src/legacy/render:legacy_render",
    "//third_party:khronos_gl",
  ]
  libs = [
    "gdi32.lib",
    "user32.lib",
    "opengl32.lib",
    "glu32.lib",
  ]
}
