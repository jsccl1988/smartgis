import("//build/smartgis.gni")

# Feature Pack glue + sole AFX DllMain -> ui_legacy.
# dock/ and grid/ shims removed (Waves 1-2); Catalog/AMBox use Feature Pack
# types directly from app/shell and ambox/.
source_set("widgets_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "MFC_EX_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "widgets_core.cpp",
    "widgets.rc",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/legacy/sys:sys",
  ]
}

group("widgets") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

group("mfc_ex") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}