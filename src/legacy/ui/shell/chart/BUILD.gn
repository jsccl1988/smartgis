import("//build/smartgis.gni")

# Leftover stat chart dialogs → ui_legacy.
source_set("chart_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "STAT_CHART_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "view_dlg.cpp",
    "view_dlg.h",
    "chart.rc",
    "chart_api.cpp",
    "chart_api.h",
    "chart.cpp",
    "chart.h",
    "diagram_data.cpp",
    "diagram_data.h",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gis/kernel/stat:stat",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/gis/model/map:gis",
    "//src/legacy/sys:sys",
    "//third_party:CxImage",
    "//third_party:gdal",
  ]
}

# Historical alias.
group("stat_chart_sources") {
  public_deps = [ ":chart_sources" ]
}

group("stat_chart") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

group("chart") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}
