import("//build/smartgis.gni")

# MFC CView chrome + input dispatch → ui_legacy.
# Map HWND hosts compile via //src/legacy/ui/map:map_sources.
source_set("shell_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "XVIEW_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  sources = [
    "shell.rc",
    "stdafx.cpp",
    "input_dispatch.cc",
    "input_dispatch.h",
    "xview.cpp",
    "xview.h",
  ]
  include_dirs += [
    ".",
    "//src",
  ]
  deps = [
    "//src/content:view_host",
    "//src/base:base",
    "//src/base:core",
    "//src/plugin:plugin",
    "//src/plugin:cmd",
    "//src/legacy/tool:tool",
    "//src/tool:dispatch",
  ]
}

group("shell") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

group("xview") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}
