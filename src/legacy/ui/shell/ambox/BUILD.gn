import("//build/smartgis.gni")

# Aux-module / AM box dock panels.
source_set("ambox_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "XAMBOX_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "ambox.rc",
    "ambox_dock_bar.cpp",
    "ambox.cpp",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/plugin:plugin",
    "//src/legacy/sys:sys",
  ]
}

group("ambox") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

group("xambox") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}
