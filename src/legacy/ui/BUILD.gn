import("//build/smartgis.gni")

# MFC shell → one DLL (dll_stem = ui_legacy).
# B1 endgame vocabulary: shell/{ambox,chart} map inspect catalog dialogs widgets
# Resources: legacy/ui/res/{shell,shell/ambox,shell/chart,catalog,dialogs,widgets}/

smt_shared_library("ui_legacy") {
  dll_stem = "ui_legacy"
  configs = [ "//build:mfc" ]
  ldflags = [ "/FORCE:MULTIPLE" ]
  defines = [
    "UI_LEGACY_EXPORTS",
    "GUI_EXPORTS",
    "MFC_EX_EXPORTS",
    "XVIEW_EXPORTS",
    "XCATALOG_EXPORTS",
    "XAMBOX_EXPORTS",
    "STAT_CHART_EXPORTS",
    "TOOL_GROUP_EXPORTS",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
  ]
  deps = [
    "//src/legacy/ui/widgets:widgets_sources",
    "//src/legacy/ui/dialogs:dialogs_sources",
    "//src/legacy/ui/shell/ambox:ambox_sources",
    "//src/legacy/ui/catalog:catalog_sources",
    "//src/legacy/ui/shell:shell_sources",
    "//src/legacy/ui/shell/chart:stat_chart_sources",
    "//src/legacy/tool:tool_group_sources",
    "//src/gis:gis",
  ]
  public_deps = [ "//third_party:CxImage" ]
}

group("ui") {
  public_deps = [ ":ui_legacy" ]
}

group("legacy_ui_all") {
  public_deps = [ ":ui_legacy" ]
}
