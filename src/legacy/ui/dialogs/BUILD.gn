import("//build/smartgis.gni")

# Leftover MFC modals + dialogs_api → ui_legacy (§11i).
# toolkit/ ≈ ui/views/dialogs; gis/ ≈ ui/gis/{catalog,inspect} modals; detail/ helpers.
source_set("dialogs_sources") {
  configs += [
    "//build:legacy",
    "//build:mfc",
  ]
  defines = [
    "_USRDLL",
    "_AFXDLL",
    "_AFX_NO_DAO_SUPPORT",
    "_AFXEXT",
    "GUI_EXPORTS",
  ]
  precompiled_header = "stdafx.h"
  precompiled_source = "stdafx.cpp"
  include_dirs += [ "." ]
  sources = [
    "dialogs_api.cpp",
    "detail/feature_info_grid.cpp",
    "gis/att_struct_dialog.cpp",
    "gis/feature_info_dialog.cpp",
    "toolkit/input_text_dialog.cpp",
    "toolkit/select_one_dialog.cpp",
    "dialogs.rc",
    "stdafx.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gis/kernel/geo:geo",
    "//src/gis/model/map:gis",
    "//src/legacy/sys:sys",
    "//third_party:gdal",
  ]
}

group("dialogs") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}

group("gui") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}
