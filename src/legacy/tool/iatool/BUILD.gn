import("//build/smartgis.gni")

# Leftover SmtIATool / manager / t_msg — compiled into legacy_tool DLL.
source_set("tool_sources") {
  sources = [
    "t_iatool.cpp",
    "t_iatoolmanager.cpp",
    "t_msg.cpp",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "TOOL_EXPORTS",
  ]
  deps = [ "//src/base:core" ]
}
