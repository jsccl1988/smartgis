import("//build/smartgis.gni")

# GT_MSG_* → tool::Workspace command ids. source_set only (not legacy_tool DLL).
# Lives under legacy/tool/msg so endgame src/tool stays free of leftover maps.
# Label is //src/legacy/tool/msg:adapter — outside //src/legacy/tool:*
# assert_no_deps on src_all / Views (those patterns cover the parent package only).
# Public API stays namespace tool (callers already use tool::try_execute_gt_msg).

source_set("adapter") {
  sources = [
    "msg.cc",
    "msg.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/tool:command",
    "//src/tool:workspace",
  ]
}

# One-round stable alias for prior //src/legacy/tool/adapter:adapter callers.
group("msg") {
  public_deps = [ ":adapter" ]
}
