import("//build/smartgis.gni")

# Compiled into //src/legacy/ui:ui_legacy (avoids a leftover_tool → ui_legacy cycle).
source_set("tool_group_sources") {
  sources = [
    "base/base3dtool.cpp",
    "base/basetool.cpp",
    "factory/grouptoolfactory.cpp",
    "input/appendfeaturetool.cpp",
    "input/inputlinetool.cpp",
    "input/inputpointtool.cpp",
    "input/inputregiontool.cpp",
    "select/flashtool.cpp",
    "select/selecttool.cpp",
    "view/3dviewctrltool.cpp",
    "view/viewctrltool.cpp",
  ]
  include_dirs += [ "//src" ]
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    # Same DLL as gui: UI_LEGACY_EXPORTS so gui calls are not dllimport.
    "UI_LEGACY_EXPORTS",
  ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    # Groups → legacy_render DLL (do not dep *_sources or objects double-link).
    "//src/legacy/render/rhi2d:rhi2d",
    "//src/legacy/render/scene3d:scene3d",
    "//src/legacy/render/rhi3d:rhi",
    # IA tools live in leftover_tool.dll; this source_set is compiled into
    # ui_legacy. Dep the DLL group, not tool_sources (avoids double-link).
    "//src/legacy/tool:tool",
    "//src/gis/datasource/ogr:ogr_codec",
    "//src/gis/datasource/mgr:sde_mgr",
    "//src/gis/model/edit:map_edit",
    "//src/gis/model/map:gis",
    "//src/legacy/sys:sys",
    "//src/legacy/tool/adapter:adapter",
    "//src/tool:dispatch",
    "//third_party:CxImage",
    "//third_party:gdal",
    # Tools include legacy/ui/gui/gui_api.h; same DLL as gui via //src/legacy/ui:ui_legacy.
  ]
}

group("tool_group") {
  public_deps = [ "//src/legacy/ui:ui_legacy" ]
}
