import("//build/smartgis.gni")

# 2010 Orthogrid class (CreateOrthGrid / CvtToGrid / LoadGridBndFromFile).
# Laplace stays in //src/plugin/product/orthogrid and is compiled here so the
# DLL does not depend on orthogrid_views.
source_set("orthogrid_kernel") {
  sources = [
    "kernel/curve.cpp",
    "kernel/detail/polyline.cpp",
    "kernel/grid.cpp",
    "kernel/grid_create.cpp",
    "kernel/grid_modify.cpp",
    "kernel/region.cpp",
    "//src/plugin/product/orthogrid/detail/laplace_solver.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/gis/kernel/geo:geo",
    "//src/base:base",
    "//src/base:core",
    "//src/gis/model/map:gis",
    "//third_party:eigen",
  ]
}

smt_mfc_shared_library("plugin_orthogrid") {
  dll_stem = "plugin_orthogrid"
  am_plugin = true
  precompiled_header = "stdafx.h"
  precompiled_source = "shell/stdafx.cpp"
  sources = [
    "shell/creater.cpp",
    "shell/creater.rc",
    "shell/plug.cpp",
    "shell/stdafx.cpp",
  ]
  include_dirs += [
    ".",
    "shell",
    "//src/legacy/plugin/product/orthogrid",
    "//src",
  ]
  deps = [
    ":orthogrid_kernel",
    "//src/gis/kernel/geo:geo",
    "//src/base:core",
    "//src/legacy/plugin/runtime:cmd",
    "//src/legacy/plugin:plugin",
    "//src/legacy/tool:tool",
    "//src/legacy/tool:tool_group",
    "//src/legacy/ui/catalog:xcatalog",
    "//src/legacy/ui/shell:xview",
    "//src/legacy/sys:sys",
    "//third_party:eigen",
  ]
}
