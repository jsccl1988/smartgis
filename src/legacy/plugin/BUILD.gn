import("//build/smartgis.gni")

# Leftover AuxModule runtime DLL (SmtAuxModule / dll_stem plugin).
smt_shared_library("plugin") {
  dll_stem = "plugin"
  defines = [ "PLUGIN_EXPORTS" ]
  sources = [
    "runtime/auxmodule/module.cpp",
    "runtime/auxmodule/module_manager.cpp",
    "runtime/auxmodule/plugin_msg.cpp",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:core" ]
}

# MFC *.am plugins for SmartGis.exe (out/plugin/<stem>[_d].am).
group("am_plugins") {
  deps = [
    "//src/legacy/plugin/product/dem:plugin_dem",
    "//src/legacy/plugin/product/model3d:plugin_model3d",
    "//src/legacy/plugin/product/orthogrid:plugin_orthogrid",
    "//src/legacy/plugin/product/print:plugin_print",
    "//src/legacy/plugin/product/proj:plugin_proj",
  ]
}
