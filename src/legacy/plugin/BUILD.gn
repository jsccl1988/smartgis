import("//build/smartgis.gni")

# Leftover AuxModule runtime DLL (SmtAuxModule / dll_stem plugin).
smt_shared_library("plugin") {
  dll_stem = "plugin"
  defines = [ "PLUGIN_EXPORTS" ]
  sources = [
    "module.cpp",
    "module_manager.cpp",
    "plugin_msg.cpp",
  ]
  include_dirs += [ "//src" ]
  deps = [ "//src/base:core" ]
}

# MFC *.am plugins for SmartGis.exe (out/plugin/<stem>[_d].am).
group("am_plugins") {
  deps = [
    "//src/legacy/plugin/dem:plugin_dem",
    "//src/legacy/plugin/model3d:plugin_model3d",
    "//src/legacy/plugin/orthogrid:plugin_orthogrid",
    "//src/legacy/plugin/print:plugin_print",
    "//src/legacy/plugin/proj:plugin_proj",
  ]
}
