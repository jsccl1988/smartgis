import("//build/smartgis.gni")

# Leftover MFC app core DLL (dll_stem stays app_core). Source: core/smtapp.cpp.
# Layout: core/ (SmtApp) + shell/ (CWinApp/frames) + doc/ + view/ (thin CView) +
# res/ + root PCH/RC. GN labels :app :app_core :legacy_app_all stay frozen.
smt_shared_library("app_core") {
  dll_stem = "app_core"
  defines = [ "APP_CORE_EXPORTS" ]
  sources = [ "core/smtapp.cpp" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/content:map_bootstrap",
    "//src/gis/kernel/geo:geo",
    "//src/gis/model/map:gis",
    "//src/plugin:plugin",
    "//src/gis/datasource/mgr:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/ui/xcatalog:xcatalog",
  ]
}

# Leftover MFC desktop exe. Output name stays SmartGis.exe. Not in //src:src_all.
smt_mfc_executable("app") {
  output_name = "SmartGis"
  # Match #include "legacy/app/stdafx.h" under -I../src (MSVC /Yc name must match).
  precompiled_header = "legacy/app/stdafx.h"
  sources = [
    "shell/child_frame.cpp",
    "shell/main_frame.cpp",
    "shell/smart_gis.cpp",
    "smart_gis.rc",
    "stdafx.cpp",
    "doc/smart_gis_doc.cpp",
    "view/smart_3d_view.cpp",
    "view/smart_data_source_view.cpp",
    "view/smart_gis_view.cpp",
    "view/smart_map_edit_view.cpp",
  ]
  deps = [
    ":app_core",
    "//src/base:base",
    "//src/base:core",
    "//src/gis/kernel/geo:geo",
    "//src/gis/model/map:gis",
    "//src/legacy/plugin:am_plugins",
    "//src/legacy/render/scene3d:scene3d",
    "//src/plugin:plugin",
    "//src/legacy/render/rhi2d:rhi2d",
    "//src/legacy/render/rhi3d:rhi",
    "//src/gis/datasource/mgr:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/tool/group:tool_group",
    "//src/legacy/ui/gui:gui",
    "//src/legacy/ui/mfc_ex:mfc_ex",
    "//src/legacy/ui/xambox:xambox",
    "//src/legacy/ui/xcatalog:xcatalog",
    "//src/legacy/ui/xview:xview",
    "//testing/data:china_map_samples",
  ]
}

group("legacy_app_all") {
  public_deps = [ ":app" ]
}
