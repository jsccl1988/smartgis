import("//build/smartgis.gni")

# Leftover MFC app core DLL (dll_stem stays app_core). Source: core/bootstrap.cpp.
# Layout: core/ (SmtApp + sample_map) + shell/ (frame/catalog/dock/showcase) +
# doc/ + view/ (+ bind/) + res/ + root PCH/RC. GN labels :app :app_core
# :legacy_app_all stay frozen.
smt_shared_library("app_core") {
  dll_stem = "app_core"
  defines = [ "APP_CORE_EXPORTS" ]
  sources = [
    "core/bootstrap.cpp",
    "core/sample_map.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/content:map_bootstrap",
    "//src/gis/kernel/geo:geo",
    "//src/gis/model/map:gis",
    "//src/plugin:plugin",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/ui/catalog:xcatalog",
  ]
}

# Leftover MFC desktop exe. Output name stays SmartGis.exe. Not in //src:src_all.
smt_mfc_executable("app") {
  output_name = "SmartGis"
  # Match #include "legacy/app/stdafx.h" under -I../src (MSVC /Yc name must match).
  precompiled_header = "legacy/app/stdafx.h"
  sources = [
    "shell/frame/child_frame.cpp",
    "shell/frame/main_frame.cpp",
    "shell/frame/mdi_tabs.cpp",
    "shell/frame/win_app.cpp",
    "shell/showcase/map2d.cc",
    "shell/showcase/scene3d.cc",
    "shell/catalog/tab_pane.cpp",
    "shell/dock/console.cpp",
    "shell/dock/diagnostic.cpp",
    "shell/dock/render_trace.cpp",
    "smart_gis.rc",
    "stdafx.cpp",
    "doc/document.cpp",
    "view/bind/mdi_menu.cpp",
    "view/bind/self_test_mark.cpp",
    "view/bind/status_coord.cpp",
    "view/scene3d_view.cpp",
    "view/data_view.cpp",
    "view/edit_view.cpp",
  ]
  deps = [
    ":app_core",
    "//src/base:base",
    "//src/base:core",
    "//src/content:debug_agent",
    "//src/gis/kernel/geo:geo",
    "//src/gis/model/map:gis",
    "//src/legacy/plugin:am_plugins",
    "//src/legacy/render/scene3d:scene3d",
    "//src/plugin:plugin",
    "//src/legacy/render/rhi2d:rhi2d",
    "//src/legacy/render/rhi3d:rhi",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/tool:tool_group",
    "//src/legacy/ui/dialogs:gui",
    "//src/legacy/ui/widgets:mfc_ex",
    "//src/legacy/ui/shell/ambox:xambox",
    "//src/legacy/ui/catalog:xcatalog",
    "//src/legacy/ui/shell:xview",
    "//testing/data:china_map_samples",
    "//testing/data:am_terrain_samples",
  ]
}

group("legacy_app_all") {
  public_deps = [ ":app" ]
}
