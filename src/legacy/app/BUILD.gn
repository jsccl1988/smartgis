import("//build/smartgis.gni")

# Leftover MFC app core DLL (dll_stem stays app_core). Source: smtapp.cpp.
smt_shared_library("app_core") {
  dll_stem = "app_core"
  defines = [ "APP_CORE_EXPORTS" ]
  sources = [ "smtapp.cpp" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/plugin:plugin",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/ui/xcatalog:xcatalog",
  ]
}

# Leftover MFC desktop exe. Output name stays SmartGis.exe. Not in //src:src_all.
smt_mfc_executable("app") {
  output_name = "SmartGis"
  # Match #include "legacy/app/stdafx.h" under -I../src (MSVC /Yc name must match).
  precompiled_header = "legacy/app/stdafx.h"
  sources = [
    "child_frame.cpp",
    "main_frame.cpp",
    "smart_3d_view.cpp",
    "smart_data_source_view.cpp",
    "smart_gis.cpp",
    "smart_gis.rc",
    "smart_gis_doc.cpp",
    "smart_gis_view.cpp",
    "smart_map_edit_view.cpp",
    "stdafx.cpp",
  ]
  deps = [
    ":app_core",
    "//src/base:base",
    "//src/base:core",
    "//src/algorithm/geo:geo",
    "//src/sdb/map:gis",
    "//src/legacy/render/model3d:model3d",
    "//src/plugin:plugin",
    "//src/legacy/render/bridge:render",
    "//src/legacy/render/render3d:render3d",
    "//src/sdb/datasource/mgr:sde_mgr",
    "//src/legacy/render/scene3d:scene3d",
    "//src/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/tool/group:tool_group",
    "//src/legacy/ui/gui:gui",
    "//src/legacy/ui/mfc_ex:mfc_ex",
    "//src/legacy/ui/xambox:xambox",
    "//src/legacy/ui/xcatalog:xcatalog",
    "//src/legacy/ui/xview:xview",
    "//testing/data:china_map_samples",
  ]
}

group("legacy_app_all") {
  public_deps = [ ":app" ]
}
