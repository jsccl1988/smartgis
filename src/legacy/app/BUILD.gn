import("//build/smartgis.gni")

# Leftover MFC app core DLL (dll_stem stays app_core). Source: bootstrap/*.
# Layout: bootstrap/ + shell/{frame,catalog,dock,showcase} + views/{document,viewport,helper} + res/ + root PCH/RC.
# GN labels :app :app_core :legacy_app_all stay frozen.
smt_shared_library("app_core") {
  dll_stem = "app_core"
  defines = [ "APP_CORE_EXPORTS" ]
  sources = [
    "bootstrap/bootstrap.cpp",
    "bootstrap/sample_map.cpp",
  ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/content:map_bootstrap",
    "//src/gis/geo:geo",
    "//src/gis/map:gis",
    "//src/plugin:plugin",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/ui/catalog:xcatalog",
  ]
}

# Leftover MFC desktop exe. Output name stays SmartGis.exe. Not in //src:src_all.
smt_mfc_executable("app") {
  output_name = "SmartGis"
  # Match #include "legacy/app/stdafx.h" under -I../src (MSVC /Yc name must match).
  precompiled_header = "legacy/app/stdafx.h"
  sources = [
    "shell/frame/child_frame.cpp",
    "shell/frame/main_frame.cpp",
    "shell/frame/mdi_tab_options.cpp",
    "shell/frame/win_app.cpp",
    "shell/showcase/map2d_showcase.cc",
    "shell/showcase/scene3d_showcase.cc",
    "shell/catalog/catalog_pane.cpp",
    "shell/dock/debug_console.cpp",
    "shell/dock/diagnostic.cpp",
    "shell/dock/render_trace.cpp",
    "smart_gis.rc",
    "stdafx.cpp",
    "views/document/document.cpp",
    "views/helper/mdi_menu.cpp",
    "views/helper/self_test_mark.cpp",
    "views/helper/status_coord.cpp",
    "views/viewport/scene3d_view.cpp",
    "views/viewport/data_view.cpp",
    "views/viewport/edit_view.cpp",
  ]
  deps = [
    ":app_core",
    "//src/base:base",
    "//src/base:core",
    "//src/content:debug_agent",
    "//src/gis/geo:geo",
    "//src/gis/map:gis",
    "//src/legacy/plugin:am_plugins",
    "//src/legacy/render/scene3d:scene3d",
    "//src/plugin:plugin",
    "//src/legacy/render/rhi2d:rhi2d",
    "//src/legacy/render/rhi3d:rhi",
    "//src/legacy/gis/datasource:sde_mgr",
    "//src/legacy/sys:sys",
    "//src/legacy/tool:tool",
    "//src/legacy/tool:tool_group",
    "//src/legacy/ui/dialogs:gui",
    "//src/legacy/ui/widgets:mfc_ex",
    "//src/legacy/ui/shell/ambox:xambox",
    "//src/legacy/ui/catalog:xcatalog",
    "//src/legacy/ui/shell:xview",
    "//testing/data:china_map_samples",
    "//testing/data:am_terrain_samples",
  ]
}

group("legacy_app_all") {
  public_deps = [ ":app" ]
}
