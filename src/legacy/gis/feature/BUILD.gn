import("//build/smartgis.gni")

# Device-free OGR → CPU FeatureMesh tessellation for leftover scene3d
# SmtGeoObject. Compiled into //src/gis:gis. No SmtScene / LP3DRENDERDEVICE.

source_set("feature_sources") {
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
    "NOMINMAX",
  ]
  sources = [
    "leftover_copy_layer.cc",
    "leftover_copy_layer.h",
    "leftover_feature.cc",
    "leftover_feature.h",
    "mesh.h",
    "model_aliases.h",
    "tess_map.cc",
    "tess_world.cc",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/base:base",
    "//src/base:core",
    "//src/gis/geo:geo_sources",
    "//src/gis/geo:tin_sources",
    "//third_party:gdal",
  ]
}

group("feature") {
  public_deps = [ "//src/gis:gis" ]
}
