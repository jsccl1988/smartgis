import("//build/smartgis.gni")

# Leftover DataSourceMgr — compiled into //src/gis:gis.
# Lives under legacy/gis/datasource/; new trees use //src/gis/datasource/session.
source_set("sde_mgr_sources") {
  configs += [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
  ]
  sources = [
    "connection_spec_info.cc",
    "connection_spec_info.h",
    "datasource_mgr.cc",
    "../layer/layer.h",
    "../layer/map_bind.cc",
    "../layer/map_bind.h",
    "../layer/raster_wrap.h",
    "../layer/tile_wrap.h",
  ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/gis/geo:geo_sources",
    "//src/base:base",
    "//src/base:core",
    "//third_party:gdal",
  ]
}

group("sde_mgr") {
  public_deps = [ "//src/gis:gis" ]
}
