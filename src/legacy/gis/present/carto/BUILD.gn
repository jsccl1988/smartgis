import("//build/smartgis.gni")

# Cartographic pen/brush/StyleManager POD (NOT MapLibre Style JSON —
# that is //src/gis/present/style). Envelope lives in //src/gis/model/envelope.h.
#
# Leftover tree mirrors endgame gis/present/carto. Compiled into
# //src/gis:gis (dll_stem=gis). Namespace remains `base` for leftover
# call-site continuity until a later ABI rename.

source_set("carto_sources") {
  configs += [ "//build:legacy" ]
  public_configs = [ "//build:legacy" ]
  defines = [
    "_USRDLL",
    "GIS_EXPORTS",
    "SDB_EXPORTS",
  ]
  sources = [
    "style_api.cpp",
    "style.cpp",
    "stylemanager.cpp",
    "styletable.cpp",
  ]
  include_dirs += [ "//src" ]
  public_deps = [ "//src/base:base" ]
}

group("carto") {
  public_deps = [ "//src/gis:gis" ]
}
