# Product content DLL. Disk stem: content.dll / content_d.dll.
product_shared_library("content") {
  assert_no_deps = _content_no_shell_deps
  dll_stem = "content"
  defines = [ "CONTENT_EXPORTS" ]
  deps = [
    ":content_sources",
    ":gis_bootstrap_sources",
    ":tool_session_sources",
  ]
  # Headers under public/ pull tool::Command* and (via ToolSession call sites)
  # gis::EditSession; forward those edges so consumers import-link tool.dll /
  # gis.dll (not statically absorb dispatch TUs into content.dll).
  public_deps = [
    "//src/gis/edit:edit",
    "//src/tool:tool",
  ]
  public_configs = [ ":content_config" ]
  # gis_contents.cc uses CreateDXGIFactory1; pragma comment is unreliable under /GL.
  libs = [ "dxgi.lib" ]
}

# Stable labels �?same DLL as :content.
