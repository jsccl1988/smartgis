# Embedder API is the public/ headers (no gis_bootstrap �?that lives under
# browser/contents/). Pipe frames live in common/host_protocol.h.
#   app/       ContentMain + process-type switch
#   browser/   contents, session, document, camera, present, capability,
#              debug, child  (C11: thin bootstrap/catalog/attrs/plugin/input gone)
#   renderer/  --type=renderer child
#   view/      in-process ToolSession + LocalToolRouter
#   embed/     HWND-free embed sample
#   common/    host pipe + frame ABI
#
# One DLL (dll_stem = content). In-DLL source_sets use CONTENT_EXPORTS;
# stable group labels forward to :content for existing deps.
# tool::Workspace / Command* live in //src/tool:tool (dll_stem = tool) �?
# import-link that DLL; do not compile dispatch source_sets into content.

import("//build/smartgis.gni")
import("//testing/benchmark.gni")
import("//testing/test.gni")

# Impl must not depend on a product shell or the Views toolkit.
_content_no_shell_deps = [
  "//src/app:*",
  "//src/app/*",
  "//src/ui/views:ui_views",
]

config("content_config") {
  include_dirs += [ "//src" ]
}

