# Stable map session / viewport ABI for every src/app host
# (Chromium content/public). No MFC. Include as "content/public/...".
# Implementation may use sdb + render + gpu; public headers stay thin.

import("//testing/test.gni")

config("content_config") {
  include_dirs += [ "//src" ]
}

source_set("content") {
  sources = [
    "app/content_main.cc",
    "app/content_main.h",
    "app/renderer_main.cc",
    "app/renderer_main.h",
    "common/ipc.cc",
    "common/ipc.h",
    "catalog_layers.cc",
    "feature_attrs.cc",
    "map_contents.cc",
    "public/catalog_layers.h",
    "public/feature_attrs.h",
    "public/host_protocol.h",
    "public/map_contents.h",
    "public/map_contents_observer.h",
    "public/map_types.h",
    "public/map_widget_host_view.h",
    "plugin_host.cc",
    "public/plugin_host.h",
    "public/process_type.cc",
    "public/process_type.h",
  ]
  public_configs = [ ":content_config" ]
  public_deps = [
    "//src/base/ipc:ipc",
    "//src/tool:dispatch",
  ]
}

# Per-view Workspace + EventBus + EditSession. Leftover xview hosts this.
source_set("view_host") {
  sources = [
    "local_tool_router.cc",
    "public/event_bus.h",
    "public/events.h",
    "public/local_tool_router.h",
    "public/view_host.h",
    "view_host.cc",
  ]
  public_configs = [ ":content_config" ]
  public_deps = [ ":content" ]
  include_dirs += [ "//src" ]
  deps = [
    "//src/gis/edit:edit",
    "//src/tool:dispatch",
  ]
}

test("content_view_host_test") {
  output_name = "content_view_host_test"
  sources = [ "view_host_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":view_host" ]
}

# HWND-free attribute token / named-field helpers (SP3 host extract).
test("content_feature_attrs_test") {
  output_name = "content_feature_attrs_test"
  sources = [ "feature_attrs_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":content" ]
}

# HWND-free Catalog LayerDesc JSON (SP3 catalog snapshot).
test("content_catalog_layers_test") {
  output_name = "content_catalog_layers_test"
  sources = [ "catalog_layers_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":content" ]
}
