    # Engine SoT is CONTENT_EXPORT (ui_views / shell import-link content.dll).
    # Not :scene3d_present 鈥?that would pull GPU/GDI into every content consumer.
    "browser/present/scene3d/session/scene3d_rhi_session.cc",
    "browser/present/scene3d/session/scene3d_rhi_session.h",
    "common/host_protocol.h",
    "common/ipc.cc",
    "common/ipc.h",
    "content_export.h",
    "public/catalog_layers.h",
    "public/feature_attrs.h",
    "public/gis_document.h",
