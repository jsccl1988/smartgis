# Embedder API is the public/ headers (incl. map_bootstrap). No MFC.
# Pipe frames live in common/host_protocol.h (not an embedder header).
#   app/       ContentMain + process-type switch
#   browser/   bootstrap, contents, catalog, attrs, plugin, session,
#              document, camera, present, input, capability, debug
#   renderer/  --type=renderer child
#   view/      in-process ViewHost + LocalToolRouter
#   embed/     HWND-free embed sample
#   common/    host pipe + frame ABI
#
# One DLL (dll_stem = content). In-DLL source_sets use CONTENT_EXPORTS;
# stable group labels forward to :content for existing deps.
# tool::Workspace / Command* live in //src/tool:tool (dll_stem = tool) 鈥?
# import-link that DLL; do not compile dispatch source_sets into content.

import("//build/smartgis.gni")
import("//testing/benchmark.gni")
import("//testing/test.gni")

config("content_config") {
  include_dirs += [ "//src" ]
}

# HWND-free sample / china map path policy (SP3).
source_set("map_bootstrap_sources") {
  sources = [
    "browser/bootstrap/map_bootstrap.cc",
    "public/map_bootstrap.h",
  ]
  public_configs = [ ":content_config" ]
  defines = [ "CONTENT_EXPORTS" ]
}

