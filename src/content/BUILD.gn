  sources = [ "view/view_host_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":view_host" ]
}

test("content_embed_sample_test") {
  output_name = "content_embed_sample_test"
  sources = [ "embed/embed_sample_test.cc" ]
  include_dirs += [ "//src" ]
  deps = [ ":embed_sample" ]
}

test("content_main_test") {
