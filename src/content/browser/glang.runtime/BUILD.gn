    "language/front/python/Python3ParserBase.cpp",
    "language/front/python/Python3ParserBase.h",
  ]
  sources += get_target_outputs(":python3_lexer_gen")
  sources += get_target_outputs(":python3_parser_gen")
  deps = [
    ":python3_lexer_gen",
    ":python3_parser_gen",
