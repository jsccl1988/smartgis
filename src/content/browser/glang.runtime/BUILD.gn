# IL runtime. Language core does not dep //src/app/views or the Views toolkit.
# :backend / :session bind CapabilityHost. They must not dep //src/app/views.
# The shell fills Shell from Browser (app/views/app/startup/shell_runtime.cc).
# Suite entry is content::run_suite_script.

import("//build/python.gni")
import("//testing/test.gni")
import("//third_party/antlr4/antlr.gni")

_il_no_shell_deps = [
  "//src/app:*",
  "//src/app/*",
  "//src/ui/views:ui_views",
]

# Split Python3 lexer/parser. tokenVocab is read beside the parser unless
# -lib points at the lexer output, so this is two jar runs. Basenames are
# copied into $root_out_dir (the action cwd) so -o stays flat.
_py_gen = "$root_gen_dir/g4/il.runtime/python/cpp"

copy("python3_grammar_src") {
  sources = [
    "language/front/python/Python3Lexer.g4",
    "language/front/python/Python3Parser.g4",
  ]
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

action("python3_lexer_gen") {
  script = "//build/tools/action/run_script.py"
  deps = [ ":python3_grammar_src" ]
  inputs = [ antlr4_complete_jar ]
  outputs = [
    "$_py_gen/Python3Lexer.cpp",
    "$_py_gen/Python3Lexer.h",
  ]
  args = [
    "java",
    "-jar",
    rebase_path(antlr4_complete_jar, root_build_dir),
    "-Dlanguage=Cpp",
    "-visitor",
    "-package",
    "app_py",
    "-o",
    rebase_path(_py_gen, root_build_dir),
    "Python3Lexer.g4",
  ]
}

action("python3_parser_gen") {
  script = "//build/tools/action/run_script.py"
  deps = [ ":python3_lexer_gen" ]
  inputs = [ antlr4_complete_jar ]
  outputs = [
    "$_py_gen/Python3Parser.cpp",
    "$_py_gen/Python3Parser.h",
    "$_py_gen/Python3ParserBaseVisitor.cpp",
    "$_py_gen/Python3ParserBaseVisitor.h",
    "$_py_gen/Python3ParserVisitor.cpp",
    "$_py_gen/Python3ParserVisitor.h",
    "$_py_gen/Python3ParserBaseListener.cpp",
    "$_py_gen/Python3ParserBaseListener.h",
    "$_py_gen/Python3ParserListener.cpp",
    "$_py_gen/Python3ParserListener.h",
  ]
  args = [
    "java",
    "-jar",
    rebase_path(antlr4_complete_jar, root_build_dir),
    "-Dlanguage=Cpp",
    "-visitor",
    "-package",
    "app_py",
    "-lib",
    rebase_path(_py_gen, root_build_dir),
    "-o",
    rebase_path(_py_gen, root_build_dir),
    "Python3Parser.g4",
  ]
}

config("python3_gen_includes") {
  include_dirs += [
    _py_gen,
    "language/front/python",
  ]
}

source_set("python3_grammar") {
  assert_no_deps = _il_no_shell_deps
