{
  "id": "ui.scene",
  "kind": "integration",
  "argv": [
    "--ui-showcase",
    "scene"
  ],
  "env": {
    "UI_SHOWCASE_LINGER_MS": "0",
    "UI_FORENSICS": "1",
    "UI_THEME": "dark"
  },
  "bmp": {
    "path": "ui-showcase-scene.bmp",
    "score_id": "views_shell_chrome"
  },
  "report_name": "ui_scene_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 140,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "scene_page_chrome_readable",
      "viewport_host_not_collapsed",
      "no_sibling_overlap",
      "dark_theme_consistent"
    ],
    "expect_notes": "Exercises 3D tab then captures shell chrome (views_shell_chrome); PrintWindow falls back to Map tab after scene marks — do not golden GPU scene pixels"
  }
}
