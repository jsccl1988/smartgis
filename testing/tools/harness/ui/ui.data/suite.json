{
  "id": "ui.data",
  "kind": "showcase",
  "argv": [
    "--ui-showcase",
    "data"
  ],
  "env": {
    "UI_SHOWCASE_LINGER_MS": "0",
    "UI_FORENSICS": "1",
    "UI_THEME": "dark"
  },
  "bmp": {
    "path": "ui-showcase-data.bmp",
    "score_id": "ui_shell_dark"
  },
  "report_name": "ui_data_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "chrome_readable",
      "no_panel_collapse",
      "no_sibling_overlap",
      "dark_theme_consistent"
    ],
    "expect_notes": "Data pane removed; --ui-showcase data stays on Map tab (score_id=ui_shell_dark)"
  }
}
