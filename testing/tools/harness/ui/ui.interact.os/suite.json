{
  "id": "ui.interact.os",
  "kind": "integration",
  "argv": [
    "--ui-showcase",
    "interact"
  ],
  "driver": "os",
  "os_inject_default": "postmessage",
  "script": "../ui.interact/ui.interact.host.il",
  "gesture_script": "../ui.interact/ui.interact.il",
  "window_title": "SmartGIS Views",
  "env": {
    "UI_SHOWCASE_LINGER_MS": "0",
    "UI_INTERACT_OS_WAIT_MS": "10000",
    "UI_FORENSICS": "1",
    "UI_THEME": "dark",
    "SKIP_MAP_CONTEXT_MENU": "1",
    "FORCE_GDI_MAP_OVERLAY": "0",
    "FORCE_CONTENT_MAPVIEW_2D": "1",
    "PREFER_FLYCUBE_2D": "0",
    "MAP2D_ENGINE": "vista",
    "SCENE3D_ENGINE": "flycube"
  },
  "bmp": {
    "path": "ui-showcase-interact.bmp",
    "score_id": "ui_shell_dark"
  },
  "report_name": "ui_interact_os_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 3,
    "timeout_sec": 180,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "interact_targets_visible",
      "chrome_readable",
      "os_inject_did_not_blank_shell",
      "dark_theme_consistent"
    ],
    "expect_notes": "Same host + gesture IL as ui.interact; C++ OS wait while Python injects gesture_script; BMP stem shared"
  }
}
