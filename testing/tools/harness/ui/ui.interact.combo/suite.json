{
  "id": "ui.interact.combo",
  "kind": "integration",
  "argv": [
    "--ui-showcase",
    "interact"
  ],
  "driver": "inproc",
  "script": "../ui.interact/ui.interact.host.py",
  "gesture_script": "ui.interact.combo.py",
  "env": {
    "UI_SHOWCASE_LINGER_MS": "0",
    "UI_THEME": "dark"
  },
  "mark_leaf": "ui-showcase-mark.txt",
  "required_marks": [
    "interact-smoke-ok",
    "interact-combo-demo-ok",
    "pass"
  ],
  "report_name": "ui_interact_combo_loop_report.json",
  "probes": [
    "marks"
  ],
  "loop": {
    "rounds": 2,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  }
}
