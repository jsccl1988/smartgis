{
  "id": "ui.interact",
  "kind": "integration",
  "argv": [
    "--ui-showcase",
    "interact",
    "--scene3d-engine",
    "flycube"
  ],
  "driver": "inproc",
  "script": "ui.interact.host.il",
  "gesture_script": "ui.interact.il",
  "window_title": "SmartGIS Views",
  "env": {
    "UI_SHOWCASE_LINGER_MS": "0",
    "UI_FORENSICS": "1",
    "UI_THEME": "dark",
    "HARNESS_RECORD": "1",
    "HARNESS_RECORD_MODE": "bmp",
    "FORCE_GDI_MAP_OVERLAY": "0",
    "FORCE_CONTENT_MAPVIEW_2D": "1",
    "PREFER_FLYCUBE_2D": "0",
    "MAP2D_ENGINE": "vista",
    "SCENE3D_ENGINE": "flycube"
  },
  "bmp": {
    "path": "ui-showcase-interact.bmp",
    "score_id": "ui_interact"
  },
  "motion_gate": {
    "min_unique_frac": 0.03,
    "min_unique_frames": 4,
    "min_unique_sizes": 2
  },
  "report_name": "ui_interact_loop_report.json",
  "probes": [
    "bmp",
    "motion"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 180,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "2d_gestures_no_hitch",
      "window_resize_2d_layout",
      "3d_china_dem_bake_labels",
      "window_resize_3d_layout",
      "vista_2d_content_mapview",
      "flycube_3d_china_dem",
      "fps_hud_complete_2d_and_3d",
      "return_2d_gestures_no_hitch",
      "chrome_readable",
      "no_panel_collapse"
    ],
    "expect_notes": "Product Vista: Map2d ContentMapView + Scene3d FlyCube. Host chrome + gesture body. 2D pan/wheel → resize → 3D China DEM orbit/wheel → resize → restore + 2D; score end frame + 3d sibling BMP + HWND record"
  }
}
