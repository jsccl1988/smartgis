{
  "id": "ui.interact",
  "kind": "showcase",
  "argv": [
    "--ui-showcase",
    "interact"
  ],
  "driver": "inproc",
  "script": "ui.interact.il",
  "env": {
    "SMT_UI_SHOWCASE_LINGER_MS": "0",
    "SMT_UI_FORENSICS": "1",
    "SMT_UI_THEME": "dark"
  },
  "bmp": {
    "path": "ui-showcase-interact.bmp",
    "score_id": "ui_shell_dark"
  },
  "report_name": "ui_interact_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 160,
    "build_target": "src/app/views:views",
    "exe": "SmartGisViews.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "interact_targets_visible",
      "chrome_readable",
      "no_panel_collapse",
      "dark_theme_consistent"
    ],
    "expect_notes": "In-proc interact showcase end frame; score_id=ui_shell_dark"
  }
}
