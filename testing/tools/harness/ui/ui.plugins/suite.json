{
  "id": "ui.plugins",
  "kind": "integration",
  "argv": [],
  "script": "ui.plugins.py",
  "env": {},
  "mark_leaf": "ui-plugins-mark.txt",
  "required_marks": [
    "hwnd-ok",
    "plugins-ok",
    "plugins-tab-ok",
    "pass"
  ],
  "report_name": "ui_plugins_loop_report.json",
  "probes": [
    "marks"
  ],
  "loop": {
    "rounds": 2,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  }
}
