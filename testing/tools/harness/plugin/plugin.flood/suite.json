{
    "id":  "plugin.flood",
    "kind":  "integration",
    "argv":  [
                 "--plugin-showcase=flood"
             ],
    "script":  "plugin.flood.il",
    "env":  {
                "SKIP_MAP_CONTEXT_MENU":  "1"
            },
    "mark_leaf":  "plugin-showcase-mark.txt",
    "required_marks":  [
                           "hwnd-ok",
                           "flood-ok",
                           "playback-ok",
                           "bmp-ok",
                           "pass",
                           "extent-ok"
                       ],
    "bmp":  {
                "path":  "plugin-showcase-flood.bmp",
                "score_id":  "plugin_map2d",
                "accept_nonzero_rc_if_bmp":  true,
                "min_bytes":  10000
            },
    "report_name":  "plugin_flood_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  2,
                 "timeout_sec":  120,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "inundation_visible",
                                            "land_contrast",
                                            "no_blank_map"
                                        ],
                          "expect_notes":  "flood mask/depth distinct from dry land"
                      }
}
