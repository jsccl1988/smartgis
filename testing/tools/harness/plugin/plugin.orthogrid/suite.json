{
  "id": "plugin.orthogrid",
  "kind": "showcase",
  "argv": [
    "--plugin-showcase=orthogrid"
  ],
  "env": {
    "SKIP_MAP_CONTEXT_MENU": "1"
  },
  "mark_leaf": "plugin-showcase-mark.txt",
  "required_marks": [
    "orthogrid-ok",
    "playback-ok",
    "bmp-ok",
    "pass"
  ],
  "bmp": {
    "path": "plugin-showcase-orthogrid.bmp",
    "score_id": "map2d_orthogrid"
  },
  "report_name": "plugin_orthogrid_loop_report.json",
  "probes": [
    "marks",
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "grid_field_visible",
      "heat_ramp",
      "no_blank_map"
    ],
    "expect_notes": "orthogrid interpolate heat ramp on map2d"
  }
}
