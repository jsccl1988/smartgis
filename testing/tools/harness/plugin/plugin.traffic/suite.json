{
  "id": "plugin.traffic",
  "kind": "showcase",
  "argv": [
    "--plugin-showcase=traffic"
  ],
  "script": "plugin.traffic.il",
  "env": {
    "SKIP_MAP_CONTEXT_MENU": "1"
  },
  "mark_leaf": "plugin-showcase-mark.txt",
  "required_marks": [
    "traffic-ok",
    "playback-ok",
    "bmp-ok",
    "pass"
  ],
  "bmp": {
    "path": "plugin-showcase-traffic.bmp",
    "score_id": "plugin_map2d",
    "accept_nonzero_rc_if_bmp": true,
    "min_bytes": 10000
  },
  "report_name": "plugin_traffic_loop_report.json",
  "probes": [
    "marks",
    "bmp"
  ],
  "loop": {
    "rounds": 2,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "network_visible",
      "flow_or_cost_signal",
      "no_blank_map"
    ],
    "expect_notes": "traffic network/analysis overlay readable"
  }
}
