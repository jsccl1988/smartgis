{
  "id": "plugin.print",
  "kind": "showcase",
  "argv": [
    "--plugin-showcase=print"
  ],
  "script": "plugin.print.il",
  "env": {
    "SMT_SKIP_MAP_CONTEXT_MENU": "1"
  },
  "mark_leaf": "plugin-showcase-mark.txt",
  "required_marks": [
    "china-ok",
    "print-dialog-ok",
    "bmp-ok",
    "pass"
  ],
  "bmp": {
    "path": "plugin-showcase-print.bmp",
    "score_id": "plugin_print"
  },
  "report_name": "plugin_print_loop_report.json",
  "probes": [
    "marks",
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "layout_readable",
      "map_frame_present",
      "legend_or_scale"
    ],
    "expect_notes": "print layout page not blank; map+chrome"
  }
}
