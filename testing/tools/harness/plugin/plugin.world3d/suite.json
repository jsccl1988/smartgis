{
    "id":  "plugin.world3d",
    "kind":  "integration",
    "argv":  [
                 "--plugin-showcase=world3d"
             ],
    "script":  "plugin.world3d.il",
    "env":  {
                "SKIP_MAP_CONTEXT_MENU":  "1",
                "SCENE3D_ENGINE":  "flycube",
                "SCENE3D_WIREFRAME":  "0",
                "PLUGIN_WORLD3D_PERF_BARE":  "0"
            },
    "mark_leaf":  "plugin-showcase-mark.txt",
    "required_marks":  [
                           "pointcloud-ok",
                           "present-ok",
                           "bmp-ok",
                           "pass",
                           "fit-box-ok",
                           "camera-fly-ok"
                       ],
    "bmp":  {
                "path":  "plugin-showcase-world3d.bmp",
                "score_id":  "plugin_scene3d",
                "accept_nonzero_rc_if_bmp":  true,
                "min_bytes":  10000
            },
    "report_name":  "plugin_world3d_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  4,
                 "timeout_sec":  300,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "terrain_visible",
                                            "pointcloud_or_mesh",
                                            "atmosphere_or_sky_hint",
                                            "no_black_frame"
                                        ],
                          "expect_notes":  "world3d True-Earth globe: lit DEM sphere + sat-cloud + sky (China space hold); planar DEM overlay is perf-bare only"
                      }
}
