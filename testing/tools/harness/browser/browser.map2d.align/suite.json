{
    "id":  "browser.map2d.align",
    "kind":  "integration",
    "argv":  [
                 "--map2d-showcase=align",
                 "--map2d-showcase-il=1"
             ],
    "script":  "browser.map2d.align.il",
    "env":  {
                "MAP2D_SHOWCASE_LINGER_MS":  "0",
                "MAP2D_SHOWCASE_W":  "1280",
                "MAP2D_SHOWCASE_H":  "720",
                "FORCE_GDI_MAP_OVERLAY":  "1"
            },
    "mark_leaf":  "map2d-showcase-mark.txt",
    "required_marks":  [
                           "china-ok",
                           "fit-ok",
                           "pass",
                           "extent-ok"
                       ],
    "bmp":  {
                "path":  "map2d-showcase-align.bmp",
                "score_id":  "map2d_china",
                "accept_nonzero_rc_if_bmp":  true,
                "soft":  true,
                "min_bytes":  10000
            },
    "report_name":  "browser_map2d_align_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  4,
                 "timeout_sec":  180,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "style_layers_visible",
                                            "not_all_black",
                                            "no_y_flip_artifacts"
                                        ],
                          "expect_notes":  "map2d StyleDocument align vs china carto; soft map2d_china"
                      }
}
