{
  "id": "browser.world3d.coast",
  "kind": "showcase",
  "argv": [
    "--atmosphere-showcase",
    "coast"
  ],
  "script": "browser.world3d.coast.il",
  "env": {
    "ATMOSPHERE_SHOWCASE_GPU": "1",
    "ATMOSPHERE_SHOWCASE_LINGER_MS": "0"
  },
  "bmp": {
    "path": "atmosphere-showcase-coast.bmp",
    "score_id": "atmosphere_full",
    "accept_nonzero_rc_if_bmp": true,
    "soft": true,
    "min_bytes": 10000
  },
  "report_name": "browser_world3d_coast_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 90,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "coast_land_sea",
      "not_solid_clear_color"
    ],
    "expect_notes": "coast atmosphere; soft atmosphere_full score"
  }
}
