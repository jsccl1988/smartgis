{
    "id":  "browser.map2d.orthogrid",
    "kind":  "integration",
    "argv":  [
                 "--map2d-showcase=orthogrid"
             ],
    "script":  "browser.map2d.orthogrid.il",
    "env":  {
                "MAP2D_SHOWCASE_LINGER_MS":  "0",
                "SKIP_MAP_CONTEXT_MENU":  "1"
            },
    "mark_leaf":  "map2d-showcase-mark.txt",
    "required_marks":  [
                           "orthogrid-ok",
                           "fit-ok",
                           "pass",
                           "extent-ok"
                       ],
    "bmp":  {
                "path":  "map2d-showcase-orthogrid.bmp",
                "score_id":  "map2d_orthogrid"
            },
    "report_name":  "browser_map2d_orthogrid_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  6,
                 "timeout_sec":  90,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "grid_cells_visible",
                                            "fit_extent_plausible",
                                            "not_all_black",
                                            "no_y_flip_artifacts"
                                        ],
                          "expect_notes":  "Ortho grid overlay on map2d; score_id=map2d_orthogrid"
                      }
}
