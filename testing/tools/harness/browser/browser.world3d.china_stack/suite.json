{
    "id": "browser.world3d.china_stack",
    "kind": "integration",
    "argv": [
        "--plugin-showcase=world3d"
    ],
    "script": "browser.world3d.china_stack.py",
    "env": {
        "ATMOSPHERE_SHOWCASE_GPU": "1",
        "ATMOSPHERE_SHOWCASE_LINGER_MS": "0",
        "SYNC_FLYCUBE_INIT": "1"
    },
    "mark_leaf": "atmosphere-showcase-mark.txt",
    "required_marks": [
        "bmp-ok",
        "pass",
        "fit-box-ok",
        "camera-fly-ok",
        "china-stack-cloud-ok"
    ],
    "bmp": {
        "path": "atmosphere-showcase-china-stack-cloud.bmp",
        "score_id": "china_stack"
    },
    "report_name": "browser_world3d_china_stack_loop_report.json",
    "probes": [
        "marks",
        "bmp"
    ],
    "loop": {
        "rounds": 4,
        "timeout_sec": 180,
        "build_target": "src/app/views:views",
        "exe": "SmartGIS.exe"
    },
    "visual_review": {
        "enabled": true,
        "checklist": [
            "dem_before_ocean",
            "ocean_before_fog",
            "fog_before_sky",
            "sky_before_cloud",
            "witness_not_a_pass"
        ],
        "expect_notes": "China stack ladder. cloud BMP is the suite file; earlier stages must already be ok."
    }
}
