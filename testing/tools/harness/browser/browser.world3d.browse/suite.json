{
    "id":  "browser.world3d.browse",
    "kind":  "integration",
    "argv":  [
                 "--browse-showcase"
             ],
    "script":  "browser.world3d.browse.il",
    "env":  {
                "SKIP_MAP_CONTEXT_MENU":  "1",
                "SCENE3D_ENGINE":  "flycube",
                "SCENE3D_WIREFRAME":  "0"
            },
    "window_title":  "SmartGIS Views",
    "mark_leaf":  "browse-3d-mark.txt",
    "required_marks":  [
                           "scene-ready",
                           "browse3d-orbit-ok",
                           "browse3d-wheel-ok",
                           "browse-exit",
                           "fit-box-ok",
                           "camera-fly-ok"
                       ],
    "accept_nonzero_rc_if_marks":  true,
    "bmp":  {
                "path":  "browse-showcase-3d.bmp",
                "score_id":  "plugin_scene3d",
                "accept_nonzero_rc_if_bmp":  true,
                "soft":  false,
                "min_bytes":  10000
            },
    "report_name":  "browser_world3d_browse_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  6,
                 "timeout_sec":  150,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "3d_tab_active",
                                            "terrain_or_globe_visible",
                                            "atmosphere_or_intentional_clear",
                                            "orbit_wheel_marks",
                                            "no_hollow_present"
                                        ],
                          "expect_notes":  "Views Scene3D tab orbit/wheel; software paint SoT = East-China DEM hypsometric fills (ocean off, atmosphere sky clear, no forced wireframe); bmp.soft=false"
                      }
}
