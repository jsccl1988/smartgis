{
    "id":  "browser.map2d.china",
    "kind":  "integration",
    "argv":  [
                 "--map2d-showcase=china",
                 "--map2d-showcase-il=1"
             ],
    "script":  "browser.map2d.china.il",
    "env":  {
                "MAP2D_SHOWCASE_LINGER_MS":  "0",
                "MAP2D_FORCE_HILLSHADE":  "1",
                "MAP2D_NO_HILLSHADE":  "0",
                "MAP2D_SHOWCASE_W":  "1280",
                "MAP2D_SHOWCASE_H":  "720",
                "MAP2D_ENGINE":  "",
                "FORCE_GDI_MAP_OVERLAY":  "1"
            },
    "mark_leaf":  "map2d-showcase-mark.txt",
    "required_marks":  [
                           "china-ok",
                           "fit-ok",
                           "pass",
                           "extent-ok"
                       ],
    "bmp":  {
                "path":  "map2d-showcase-china.bmp",
                "score_id":  "map2d_china",
                "accept_nonzero_rc_if_bmp":  true,
                "min_bytes":  10000
            },
    "report_name":  "browser_map2d_china_loop_report.json",
    "probes":  [
                   "marks",
                   "bmp"
               ],
    "loop":  {
                 "rounds":  6,
                 "timeout_sec":  180,
                 "build_target":  "src/app/views:views",
                 "exe":  "SmartGIS.exe"
             },
    "visual_review":  {
                          "enabled":  true,
                          "checklist":  [
                                            "coastline_plausible",
                                            "roads_aligned",
                                            "labels_readable",
                                            "no_y_flip_artifacts"
                                        ],
                          "expect_notes":  "China carto vs MapLibre reference; coast/roads/labels"
                      }
}
