{
  "id": "browser.campaign",
  "kind": "integration",
  "argv": [
    "--harness"
  ],
  "script": "browser.campaign.py",
  "window_title": "SmartGIS Views",
  "env": {
    "SKIP_MAP_CONTEXT_MENU": "1"
  },
  "mark_leaf": "browser-campaign-mark.txt",
  "required_marks": [
    "campaign-china-ok",
    "campaign-digitize-ok",
    "campaign-buffer-ok",
    "campaign-clip-ok",
    "campaign-export-ok",
    "campaign-orbit-ok",
    "campaign-pass"
  ],
  "report_name": "browser_campaign_loop_report.json",
  "probes": [
    "marks"
  ],
  "loop": {
    "rounds": 2,
    "timeout_sec": 300,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  }
}
