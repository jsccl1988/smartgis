{
  "id": "atmosphere.full",
  "kind": "showcase",
  "argv": [
    "--atmosphere-showcase",
    "full"
  ],
  "script": "atmosphere.full.il",
  "env": {
    "SMT_ATMOSPHERE_SHOWCASE_GPU": "1",
    "SMT_ATMOSPHERE_SHOWCASE_LINGER_MS": "0"
  },
  "bmp": {
    "path": "atmosphere-showcase-full.bmp",
    "score_id": "atmosphere_full"
  },
  "report_name": "atmosphere_full_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "src/app/views:views",
    "exe": "SmartGisViews.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "blue_sky",
      "sky_gradient",
      "cloud_visible",
      "land_detail",
      "no_flat_clear"
    ],
    "expect_notes": "full atmosphere: sky + cloud + land; not washed flat clear"
  }
}
