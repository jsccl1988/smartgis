{
  "scopeName": "source.interact",
  "name": "Interact DSL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#ops" },
    { "include": "#targets" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.interact",
          "match": "//.*$"
        },
        {
          "name": "comment.block.interact",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.interact",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.interact",
          "match": "\\\\."
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.interact",
          "match": "@(?:inproc|os|drivers|inject)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.interact",
          "match": "\\b(?:script|seq|repeat|chord)\\b"
        }
      ]
    },
    "ops": {
      "patterns": [
        {
          "name": "entity.name.function.interact",
          "match": "\\b(?:pump|select_map_tab|catalog_tab|inspector_tab|mark|wait_ready|wait_map_ready|load_sample|load_china_sample|open_map|detach_maps|stop_map_timers|clear_marks|require_hwnd|require_edit_host|expect_host|tool|run_tool|expect_tool|expect_geom|browse_stress|expect_wheel_cursor|map2d_run|atmosphere_run|world3d_run|mine_run|stormsurge_run|orthogrid3d_run|run_processing|console_run|resolve_data|capture_path|sidecar_path|require_var|doc_clear|fit_extent|export_bmp|suppress_dialogs|require_plugins|apply_style_file|invalidate_map2d|analysis_set_frame|analysis_export_frames|window|key|click|rclick|dblclick|drag|wheel|path|pan_burst|wheel_burst)\\b"
        }
      ]
    },
    "targets": {
      "patterns": [
        {
          "name": "variable.other.constant.interact",
          "match": "\\b(?:shell_client|map_client|shell|map|left|right|middle|activate|CTRL|SHIFT|ALT|ESCAPE)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.interact",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.interact",
          "match": "[,;=]"
        },
        {
          "name": "punctuation.section.brackets.interact",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}
