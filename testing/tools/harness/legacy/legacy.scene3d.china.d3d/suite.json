{
  "id": "legacy.scene3d.china.d3d",
  "kind": "showcase",
  "argv": [
    "--scene3d-showcase",
    "china"
  ],
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "0",
    "SMT_SCENE3D_SHOWCASE_D3D": "1",
    "SMT_STEREO_API": "Direct3D",
    "SMT_RHI3D_FRAME_JOB": "0",
    "SMT_RHI3D_D3D_DEFERRED": "0"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-china-d3d.bmp",
    "score_id": "legacy_scene3d_china",
    "accept_nonzero_rc_if_bmp": true
  },
  "report_name": "legacy_scene3d_china_d3d_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "not_solid_clear_color",
      "terrain_or_mesh_signal",
      "labels_or_coast_plausible",
      "d3d_present_ok"
    ],
    "expect_notes": "Legacy Direct3D scene3d china; distinct BMP china-d3d.bmp (no GL overwrite); score_id=legacy_scene3d_china"
  }
}
