{
  "id": "legacy.scene3d.cube",
  "kind": "showcase",
  "argv": [
    "--scene3d-showcase",
    "cube"
  ],
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "0",
    "SMT_SCENE3D_SHOWCASE_D3D": "0",
    "SMT_SCENE3D_SHOWCASE_MODE": "cube",
    "SMT_STEREO_API": "OpenGL"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-cube.bmp",
    "score_id": "legacy_scene3d_mesh",
    "accept_nonzero_rc_if_bmp": true
  },
  "report_name": "legacy_scene3d_cube_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "not_solid_clear_color",
      "mesh_silhouette_visible",
      "opengl_present_ok"
    ],
    "expect_notes": "SmtCube at origin; score_id=legacy_scene3d_mesh"
  }
}
