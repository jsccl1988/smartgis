{
  "id": "legacy.browse.2d",
  "kind": "showcase",
  "argv": [],
  "driver": "os",
  "os_inject_default": "sendinput",
  "script": "legacy.browse.2d.il",
  "window_title": "SmartGis",
  "env": {},
  "bmp": {
    "path": "legacy-browse-2d-edit.bmp",
    "score_id": "legacy_map2d_china",
    "accept_nonzero_rc_if_bmp": true,
    "soft": true,
    "min_bytes": 1000
  },
  "zoom_gate": {
    "before": "legacy/_zoom_before.bmp",
    "after": "legacy/_zoom_after.bmp",
    "min_pixel_diff_frac": 0.001,
    "settle_ms": 1200,
    "thresh": 8
  },
  "motion_gate": {
    "min_unique_frac": 0.12,
    "min_unique_frames": 6
  },
  "click_gate": {
    "enabled": true
  },
  "report_name": "legacy_browse_2d_loop_report.json",
  "probes": [
    "bmp",
    "zoom",
    "motion",
    "click"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "map_not_all_black",
      "zoom_before_after_visible_change",
      "no_scramble_after_pan",
      "edit_chrome_visible",
      "click_dblclick_map_client_ok"
    ],
    "expect_notes": "Edit shell + map client; sendinput pan/wheel; zoom_gate + motion_gate + click_gate; soft china score informational"
  }
}
