{
  "id": "legacy.scene3d.china",
  "kind": "showcase",
  "argv": [
    "--scene3d-showcase",
    "china"
  ],
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "0",
    "SMT_SCENE3D_SHOWCASE_D3D": "0",
    "SMT_STEREO_API": "OpenGL"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-china.bmp",
    "score_id": "legacy_scene3d_china",
    "accept_nonzero_rc_if_bmp": true
  },
  "report_name": "legacy_scene3d_china_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGIS-Legacy.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "not_solid_clear_color",
      "terrain_or_mesh_signal",
      "labels_or_coast_plausible",
      "opengl_present_ok"
    ],
    "expect_notes": "Legacy OpenGL scene3d china; score_id=legacy_scene3d_china (rejects navy sparse strip; GL dial pink digits ok <0.02)"
  }
}
