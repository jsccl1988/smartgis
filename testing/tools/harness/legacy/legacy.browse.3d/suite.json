{
  "id": "legacy.browse.3d",
  "kind": "showcase",
  "argv": [
    "--scene3d-showcase",
    "china"
  ],
  "driver": "os",
  "os_inject_default": "postmessage",
  "script": "legacy.browse.3d.il",
  "window_title": "legacy-scene3d-showcase",
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "28000",
    "SMT_HARNESS_OS_WAIT_BMP": "1",
    "SMT_STEREO_API": "OpenGL"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-china.bmp",
    "score_id": "legacy_scene3d_china",
    "accept_nonzero_rc_if_bmp": true
  },
  "report_name": "legacy_browse_3d_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 4,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "not_solid_clear_color",
      "terrain_or_mesh_signal",
      "no_scramble_after_orbit_wheel",
      "labels_or_coast_plausible"
    ],
    "expect_notes": "OpenGL scene3d china linger path; score_id=legacy_scene3d_china"
  }
}
