{
  "id": "legacy.map2d.china",
  "kind": "showcase",
  "argv": [
    "--map2d-showcase",
    "china"
  ],
  "env": {
    "SMT_MAP2D_SHOWCASE_LINGER_MS": "0"
  },
  "bmp": {
    "path": "legacy-map2d-showcase-china.bmp",
    "score_id": "legacy_map2d_china"
  },
  "report_name": "legacy_map2d_china_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 180,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "coastline_plausible",
      "roads_or_vectors_visible",
      "no_y_flip_artifacts",
      "not_all_black"
    ],
    "expect_notes": "Legacy map2d china showcase; score_id=legacy_map2d_china"
  }
}
