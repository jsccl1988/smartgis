{
  "id": "legacy.scene3d.northarray",
  "kind": "showcase",
  "argv": [
    "--scene3d-showcase",
    "northarray"
  ],
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "0",
    "SMT_SCENE3D_SHOWCASE_D3D": "0",
    "SMT_SCENE3D_SHOWCASE_MODE": "northarray",
    "SMT_STEREO_API": "OpenGL"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-northarray.bmp",
    "score_id": "legacy_scene3d_hud",
    "accept_nonzero_rc_if_bmp": true
  },
  "report_name": "legacy_scene3d_northarray_loop_report.json",
  "probes": [
    "bmp"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGIS-Legacy.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "not_solid_clear_color",
      "compass_hud_visible",
      "opengl_present_ok"
    ],
    "expect_notes": "NorthArray HUD only (Setup); score_id=legacy_scene3d_hud (sparse dial ok)"
  }
}
