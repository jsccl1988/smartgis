{
  "id": "input",
  "kind": "showcase",
  "argv": [
    "--input-showcase"
  ],
  "script": "input.il",
  "env": {
    "SMT_SKIP_MAP_CONTEXT_MENU": "1"
  },
  "mark_leaf": "input-self-test-mark.txt",
  "required_marks": [
    "input-point-ok",
    "input-line-ok",
    "input-poly-ok",
    "input-ok"
  ],
  "report_name": "input_loop_report.json",
  "probes": [
    "marks"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 120,
    "build_target": "src/app/views:views",
    "exe": "SmartGisViews.exe"
  }
}
