{
  "id": "browse",
  "kind": "showcase",
  "argv": [
    "--browse-showcase"
  ],
  "script": "browse.il",
  "env": {
    "SMT_SKIP_MAP_CONTEXT_MENU": "1",
    "SMT_HARNESS_RECORD": "1",
    "SMT_HARNESS_RECORD_MODE": "bmp"
  },
  "mark_leaf": "self-test-mark.txt",
  "required_marks": [
    "pan-ok",
    "browse-ok",
    "wheel-cursor-ok",
    "browse-exit"
  ],
  "accept_nonzero_rc_if_marks": true,
  "bmp": {
    "path": "browse-showcase-2d.bmp",
    "score_id": "map2d_china",
    "accept_nonzero_rc_if_bmp": true,
    "soft": true,
    "min_bytes": 10000
  },
  "motion_gate": {
    "min_unique_frac": 0.015,
    "min_unique_frames": 8
  },
  "report_name": "browse_loop_report.json",
  "probes": [
    "marks",
    "bmp",
    "motion"
  ],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "src/app/views:views",
    "exe": "SmartGIS.exe"
  },
  "visual_review": {
    "enabled": true,
    "checklist": [
      "map_not_hollow",
      "layers_labels_readable",
      "pan_browse_wheel_marks",
      "no_tab_clip_layers_sources"
    ],
    "expect_notes": "Views 2D browse stress + map-client HWND record + motion_gate; soft map2d_china"
  }
}
