{
  "id": "map2d.china",
  "kind": "showcase",
  "argv": ["--map2d-showcase", "china"],
  "env": {
    "SMT_MAP2D_SHOWCASE_LINGER_MS": "0"
  },
  "bmp": {
    "path": "map2d-showcase-china.bmp",
    "score_id": "map2d_china",
    "accept_nonzero_rc_if_bmp": true,
    "min_bytes": 10000
  },
  "report_name": "map2d_shot_report.json",
  "probes": ["bmp"],
  "loop": {
    "rounds": 6,
    "timeout_sec": 180,
    "build_target": "src/app/views:views",
    "exe": "SmartGisViews.exe"
  }
}
