{
  "id": "legacy.scene3d.china",
  "kind": "showcase",
  "argv": ["--scene3d-showcase", "china"],
  "env": {
    "SMT_SCENE3D_SHOWCASE_LINGER_MS": "0",
    "SMT_SCENE3D_SHOWCASE_D3D": "0",
    "SMT_STEREO_API": "OpenGL"
  },
  "bmp": {
    "path": "legacy-scene3d-showcase-china.bmp",
    "score_id": "legacy_scene3d_china"
  },
  "report_name": "legacy_scene3d_shot_report.json",
  "probes": ["bmp"],
  "loop": {
    "rounds": 6,
    "timeout_sec": 90,
    "build_target": "SmartGis",
    "exe": "SmartGis.exe"
  }
}
