# Sample packs live under china/ plugin/ fixtures/ rs/ — see README.md.
# GN still flattens product copies to shared out/data/ (sibling of Debug/Release)
# so runtime seed paths (../data/china_city.gpkg) stay stable.
#
# Prefers china_city.gpkg (aligned pack + china_dem.tif); china_plp fallback.
# Rebuild vectors: py -3 testing/data/build_china_city.py
# Hydro/roads: testing/data/china/china_hydro.src.geojson + china_roads.src.geojson
# Rebuild vectors+DEM: py -3 testing/data/build_china_city.py --with-dem
# Rebuild DEM only (AWS Mapzen z7 → 1536×960):
#   py -3 testing/data/build_china_dem.py --jobs 16
# PIN: testing/data/china/china_city.PIN.txt

copy("china_map_samples") {
  sources = [
    "china/china_city.gpkg",
    "china/china_city.geojson",
    "china/china_city.style.json",
    "china/china_city.LICENSE.txt",
    "china/china_dem.tif",
    "china/china_plp.geojson",
    "china/pointcloud_public_sample.txt",
    "fixtures/m3_city_tileset.json",
    "fixtures/views_ogr_sample.geojson",
  ]
  outputs = [ "$root_out_dir/../data/{{source_file_part}}" ]
}

# Plugin product sample+viz fixtures → out/data/plugin/
# These are schematic/tiny smokes, not the china pack (see plugin/README.md).
copy("plugin_product_samples") {
  sources = [
    "plugin/world3d_trimesh_sample.xyz",
    "plugin/world3d_dem_sample.tif",
    "plugin/world3d_pointcloud_sample.las",
    "plugin/orthogrid_sample.gridbnd",
    "plugin/traffic_network_sample.geojson",
    "plugin/flood_basin_sample.tif",
    "plugin/stormsurge_dem_sample.tif",
    "plugin/stormsurge_coast_sample.geojson",
    "plugin/stormsurge_tide_sample.csv",
    "plugin/stormsurge_impact_sample.geojson",
    "plugin/mine_boreholes.csv",
    "plugin/geochem_samples.csv",
    "plugin/README.md",
  ]
  outputs = [ "$root_out_dir/../data/plugin/{{source_file_part}}" ]
}

# Geochem samples keep a subdirectory under out/data/plugin/geochem/.
copy("plugin_geochem_samples") {
  sources = [ "plugin/geochem/geochem_samples.csv" ]
  outputs = [ "$root_out_dir/../data/plugin/geochem/{{source_file_part}}" ]
}

# Leftover model3d AM sample heightmap / TIN under out/data/rs/terrain/
# (exe dir + "..\\data\\rs\\terrain\\...").
copy("am_terrain_samples") {
  sources = [
    "rs/terrain/ground.bmp",
    "rs/terrain/ground.dat",
  ]
  outputs = [ "$root_out_dir/../data/rs/terrain/{{source_file_part}}" ]
}

# Rebuild offline pack (network + pyshp + GDAL):
#   py -3 testing/data/build_china_city.py --with-dem
# Globe splash DEM + terrain albedo (optional; not copied — generated):
#   py -3 testing/data/build_globe_terrain.py
#   py -3 testing/data/build_globe_terrain.py --download-blue-marble
# PIN: testing/data/china/china_city.PIN.txt
group("china_city_data") {
  data_deps = [
    ":china_map_samples",
    ":am_terrain_samples",
    ":plugin_product_samples",
    ":plugin_geochem_samples",
  ]
}
