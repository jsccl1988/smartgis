# Schematic China map samples under shared out/data/ (sibling of Debug/Release).
# Prefers china_city.gpkg (NE 10m four-layer pack + china_dem.tif); china_plp fallback.
# Rebuild: py -3 testing/data/build_china_city.py --with-dem
# PIN: testing/data/china_city.PIN.txt

copy("china_map_samples") {
  sources = [
    "china_city.gpkg",
    "china_city.geojson",
    "china_city.style.json",
    "china_city.LICENSE.txt",
    "china_dem.tif",
    "china_plp.geojson",
    "m3_city_tileset.json",
    "views_ogr_sample.geojson",
  ]
  outputs = [ "$root_out_dir/../data/{{source_file_part}}" ]
}

# Leftover model3d AM sample heightmap / TIN under out/data/rs/terrain/
# (exe dir + "..\\data\\rs\\terrain\\...").
copy("am_terrain_samples") {
  sources = [
    "rs/terrain/ground.bmp",
    "rs/terrain/ground.dat",
  ]
  outputs = [ "$root_out_dir/../data/rs/terrain/{{source_file_part}}" ]
}

# Rebuild offline pack (network + pyshp + GDAL):
#   py -3 testing/data/build_china_city.py --with-dem
# PIN: testing/data/china_city.PIN.txt
group("china_city_data") {
  data_deps = [
    ":china_map_samples",
    ":am_terrain_samples",
  ]
}
