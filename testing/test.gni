#
# test() links //third_party:gtest (gtest + gtest_main). Cases are TEST /
# TEST_F with no handwritten main. Set use_gtest = false only when this
# executable is not a gtest runner.

# Keep default configs (including //build/config:cc_std). Invoker
# `configs =` must append, not replace — otherwise tests compile
# without /std:c++23preview and C++20 concepts fail to parse.
template("test") {
  executable(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "deps",
                             "use_gtest",
                           ])
    testonly = true
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }

    _deps = []
    if (defined(invoker.deps)) {
      _deps += invoker.deps
    }
    _use_gtest = true
    if (defined(invoker.use_gtest)) {
      _use_gtest = invoker.use_gtest
    }
    if (_use_gtest) {
      _deps += [ "//third_party:gtest" ]
    }
    deps = _deps
  }
}
