#
# Slim test() template. gtest is not wired until third_party googletest
# is fetched (see third_party/GITEA_MIRROR.md).

# Keep default configs (including //build/config:cc_std). Invoker
# `configs =` must append, not replace — otherwise tests compile
# without /std:c++23preview and C++20 concepts fail to parse.
template("test") {
  executable(target_name) {
    forward_variables_from(invoker, "*", [ "configs" ])
    testonly = true
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }
}
