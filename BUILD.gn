import("//src/app/cef/cef.gni")
import("//src/app/cs/cs.gni")
import("//src/app/winui/winui.gni")
import("//src/render/skia/skia.gni")

# Root groups match mogu / mgis: all, test_all, all_with_tests, benchmark_all
# plus shorthand aliases m / te / a / b.

group("all") {
  deps = []
  if (!is_build_third_party) {
    deps += [ "//src:src_all" ]
  }
  if (is_build_third_party) {
    deps += [ "//third_party:third_party_all" ]
  }
}

group("all_with_tests") {
  testonly = true
  deps = [
    ":all",
    ":test_all",
  ]
}

# No benchmark targets yet; group exists so `b` / build.bat b stay valid.
group("benchmark_all") {
  testonly = true
  deps = []
}

group("test_all") {
  testonly = true
  deps = [
    "//testing/e2e:exe_smoke",
    "//src/ui/views:views_unittests",
    "//src/ui/views:views_pixel_tests",
    "//src/sdb/datasource/gdal:sde_gdal_test",
    "//src/sdb/tile:tile_test",
    "//src/sdb/style:style_test",
    "//src/algorithm/geo:geo_ogr_test",
    "//src/algorithm/proj:proj_test",
    "//src/algorithm/stat:stat_expr_test",
    "//src/algorithm/tin:tin_delaunay_test",
    "//src/algorithm/tin:tin_xyz_test",
    "//src/sdb/model:model_test",
    "//src/sdb/scene:scene_test",
    "//src/render:rhi_test",
    "//src/render/scene:scene_gpu_test",
    "//src/render/scene:unified_draw_test",
    "//src/gpu:render_backend_test",
    "//src/base/ipc:ipc_test",
    "//src/app/cef:chrome_bridge_test",
    "//src/app/cs:sg_host_test",
  ]
  if (smt_build_app) {
    deps += [ "//src/legacy/app:app" ]
  }
}

# Chrome / GPU exes + exe_smoke. build.bat e2e sets remaining smt_build_* flags.
group("e2e") {
  testonly = true
  deps = [ ":test_all" ]
  if (smt_build_app) {
    deps += [ ":smartgis" ]
  }
  if (smt_build_views) {
    deps += [ ":ui_views" ]
  }
  if (smt_build_winui) {
    deps += [ ":winui" ]
  }
  if (smt_build_cef && smt_has_cef) {
    deps += [ ":cef" ]
  }
  if (smt_build_cs) {
    deps += [ ":cs" ]
  }
  if (smt_build_render) {
    deps += [ ":render" ]
  }
}

group("m") {
  deps = [ ":all" ]
}

group("a") {
  testonly = true
  deps = [ ":all_with_tests" ]
}

group("b") {
  testonly = true
  deps = [ ":benchmark_all" ]
}

group("te") {
  testonly = true
  deps = [ ":test_all" ]
}

# mogu-aligned foundation under //src/base:foundation (source_set; not a DLL).
# Product platform DLL is //src/base:base with dll_stem=platform.
# Compatibility: //:base → foundation (no physical repo-root base/ directory).
group("base") {
  public_deps = [ "//src/base:foundation" ]
}

# Thin aliases under //core → foundation. Prefer //src/base:foundation.
group("core") {
  public_deps = [ "//core:core" ]
}

group("core_all") {
  public_deps = [ "//core:core_all" ]
}

# Leftover MFC SmartGis.exe — opt-in only (build.bat legacy_app / smartgis).
# Daily product entry is //:views (build.bat app|views). Not in group("all").
group("smartgis") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/app:legacy_app_all" ]
  }
}

group("legacy_app_all") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/app:legacy_app_all" ]
  }
}

# Product chrome alias → Views (not MFC).
group("app") {
  deps = [ ":views" ]
}

# MFC UI DLL (dll_stem = ui_legacy). Explicit ninja target; NOT in src_all.
# Opt-in: build.bat ui_legacy or legacy_app (sets smt_build_app).
group("ui_legacy") {
  deps = [ "//src/ui:ui_legacy" ]
}

# Views toolkit + Skia canvas. Not a dep of group("all") / src_all.
# The chrome exe is loaded only when smt_build_views=true (build.bat views).
group("ui_views") {
  deps = [
    "//src/render/skia:skia",
    "//src/ui/views:views",
  ]
  if (smt_build_views) {
    deps += [ "//src/app/views:views" ]
  }
}

group("views") {
  deps = [ ":ui_views" ]
}

# Scheme 2 WinUI chrome. Loaded only when smt_build_winui=true.
group("winui") {
  deps = []
  if (smt_build_winui) {
    deps += [ "//src/app/winui:app_winui" ]
  }
}

# CEF chrome (scheme 1 partitioned HWND). Opt-in; not in group("all").
group("cef") {
  deps = []
  if (smt_build_cef && smt_has_cef) {
    deps += [ "//src/app/cef:cef" ]
  }
}

# C# WinUI host (external embedder + SmartGisCs.exe). Opt-in; not in all.
group("cs") {
  deps = [ "//src/app/cs:cs" ]
}

# GPU process. Only loaded when smt_build_render=true (build.bat render).
group("render") {
  deps = []
  if (smt_build_render) {
    deps += [ "//src/gpu:gpu" ]
  }
}

# Leftover SmtGroupToolCore (needs MFC gui). Not in src_all / ninja all.
group("tool_group") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/tool/group:tool_group" ]
  }
}
