import("//src/ui/gfx/skia.gni")

# Root groups match mogu / mgis: all, test_all, all_with_tests, benchmark_all
# plus shorthand aliases m / te / a / b.

group("all") {
  deps = []
  if (!is_build_third_party) {
    deps += [ "//src:src_all" ]
  }
  if (is_build_third_party) {
    deps += [ "//third_party:third_party_all" ]
  }
}

# `ninja -C out/Debug` with no args would otherwise build every ninja output
# (scenic copy + tests). Default is the product library graph only.
group("default") {
  deps = [ ":all" ]
}

group("all_with_tests") {
  testonly = true
  deps = [
    ":all",
    ":test_all",
  ]
}

# Console / GIS / RHI google/benchmark targets (build.bat b / build.bat debug b).
group("benchmark_all") {
  testonly = true
  deps = [
    "//src/content:content_console_bench",
    "//src/ui/views:views_bench",
    "//src/gis:gis_benchmark_all",
    "//src/render/testing:render_benchmark_all",
  ]
}

# SP5: endgame / shell tests only â€?no leftover paint / scene3d / MFC exe.
group("test_shell") {
  testonly = true
  deps = [
    "//testing/e2e:exe_smoke",
    "//src/ui/views:views_unittests",
    "//src/ui/views:views_interactive_tests",
    "//src/ui/views:markup_unittests",
    "//src/app/ui_designer:ui_designer",
    "//src/ui/views:views_pixel_tests",
    "//src/content:content_view_host_test",
    "//src/content:debug_agent_test",
    "//src/content:content_console_coverage_test",
    "//src/content:content_feature_attrs_test",
    "//src/content:content_catalog_layers_test",
    "//src/content:map_scene_test",
    "//src/content:scene3d_presenter_test",
    "//src/app/views:view_commands_test",
    "//src/content:view_navigation_test",
    "//src/gis:gis_test_all",
    "//src/vista:vista_test_all",
    "//src/tool:camera_nav_test",
    "//src/tool:tool_dispatch_test",
    "//src/tool:draft_test",
    "//src/render:rhi_test",
    "//src/render/testing:rhi_suite_test",
    "//src/gpu:render_backend_test",
    "//src/base/ipc:ipc_test",
    "//src/base/trace:trace_test",
    # Plugin pathway (Registry / PluginHost / processing ops / M4 embed sample).
    "//src/plugin:plugin_host_test",
    "//src/plugin/runtime/processing:processing_ops_test",
    "//src/content:content_embed_sample_test",
    # world3d orthogrid / hexgrid: 4-edge gridbnd Laplace + 3D hex Laplace.
    "//src/plugin/product/world3d:orthogrid_laplace_test",
    "//src/plugin/product/world3d:orthogrid3d_laplace_test",
  ]
}

# Full test graph: shell only. Dual-run leftover paint / MFC exe deleted.
group("test_all") {
  testonly = true
  deps = [ ":test_shell" ]
}

# Chrome / GPU exes + exe_smoke. build.bat e2e sets remaining build_* flags.
group("e2e") {
  testonly = true
  deps = [ ":test_all" ]
  if (build_views) {
    deps += [ ":ui_views" ]
  }
  if (build_render) {
    deps += [ ":render" ]
  }
}

group("m") {
  deps = [ ":all" ]
}

group("a") {
  testonly = true
  deps = [ ":all_with_tests" ]
}

group("b") {
  testonly = true
  deps = [ ":benchmark_all" ]
}

group("te") {
  testonly = true
  deps = [ ":test_all" ]
}

# mogu-aligned foundation under //src/base:foundation (source_set; not a DLL).
# Product platform DLL is //src/base:base with dll_stem=base.
# Compatibility: //:base â†?foundation (no physical repo-root base/ directory).
group("base") {
  public_deps = [ "//src/base:foundation" ]
}

# Historic //core:core. Same target as //:base. Prefer //src/base:foundation.
group("core") {
  public_deps = [ "//src/base:foundation" ]
}

# Historic //core:core_all. Whole product tree. Prefer //src:src_all.
group("core_all") {
  public_deps = [ "//src:src_all" ]
}

# Product chrome alias â†?Views.
group("app") {
  deps = [ ":views" ]
}

# Views toolkit + Skia canvas. Not a dep of group("all") / src_all.
# The chrome exe is loaded only when build_views=true (build.bat views|app).
group("ui_views") {
  deps = [
    "//src/ui/gfx:gfx",
    "//src/ui/gis:gis",
    "//src/ui/views:views",
  ]
  if (build_views) {
    deps += [ "//src/app/views:views" ]
  }
}

group("views") {
  deps = [ ":ui_views" ]
}

# Declarative UI designer / editor (always available; no map).
group("UiDesigner") {
  deps = [ "//src/app/ui_designer:ui_designer" ]
}

# GPU process. Only loaded when build_render=true (build.bat render).
group("render") {
  deps = []
  if (build_render) {
    deps += [ "//src/gpu:gpu" ]
  }
}
