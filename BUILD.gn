import("//src/ui/gfx/skia.gni")

# Root groups match mogu / mgis: all, test_all, all_with_tests, benchmark_all
# plus shorthand aliases m / te / a / b.

group("all") {
  deps = []
  if (!is_build_third_party) {
    deps += [ "//src:src_all" ]
  }
  if (is_build_third_party) {
    deps += [ "//third_party:third_party_all" ]
  }
}

group("all_with_tests") {
  testonly = true
  deps = [
    ":all",
    ":test_all",
  ]
}

# No benchmark targets yet; group exists so `b` / build.bat b stay valid.
group("benchmark_all") {
  testonly = true
  deps = []
}

# SP5: endgame / shell tests only — no leftover paint / scene3d / MFC exe.
# Verifies the default product graph without compiling legacy_*_all.
group("test_shell") {
  testonly = true
  deps = [
    "//testing/e2e:exe_smoke",
    "//src/ui/views:views_unittests",
    "//src/ui/views:views_pixel_tests",
    "//src/content:content_view_host_test",
    "//src/content:content_feature_attrs_test",
    "//src/content:content_catalog_layers_test",
    "//src/app/views:map_scene_test",
    "//src/app/views:scene3d_presenter_test",
    "//src/app/views:view_commands_test",
    "//src/app/views:view_navigation_test",
    "//src/gis/vista/world:dem_raster_test",
    "//src/gis/datasource/ogr:ogr_text_encoding_test",
    "//src/gis/datasource/sdbd:sdbd_client_test",
    "//src/gis/datasource/sdbd:sdbd_live_test",
    "//src/gis/vista/world:land_mask_test",
    "//src/gis/vista/domain/atmosphere:field_store_test",
    "//src/gis/vista/domain/atmosphere:procedural_test",
    "//src/gis/vista/domain/atmosphere:field_ingest_test",
    "//src/tool:camera_nav_test",
    "//src/tool:tool_dispatch_test",
    "//src/tool:draft_test",
    "//src/gis/datasource/gdal:sde_gdal_test",
    "//src/gis/model/map:select_query_test",
    "//src/gis/present/tile:tile_test",
    "//src/gis/present/style:style_test",
    "//src/gis/vista/frame:frame_test",
    "//src/effect/map:map_effect_test",
    "//src/gis/kernel/geo:geo_ogr_test",
    "//src/gis/kernel/proj:proj_test",
    "//src/gis/kernel/stat:stat_expr_test",
    "//src/gis/kernel/tin:tin_delaunay_test",
    "//src/gis/kernel/tin:tin_xyz_test",
    "//src/gis/vista/assets:model_test",
    "//src/gis/vista/world:world_test",
    "//src/gis/vista/world:tessellate_style_test",
    "//src/render:rhi_test",
    "//src/effect/scene:scene_gpu_test",
    "//src/effect/scene:unified_draw_test",
    "//src/gpu:render_backend_test",
    "//src/base/core:menu_test",
    "//src/base/ipc:ipc_test",
    # Plugin pathway (Registry / PluginHost / processing ops / M4 embed sample).
    "//src/plugin:plugin_host_test",
    "//src/plugin/runtime/processing:processing_ops_test",
    "//src/content:content_embed_sample_test",
  ]
}

# Full test graph: shell + optional leftover paint / MFC (still opt-in for app).
group("test_all") {
  testonly = true
  deps = [
    ":test_shell",
    "//src/legacy/render/rhi2d/impl/gdi:gdi_map_paint_test",
    "//src/legacy/render/rhi2d/impl/gdi:map_carto2d_test",
    "//src/legacy/render/rhi3d/impl/gl:gl_map_paint_test",
  ]
  if (smt_build_app) {
    deps += [ "//src/legacy/app:app" ]
  }
}

# Chrome / GPU exes + exe_smoke. build.bat e2e sets remaining smt_build_* flags.
group("e2e") {
  testonly = true
  deps = [ ":test_all" ]
  if (smt_build_app) {
    deps += [ ":smartgis" ]
  }
  if (smt_build_views) {
    deps += [ ":ui_views" ]
  }
  if (smt_build_render) {
    deps += [ ":render" ]
  }
}

group("m") {
  deps = [ ":all" ]
}

group("a") {
  testonly = true
  deps = [ ":all_with_tests" ]
}

group("b") {
  testonly = true
  deps = [ ":benchmark_all" ]
}

group("te") {
  testonly = true
  deps = [ ":test_all" ]
}

# mogu-aligned foundation under //src/base:foundation (source_set; not a DLL).
# Product platform DLL is //src/base:base with dll_stem=base.
# Compatibility: //:base → foundation (no physical repo-root base/ directory).
group("base") {
  public_deps = [ "//src/base:foundation" ]
}

# Historic //core:core. Same target as //:base. Prefer //src/base:foundation.
group("core") {
  public_deps = [ "//src/base:foundation" ]
}

# Historic //core:core_all. Whole product tree. Prefer //src:src_all.
group("core_all") {
  public_deps = [ "//src:src_all" ]
}

# Leftover MFC SmartGis.exe — opt-in only (build.bat legacy_app / smartgis).
# Daily product entry is //:views (build.bat app|views). Not in group("all").
group("smartgis") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/app:legacy_app_all" ]
  }
}

group("legacy_app_all") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/app:legacy_app_all" ]
  }
}

# SP5 opt-in aggregator for leftover engines + MFC chrome.
# Not a dep of //:all / //src:src_all / //:views. See docs/build/src-layout.md.
group("legacy_all") {
  deps = [
    "//src/legacy/render:legacy_render_all",
    "//src/legacy/tool:legacy_tool_all",
    ":ui_legacy",
  ]
  if (smt_build_app) {
    deps += [ "//src/legacy/app:legacy_app_all" ]
  }
}

# Product chrome alias → Views (not MFC).
group("app") {
  deps = [ ":views" ]
}

# MFC UI DLL (dll_stem = ui_legacy). Explicit ninja target; NOT in src_all.
# Opt-in: build.bat ui_legacy or legacy_app (sets smt_build_app).
group("ui_legacy") {
  deps = [ "//src/ui:ui_legacy" ]
}

# Views toolkit + Skia canvas. Not a dep of group("all") / src_all.
# The chrome exe is loaded only when smt_build_views=true (build.bat views|app).
# SP5: must not pull legacy_*_all / ui_legacy (see //src/app/views:views assert_no_deps).
group("ui_views") {
  deps = [
    "//src/ui/gfx:gfx",
    "//src/ui/views:views",
  ]
  if (smt_build_views) {
    deps += [ "//src/app/views:views" ]
  }
}

group("views") {
  deps = [ ":ui_views" ]
}

# GPU process. Only loaded when smt_build_render=true (build.bat render).
group("render") {
  deps = []
  if (smt_build_render) {
    deps += [ "//src/gpu:gpu" ]
  }
}

# Leftover SmtGroupToolCore (needs MFC gui). Not in src_all / ninja all.
group("tool_group") {
  deps = []
  if (smt_build_app) {
    deps += [ "//src/legacy/tool/group:tool_group" ]
  }
}
