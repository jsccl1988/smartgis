# Thin repo-root aliases. Product sources stay under //src; mogu-aligned
# foundation lives at //src/base:foundation (not the product DLL //src/base:base).
# No physical repo-root base/ directory — //:base is in //BUILD.gn.

# Forward historic //core:core → foundation under src/base.
group("core") {
  public_deps = [ "//src/base:foundation" ]
}

# Whole product tree (not mogu; kept for docs/build/src-layout.md).
group("core_all") {
  public_deps = [ "//src:src_all" ]
}
